<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_note.CustomLineInfoPopup">
        <Dialog title="props.title" size="'md'">
            <div class="custom-line-info-popup p-3">
                <div class="mb-3">
                    <label for="customName" class="form-label fw-bold">
                        Nombre para esta línea <span class="text-danger">*</span>
                    </label>
                    <input
                        t-ref="nameInput"
                        type="text"
                        class="form-control form-control-lg"
                        t-att-class="{ 'is-invalid': state.nameError }"
                        id="customName"
                        t-att-value="state.customName"
                        t-on-input="onNameChange"
                        t-on-keydown="onKeydown"
                        placeholder="Ej: Servicio especial, Corte personalizado..."
                    />
                    <div t-if="state.nameError" class="invalid-feedback d-block">
                        El nombre es obligatorio
                    </div>
                </div>

                <div class="mb-3">
                    <label for="customPrice" class="form-label fw-bold">
                        Precio para esta línea <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <input
                            type="text"
                            class="form-control form-control-lg"
                            t-att-class="{ 'is-invalid': state.priceError }"
                            id="customPrice"
                            t-att-value="state.customPriceDisplay"
                            t-on-input="onPriceChange"
                            t-on-keydown="onKeydown"
                            inputmode="decimal"
                            placeholder="0,00"
                        />
                        <span class="input-group-text">€</span>
                    </div>
                    <div t-if="state.priceError" class="invalid-feedback d-block">
                        El precio debe ser mayor que 0
                    </div>
                </div>

                <div class="text-muted small mb-3">
                    <i class="fa fa-info-circle me-1"></i>
                    El nombre y precio solo afectarán a esta línea del pedido.
                </div>
            </div>

            <t t-set-slot="footer">
                <div class="d-flex justify-content-end gap-2 w-100">
                    <button class="btn btn-secondary btn-lg" t-on-click="cancel">
                        <i class="fa fa-times me-1"></i> Cancelar
                    </button>
                    <button class="btn btn-primary btn-lg" t-on-click="confirm">
                        <i class="fa fa-check me-1"></i> Confirmar
                    </button>
                </div>
            </t>
        </Dialog>
    </t>

</templates>
