<?xml version="1.0" ?>
<odoo>
    <record id="aicia_importer_wizard_view" model="ir.ui.view">
        <field name="name">AICIA - Importador de Proveedores, Clientes y Personal</field>
        <field name="model">aicia.importer.wizard</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <form string="Importador de Proveedores, Clientes y Personal AICIA">
                <group>
                    <group>
                        <field name="data_file_suppliers" filename="filename_suppliers" widget="binary"/>
                        <field name="filename_suppliers" invisible="1"/>
                    </group>
                    <group>
                        <field name="data_file_customers" filename="filename_customers" widget="binary"/>
                        <field name="filename_customers" invisible="1"/>
                    </group>
                    <group>
                        <field name="data_file_employees" filename="filename_employees" widget="binary"/>
                        <field name="filename_employees" invisible="1"/>
                    </group>
                </group>
                <group>
                    <field name="update_existing"/>
                </group>
                <notebook>
                    <page string="Información">
                        <group>
                            <group>
                                <p>
                                    Este asistente permite importar proveedores, clientes y/o personal desde archivos Excel (.xlsx).
                                </p>
                                <p>
                                    <b>Formato esperado:</b>
                                    <ul>
                                        <li>Primera fila: encabezados de columnas</li>
                                        <li><b>Proveedores:</b> ID_Proveedor, Nombre, Nombre2, CIF, Telefono,
                                            TelefonoMovil, Direccion, Direccion2, Localidad, Cod_Postal, Provincia,
                                            Correo_Electronico, Persona_Contacto, Observaciones, etc.</li>
                                        <li><b>Clientes:</b> ID_Cliente, Nombre, Nombre2, CIF, Telefono,
                                            TelefonoMovil, Direccion, Direccion2, Localidad, Cod_Postal, Provincia,
                                            Correo_Electronico, Persona_Contacto, Observaciones, etc.</li>
                                        <li><b>Personal:</b> Código Personal, Nombre, Apellido1, Apellido2, NIF,
                                            Direccion, Cod_Postal, Población, Teléfono, Movil, Email, NSS,
                                            Fecha Antiguedad, Cuenta Bancaria, Tipo de contrato, etc.</li>
                                        <li><b>Provincias:</b> Se usa un mapeo interno de códigos (1-52) a nombres de provincias españolas.</li>
                                    </ul>
                                </p>
                            </group>
                            <group>
                                <p>
                                    <b>Opciones:</b>
                                    <ul>
                                        <li><b>Actualizar existentes:</b> Si está marcado, actualiza los contactos
                                            existentes (busca por referencia interna o CIF). Si no está marcado,
                                            solo crea contactos nuevos.</li>
                                    </ul>
                                </p>
                                <p>
                                    <b>Nota:</b> Puede importar solo proveedores, solo clientes, solo personal, o cualquier combinación en la misma operación.
                                    Las provincias se mapean automáticamente usando códigos del 1 al 52.
                                </p>
                            </group>
                        </group>
                    </page>
                </notebook>
                <footer>
                    <button
                        name="import_suppliers"
                        string="Importar"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="aicia_importer_wizard_action" model="ir.actions.act_window">
        <field name="name">Importar Proveedores, Clientes y Personal</field>
        <field name="res_model">aicia.importer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

