<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="xtendoo_xtd_theme.XtdDashboard">
        <div class="o_xtd_dashboard d-flex h-100 overflow-hidden" t-att-class="{'xtd-dashboard-intro': this.state.intro}">
            <!-- Eliminado el Sidebar interno cableado -->

            <!-- Main Content Area -->
            <div class="flex-grow-1 overflow-auto bg-light position-relative">
                <div class="xtd-dashboard-bg"/>
                <div class="container-fluid p-4 p-xl-5 pt-4 position-relative z-index-1">
                    <!-- ...existing code... -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold mb-1">Hola, <t t-out="this.userFirstName"/></h2>
                            <p class="text-muted opacity-75">Aquí tienes un resumen de la actividad de tu empresa.</p>
                        </div>
                        <div t-if="this.canEditLayout" class="d-none d-md-flex align-items-center gap-2">
                            <t t-if="this.editingLayout">
                                <span t-if="this.isLayoutDirty" class="badge rounded-pill text-bg-warning">Cambios sin guardar</span>
                                <button class="btn btn-light rounded-pill px-4 py-2" t-on-click="this.cancelLayoutEdition">
                                    Cancelar
                                </button>
                                <button class="btn btn-primary rounded-pill px-4 py-2 shadow-sm" t-on-click="this.saveLayoutEdition">
                                    Guardar dashboard
                                </button>
                            </t>
                            <t t-else="">
                                <button class="btn btn-primary rounded-pill px-4 py-2 shadow-sm" t-on-click="this.startLayoutEdition">
                                    Editar dashboard
                                </button>
                            </t>
                        </div>
                        <div t-else="" class="dropdown">
                            <button class="btn btn-primary dropdown-toggle rounded-pill px-4 py-2 shadow-sm" type="button" data-bs-toggle="dropdown">
                                Acciones rápidas
                            </button>
                            <ul class="dropdown-menu border-0 shadow-lg mt-2">
                                <li><a class="dropdown-item" href="#" t-on-click="() =&gt; this.openAction('sale.action_orders')">Nuevo Pedido</a></li>
                                <li><a class="dropdown-item" href="#" t-on-click="() =&gt; this.openAction('account.action_move_out_invoice_type')">Nueva Factura</a></li>
                            </ul>
                        </div>
                    </div>
                    <div t-if="this.state.loading" class="row g-4 mb-5">
                        <div class="col-12">
                            <div class="row g-4">
                                <div class="col-12 col-md-6 col-xl-3" t-foreach="4" t-as="i" t-key="i">
                                    <div class="card border-0 shadow-sm rounded-dashboard p-4">
                                        <div class="xtd-skeleton xtd-skeleton--icon mb-4"/>
                                        <div class="xtd-skeleton xtd-skeleton--text w-50 mb-2"/>
                                        <div class="xtd-skeleton xtd-skeleton--text w-75"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="card border-0 shadow-sm rounded-dashboard p-4">
                                <div class="xtd-skeleton xtd-skeleton--text w-25 mb-4"/>
                                <div class="xtd-skeleton xtd-skeleton--chart mb-4"/>
                                <div class="d-flex gap-4">
                                    <div t-foreach="3" t-as="j" t-key="j" class="flex-fill">
                                        <div class="xtd-skeleton xtd-skeleton--text w-50 mb-1"/>
                                        <div class="xtd-skeleton xtd-skeleton--text w-75"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div t-else="" class="row g-4 mb-5"
                         t-on-dragover="this.onBlocksDragOver"
                         t-on-drop="this.onBlocksDrop"
                         t-on-dragend="this.onBlockDragEnd">
                        <t t-foreach="this.dashboardBlocks" t-as="block" t-key="block.key">
                            <t t-if="block.component === 'single_kpi'">
                                <t t-set="kpiKey" t-value="block.config &amp;&amp; block.config.kpi_key"/>
                                <div t-if="this.statistics[kpiKey]" t-att-class="this.getBlockClass(block) + (this.editingLayout ? ' xtd-dashboard-editable-block' : '')" t-att-data-block-key="block.key">
                                    <t t-call="xtendoo_xtd_theme.XtdDashboardBlockEditorControls"/>
                                    <div class="card border-0 shadow-sm rounded-dashboard h-100 kpi-card kpi-card--compact cursor-pointer" t-on-click="() =&gt; this.onKpiClick(kpiKey)">
                                        <div class="kpi-card__summary">
                                            <div class="d-flex align-items-start justify-content-between gap-2">
                                                <div class="d-flex align-items-center min-w-0">
                                                    <span t-attf-class="kpi-card__icon bg-#{kpiKey}-light text-#{kpiKey}">
                                                        <i class="oi" t-att-data-icon="this.statistics[kpiKey].icon"/>
                                                    </span>
                                                    <span class="kpi-card__title text-truncate">
                                                        <t t-out="this.statistics[kpiKey].label"/>
                                                        <span class="kpi-card__value">(<t t-out="this.statistics[kpiKey].value"/>)</span>
                                                    </span>
                                                </div>
                                                <button type="button"
                                                        class="kpi-card__create"
                                                        t-att-title="this.getKpiCreateTitle(kpiKey)"
                                                        t-on-click.stop="() =&gt; this.createKpiRecord(kpiKey)">
                                                    <span aria-hidden="true">+</span>
                                                </button>
                                            </div>
                                            <div class="kpi-card__meta">
                                                <t t-if="this.statistics[kpiKey].total">
                                                    <span class="kpi-card__total" t-out="this.statistics[kpiKey].total"/>
                                                </t>
                                                <span t-if="this.statistics[kpiKey].hasTrend" t-attf-class="kpi-card__trend text-#{this.statistics[kpiKey].trend &gt;= 0 ? 'success' : 'danger'}">
                                                    <i class="oi" t-att-data-icon="this.statistics[kpiKey].trend &gt;= 0 ? 'arrow_upward' : 'arrow_downward'"/>
                                                    <span class="fw-bold" t-out="this.statistics[kpiKey].trend_str"/>
                                                    <span class="text-muted fw-normal" t-out="this.kpiPeriodLabel"/>
                                                </span>
                                                <span t-else="" class="kpi-card__trend text-muted" title="Sin datos en este periodo">Sin datos</span>
                                            </div>
                                            <t t-if="this.state.recentItems[kpiKey] &amp;&amp; this.state.recentItems[kpiKey].length">
                                                <div class="kpi-card__list xtd-recent-list">
                                                    <t t-foreach="this.state.recentItems[kpiKey]" t-as="item" t-key="item.id">
                                                        <div class="d-flex justify-content-between align-items-center xtd-recent-row kpi-card__row">
                                                            <div class="text-truncate me-2">
                                                                <span class="small fw-medium d-block text-truncate" t-out="item.name"/>
                                                                <span class="x-small text-muted" t-out="Array.isArray(item.partner_id) ? item.partner_id[1] : ''"/>
                                                            </div>
                                                            <div class="text-end flex-shrink-0">
                                                                <span class="small fw-bold d-block" t-out="this._formatCurrency(item.amount_total)"/>
                                                                <span class="x-small text-muted" t-out="item.date"/>
                                                            </div>
                                                        </div>
                                                    </t>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            <t t-if="block.component === 'main_kpis'">
                                <div t-att-class="this.getBlockClass(block) + (this.editingLayout ? ' xtd-dashboard-editable-block' : '')" t-att-data-block-key="block.key">
                                    <t t-call="xtendoo_xtd_theme.XtdDashboardBlockEditorControls"/>
                                    <div class="d-flex justify-content-between align-items-center mb-4">
                                        <h4 class="fw-bold mb-0">Resumen</h4>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button type="button"
                                                    class="btn rounded-pill px-3"
                                                    t-att-class="this.state.kpiPeriod === 'week' ? 'btn-primary' : 'btn-light'"
                                                    t-on-click="() =&gt; this.onChangeKpiPeriod('week')">Semana</button>
                                            <button type="button"
                                                    class="btn rounded-pill px-3"
                                                    t-att-class="this.state.kpiPeriod === 'month' ? 'btn-primary' : 'btn-light'"
                                                    t-on-click="() =&gt; this.onChangeKpiPeriod('month')">Mes</button>
                                            <button type="button"
                                                    class="btn rounded-pill px-3"
                                                    t-att-class="this.state.kpiPeriod === 'year' ? 'btn-primary' : 'btn-light'"
                                                    t-on-click="() =&gt; this.onChangeKpiPeriod('year')">Año</button>
                                        </div>
                                    </div>
                                    <div class="row g-4">
                                        <t t-foreach="Object.keys(this.statistics)" t-as="key" t-key="key">
                                            <div class="col-12 col-md-6 col-xl-3">
                                                <div class="card border-0 shadow-sm rounded-dashboard p-4 h-100 kpi-card cursor-pointer" t-on-click="() =&gt; this.onKpiClick(key)">
                                                    <div class="d-flex align-items-center mb-4">
                                                        <div t-attf-class="rounded-dashboard icon-box p-3 me-3 bg-#{key}-light text-#{key}">
                                                            <i class="oi fs-4" t-att-data-icon="this.statistics[key].icon"/>
                                                        </div>
                                                        <span class="text-muted fw-bold small text-uppercase letter-spacing-1" t-out="this.statistics[key].label"/>
                                                        <t t-if="this.statistics[key].total">
                                                            <span class="ms-auto fw-bold h5 mb-0 text-dark" t-out="this.statistics[key].total"/>
                                                        </t>
                                                    </div>
                                                    <div class="mt-auto">
                                                        <h2 class="fw-black mb-1 kpi-value" t-out="this.statistics[key].value"/>
<div t-attf-class="trend-badge d-inline-flex align-items-center px-2 py-1 rounded-pill text-#{this.statistics[key].trend &gt;= 0 ? 'success' : 'danger'}">
    <i class="oi me-1 x-small" t-att-data-icon="this.statistics[key].trend &gt;= 0 ? 'arrow_upward' : 'arrow_downward'"/>
    <span class="fw-bold x-small" t-out="this.statistics[key].trend_str"/>
    <span class="text-muted fw-normal ms-2 x-small" t-out="this.kpiPeriodLabel"/>
</div>
                                                        <t t-if="this.state.recentItems[key] &amp;&amp; this.state.recentItems[key].length">
                                                            <div class="mt-3 pt-3 border-top xtd-recent-list">
                                                                <t t-foreach="this.state.recentItems[key]" t-as="item" t-key="item.id">
                                                                    <div class="d-flex justify-content-between align-items-center py-1 xtd-recent-row">
                                                                        <div class="text-truncate me-2">
                                                                            <span class="small fw-medium d-block text-truncate" t-out="item.name"/>
                                                                            <span class="x-small text-muted" t-out="Array.isArray(item.partner_id) ? item.partner_id[1] : ''"/>
                                                                        </div>
                                                                        <div class="text-end flex-shrink-0">
                                                                            <span class="small fw-bold d-block" t-out="this._formatCurrency(item.amount_total)"/>
                                                                            <span class="x-small text-muted" t-out="item.date"/>
                                                                        </div>
                                                                    </div>
                                                                </t>
                                                            </div>
                                                        </t>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                            <div t-if="block.component === 'sales_chart'" t-att-class="this.getBlockClass(block) + (this.editingLayout ? ' xtd-dashboard-editable-block' : '')" t-att-data-block-key="block.key">
                            <t t-call="xtendoo_xtd_theme.XtdDashboardBlockEditorControls"/>
                            <div class="card border-0 shadow-sm rounded-dashboard p-4 h-100 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h4 class="fw-bold mb-0">Presupuestos vs Pedidos</h4>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button"
                                                class="btn rounded-pill px-3"
                                                t-att-class="this.state.chartPeriod === 'week' ? 'btn-primary' : 'btn-light'"
                                                t-on-click="() =&gt; this.onChangeChartPeriod('week')">Semana</button>
                                        <button type="button"
                                                class="btn rounded-pill px-3"
                                                t-att-class="this.state.chartPeriod === 'month' ? 'btn-primary' : 'btn-light'"
                                                t-on-click="() =&gt; this.onChangeChartPeriod('month')">Mes</button>
                                        <button type="button"
                                                class="btn rounded-pill px-3"
                                                t-att-class="this.state.chartPeriod === 'year' ? 'btn-primary' : 'btn-light'"
                                                t-on-click="() =&gt; this.onChangeChartPeriod('year')">Año</button>
                                    </div>
                                </div>
                                <div class="chart-container flex-grow-1 position-relative">
                                    <canvas t-ref="this.salesChartRef" class="xtd-chart-canvas"></canvas>
                                </div>
                                <div class="row g-0 mt-auto pt-4 border-top">
                                    <div class="col text-center">
                                        <span class="text-muted x-small d-block mb-1">Presupuestos</span>
                                        <span class="fw-bold h5 mb-0" t-out="this.chartSummary.quotations"/>
                                    </div>
                                    <div class="col text-center border-start border-light">
                                        <span class="text-muted x-small d-block mb-1">Pedidos</span>
                                        <span class="fw-bold h5 mb-0" t-out="this.chartSummary.orders"/>
                                    </div>
                                    <div class="col text-center border-start border-light">
                                        <span class="text-muted x-small d-block mb-1">Conversión</span>
                                        <span class="fw-bold h5 mb-0" t-out="this.chartSummary.conversion"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                            <div t-if="block.component === 'pending_activities'" t-att-class="this.getBlockClass(block) + (this.editingLayout ? ' xtd-dashboard-editable-block' : '')" t-att-data-block-key="block.key">
                            <t t-call="xtendoo_xtd_theme.XtdDashboardBlockEditorControls"/>
                            <div class="card border-0 shadow-sm rounded-dashboard p-4 h-100">
                                <h4 class="fw-bold mb-4">Actividades pendientes</h4>
                                <div class="vstack gap-4">
                                    <t t-if="this.activities and this.activities.length">
                                        <t t-foreach="this.activities" t-as="activity" t-key="activity.id">
                                            <div class="d-flex align-items-center gap-3 activity-item p-2 rounded-dashboard">
                                                <div class="bg-primary-soft text-primary p-3 rounded-dashboard">
                                                    <i class="oi fs-5" data-icon="event_available"/>
                                                </div>
                                                <div class="flex-grow-1 overflow-hidden">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <span class="fw-bold small text-truncate" t-out="activity.res_name"/>
                                                        <span class="text-danger x-small fw-black" t-out="activity.date_deadline"/>
                                                    </div>
                                                    <div class="text-muted x-small text-truncate">
                                                        <t t-if="activity.summary" t-out="activity.summary"/>
                                                        <t t-else="">Sin descripción</t>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <div class="text-center py-4 my-auto">
                                            <i class="oi fs-1 text-success mb-2 opacity-50" data-icon="check_circle"/>
                                            <p class="text-muted small mb-0">¡Todo al día!</p>
                                        </div>
                                    </t>
                                </div>
                                <button class="btn btn-link text-primary fw-bold text-decoration-none mt-auto pt-4 shadow-none btn-hover-arrow" t-on-click="() =&gt; this.openAction('mail.mail_activity_action')">
                                    Ver todas las actividades <i class="oi ms-2 transition-300" data-icon="arrow_forward"/>
                                </button>
                            </div>
                        </div>
                            <div t-if="block.component === 'top_products'" t-att-class="this.getBlockClass(block) + (this.editingLayout ? ' xtd-dashboard-editable-block' : '')" t-att-data-block-key="block.key">
                            <t t-call="xtendoo_xtd_theme.XtdDashboardBlockEditorControls"/>
                            <div class="card border-0 shadow-sm rounded-dashboard p-4 h-100">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h5 class="fw-bold mb-0">Top productos</h5>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button"
                                                class="btn rounded-pill px-3"
                                                t-att-class="this.state.topPeriod === 'week' ? 'btn-primary' : 'btn-light'"
                                                t-on-click="() =&gt; this.onChangeTopPeriod('week')">Semana</button>
                                        <button type="button"
                                                class="btn rounded-pill px-3"
                                                t-att-class="this.state.topPeriod === 'month' ? 'btn-primary' : 'btn-light'"
                                                t-on-click="() =&gt; this.onChangeTopPeriod('month')">Mes</button>
                                        <button type="button"
                                                class="btn rounded-pill px-3"
                                                t-att-class="this.state.topPeriod === 'year' ? 'btn-primary' : 'btn-light'"
                                                t-on-click="() =&gt; this.onChangeTopPeriod('year')">Año</button>
                                    </div>
                                </div>
                                <div class="vstack gap-4 flex-grow-1 justify-content-center">
                                    <t t-if="this.topProducts and this.topProducts.length">
                                        <t t-foreach="this.topProducts" t-as="product" t-key="product.id">
                                            <div class="xtd-top-product-row">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <div class="d-flex align-items-center gap-2 min-w-0">
                                                        <span class="xtd-rank-badge" t-out="product_index + 1"/>
                                                        <span class="fw-semibold small text-truncate" t-out="product.name"/>
                                                    </div>
                                                    <div class="text-end flex-shrink-0 ms-2">
                                                        <span class="fw-bold small" t-out="product.amountFmt"/>
                                                        <span class="text-muted x-small ms-1"><t t-out="product.qty"/> uds</span>
                                                    </div>
                                                </div>
                                                <div class="xtd-bar-track">
                                                    <div class="xtd-bar-fill" t-att-style="'width: ' + product.barWidth + '%'"/>
                                                </div>
                                            </div>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <div class="text-center text-muted small py-4">
                                            <i class="oi fs-2 d-block mb-2 opacity-50" data-icon="inbox"/>
                                            Sin datos en este periodo
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                            <div t-if="block.component === 'order_status'" t-att-class="this.getBlockClass(block) + (this.editingLayout ? ' xtd-dashboard-editable-block' : '')" t-att-data-block-key="block.key">
                            <t t-call="xtendoo_xtd_theme.XtdDashboardBlockEditorControls"/>
                            <div class="card border-0 shadow-sm rounded-dashboard p-4 h-100">
                                <h5 class="fw-bold mb-4">Estado de pedidos</h5>
                                <div class="d-flex flex-column align-items-center justify-content-center h-100">
                                    <div class="donut-chart-container mb-4">
                                        <canvas t-ref="this.orderStatusChartRef" class="xtd-donut-canvas"></canvas>
                                        <div class="donut-center-label">
                                            <span class="fw-black h4 mb-0" t-out="this.donutTotal"/>
                                            <span class="text-muted x-small">Pedidos</span>
                                        </div>
                                    </div>
                                    <div class="w-100 vstack gap-2">
                                        <t t-foreach="this.orderStatus" t-as="status" t-key="status.state">
                                            <div class="d-flex align-items-center justify-content-between small">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div t-attf-class="rounded-circle status-dot bg-#{status.state}"/>
                                                    <span class="text-muted" t-out="status.label"/>
                                                </div>
                                                <span class="fw-bold"><t t-out="status.count"/></span>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                             <div t-if="['generic_list', 'generic_calendar', 'generic_kanban'].includes(block.component)" t-att-class="this.getBlockClass(block) + (this.editingLayout ? ' xtd-dashboard-editable-block' : '')" t-att-data-block-key="block.key">
                                <t t-call="xtendoo_xtd_theme.XtdDashboardBlockEditorControls"/>
                                <div class="card border-0 shadow-sm rounded-dashboard p-4 h-100">
                                    <div class="d-flex justify-content-between align-items-center mb-4">
                                        <h5 class="fw-bold mb-0" t-out="block.name"/>
                                        <span class="badge rounded-pill bg-light text-dark" t-out="this.getGenericBlockTypeLabel(block)"/>
                                    </div>
                                    <div t-if="block.component === 'generic_kanban'" class="xtd-dashboard-kanban-grid">
                                        <t t-if="this.getGenericBlockData(block).records.length">
                                            <t t-foreach="this.getGenericBlockData(block).records" t-as="record" t-key="record.id">
                                                <button type="button" class="xtd-dashboard-kanban-card" t-on-click="() =&gt; this.openGenericRecord(block, record)">
                                                    <div t-attf-class="xtd-dashboard-kanban-card__accent bg-#{this.getListAccentColor(record_index)}"/>
                                                    <div class="xtd-dashboard-kanban-card__body">
                                                        <span class="xtd-dashboard-kanban-card__title" t-out="this.getGenericKanbanTitle(block, record)"/>
                                                        <span t-foreach="this.getGenericKanbanDetailFields(block)" t-as="fieldName" t-key="fieldName" class="xtd-dashboard-kanban-card__line">
                                                            <small class="text-muted fw-bold text-uppercase" t-out="this.getGenericFieldLabel(block, fieldName)"/>
                                                            <span t-if="this.getFieldType(block, fieldName) === 'selection'" t-att-class="'badge rounded-pill ' + this.getStateClass(record[fieldName])" t-out="this.formatGenericValue(record[fieldName], block, fieldName)"/>
                                                            <span t-else="" t-att-class="this.formatGenericValue(record[fieldName], block, fieldName) ? this.getFieldClass(block, fieldName) : 'text-muted'" t-out="this.formatGenericValue(record[fieldName], block, fieldName) || '—'"/>
                                                        </span>
                                                    </div>
                                                </button>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <div class="text-center py-5">
                                                <i class="oi fs-1 text-muted mb-3 opacity-25" data-icon="grid_view"/>
                                                <p class="text-muted small">Sin datos</p>
                                            </div>
                                        </t>
                                    </div>
                                    <div t-elif="block.component === 'generic_list'" class="vstack gap-1">
                                        <t t-if="this.getGenericBlockData(block).records.length">
                                            <t t-foreach="this.getGenericBlockData(block).records" t-as="record" t-key="record.id">
                                                <button type="button" class="xtd-feed-row" t-on-click="() =&gt; this.openGenericRecord(block, record)">
                                                    <div t-attf-class="xtd-feed-dot bg-#{this.getListAccentColor(record_index)}"/>
                                                    <div class="xtd-feed-body">
                                                        <div class="xtd-feed-top">
                                                            <span class="fw-bold small text-truncate" t-out="this.getGenericKanbanTitle(block, record)"/>
                                                            <div class="xtd-feed-extras">
                                                                <t t-foreach="this.getGenericBlockData(block).fields" t-as="fieldName" t-key="fieldName">
                                                                    <t t-if="!this.isFirstField(block, fieldName) &amp;&amp; this.getFieldType(block, fieldName) === 'selection'">
                                                                        <span t-att-class="'badge rounded-pill ' + this.getStateClass(record[fieldName])" t-out="this.formatGenericValue(record[fieldName], block, fieldName)"/>
                                                                    </t>
                                                                    <t t-elif="!this.isFirstField(block, fieldName) &amp;&amp; this.getFieldType(block, fieldName) === 'monetary'">
                                                                        <span class="fw-bold x-small" t-out="this.formatGenericValue(record[fieldName], block, fieldName)"/>
                                                                    </t>
                                                                </t>
                                                            </div>
                                                        </div>
                                                        <div t-if="this.getGenericKanbanDetailFields(block).length" class="xtd-feed-details">
                                                            <t t-foreach="this.getGenericKanbanDetailFields(block)" t-as="fieldName" t-key="fieldName">
                                                                <t t-if="this.getFieldType(block, fieldName) !== 'selection' &amp;&amp; this.getFieldType(block, fieldName) !== 'monetary'">
                                                                    <span class="x-small text-muted me-3">
                                                                        <span class="fw-bold text-uppercase" t-out="this.getGenericFieldLabel(block, fieldName)"/>
                                                                        <t t-out="' ' + this.formatGenericValue(record[fieldName], block, fieldName)"/>
                                                                    </span>
                                                                </t>
                                                            </t>
                                                        </div>
                                                    </div>
                                                </button>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <div class="text-center py-5">
                                                <i class="oi fs-1 text-muted mb-3 opacity-25" data-icon="list"/>
                                                <p class="text-muted small">Sin datos</p>
                                            </div>
                                        </t>
                                    </div>
                                    <div t-else="">
                                        <div class="text-muted small py-4 text-center">Bloque no disponible</div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="xtendoo_xtd_theme.XtdDashboardBlockEditorControls">
        <div t-if="this.editingLayout" class="xtd-dashboard-block-controls"
             draggable="true"
             title="Arrastra para reordenar"
             t-on-dragstart="(ev) =&gt; this.onBlockDragStart(ev, block)">
            <span class="xtd-dashboard-block-controls__handle">
                <i class="oi" data-icon="open_with"/>
            </span>
            <span class="xtd-dashboard-block-controls__name" t-out="block.name"/>
            <div class="xtd-dashboard-block-controls__actions">
                <button type="button" class="btn btn-light btn-sm" title="Más estrecho"
                        t-att-disabled="block.size === 'small'"
                        t-on-click.stop.prevent="() =&gt; this.resizeDashboardBlock(block, -1)">
                    <i class="oi" data-icon="close_fullscreen"/>
                </button>
                <button type="button" class="btn btn-light btn-sm" title="Más ancho"
                        t-att-disabled="block.size === 'full'"
                        t-on-click.stop.prevent="() =&gt; this.resizeDashboardBlock(block, 1)">
                    <i class="oi" data-icon="open_in_full"/>
                </button>
                <button type="button" class="btn btn-light btn-sm"
                        t-att-title="this.getBlockVisibilityTitle(block)"
                        t-on-click.stop.prevent="() =&gt; this.toggleBlockHidden(block)">
                    <i class="oi" t-att-data-icon="block.config?.hidden ? 'visibility_off' : 'visibility'"/>
                </button>
                <button t-if="block.can_delete" type="button" class="btn btn-light btn-sm text-danger" title="Eliminar bloque" t-on-click.stop.prevent="() =&gt; this.deleteCustomBlock(block)">
                    <i class="oi" data-icon="delete"/>
                </button>
            </div>
        </div>
    </t>
</templates>
