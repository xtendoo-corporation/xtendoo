<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!-- Heredamos de la NavBar de web_responsive para poner nuestro botón y forzar el sidebar en desktop -->
    <t t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//AppsMenu" position="before">
            <t t-if="!this.ui.isSmall">
                <t t-call="web.NavBar.AppsMenu.Sidebar">
                    <t t-set="apps" t-value="this.menuService.getApps()" />
                </t>
                <button type="button"
                        class="xtd-sidebar-arrow"
                        t-att-title="this.xtdSidebarToggleTitle"
                        t-on-click.stop.prevent="this.toggleXtdSidebarOff">
                    <i class="oi" t-att-data-icon="this.isXtdSidebarOff ? 'chevron_right' : 'chevron_left'"/>
                </button>
            </t>
        </xpath>
        <!-- No ocultamos el AppsMenu, ya que contiene el botón de hamburguesa que hemos parcheado -->
    </t>

    <t t-inherit="web_responsive.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_grid_apps_menu__button')]" position="replace">
            <button
                class="o_grid_apps_menu__button o_xtd_dashboard_home"
                t-att-title="this.xtdAppsButtonTitle"
                t-on-click.stop="this.onXtdAppsButtonClick"
            >
                <img src="/xtendoo_xtd_theme/static/src/img/xtd_symbol.svg" alt="Xtd"/>
            </button>
        </xpath>
    </t>

    <!-- Buscador de menús (paleta de comandos de Odoo) en la barra superior del dashboard -->
    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_menu_systray')]" position="before">
            <div t-if="this.showXtdNavbarSearch" class="o_xtd_navbar_search flex-grow-1 d-flex justify-content-center px-3">
                <div class="o_xtd_navbar_search__box">
                    <i class="oi" data-icon="search"/>
                    <input type="search"
                           t-ref="this.xtdNavbarSearchRef"
                           autocomplete="off"
                           placeholder="Buscar menús..."
                           class="form-control"
                           t-on-input="this.onXtdNavbarSearchInput"
                           t-on-click="this.onXtdNavbarSearchClick"/>
                </div>
            </div>
        </xpath>
    </t>

    <!-- Modificamos el sidebar de aplicaciones -->
    <t t-inherit="web.NavBar.AppsMenu.Sidebar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_app_menu_sidebar')]" position="attributes">
            <attribute name="class" add="xtd-sidebar-panel" separator=" "/>
        </xpath>

        <!-- Inyectamos el logo y quitamos el botón 'All Apps' original para un diseño más limpio -->
        <xpath expr="//div[hasclass('o_sidebar_topbar')]" position="replace">
            <div class="o_sidebar_topbar d-flex align-items-center flex-shrink-0 py-4 px-3 mb-3">
                <img src="/xtendoo_xtd_theme/static/src/img/xtd_logo.svg" class="img-fluid" style="max-height: 40px;"/>
            </div>
        </xpath>

        <!-- Aseguramos que el contenido del sidebar siempre use la lista de apps completa -->
        <xpath expr="//nav[hasclass('o_burger_menu_content')]" position="replace">
            <nav class="o_burger_menu_content flex-grow-1 flex-shrink-1 overflow-auto p-0">
                <ul class="nav nav-pills flex-column gap-1 ps-0">
                    <t t-set="sidebarApps" t-value="this.getXtdSidebarApps(apps)"/>
                    <t t-foreach="sidebarApps" t-as="app" t-key="app.id">
                        <li class="nav-item">
                            <a t-att-href="this.getMenuItemHref(app)"
                               class="nav-link d-flex align-items-center gap-3 py-3 text-dark rounded-dashboard border-0"
                               t-att-class="{'active': this.menuService.getCurrentApp() === app, 'xtd-sidebar-app-hidden': this.isXtdSidebarAppHidden(app)}"
                               t-on-click="() =&gt; { this.onNavBarDropdownItemSelection(app); this._closeAppMenuSidebar(); }">
                                <img t-if="app.webIconData" t-att-src="app.webIconData" style="width: 24px; height: 24px;"/>
                                <span class="fw-bold" t-out="app.name"/>
                                <span t-if="this.xtdSidebarState.isReordering" class="xtd-sidebar-reorder ms-auto">
                                    <button type="button"
                                            class="xtd-sidebar-reorder-btn"
                                            t-att-title="this.getXtdSidebarVisibilityTitle(app)"
                                            t-on-click.stop.prevent="() =&gt; this.toggleXtdSidebarAppHidden(app)">
                                        <i class="oi" t-att-data-icon="this.isXtdSidebarAppHidden(app) ? 'visibility_off' : 'visibility'"/>
                                    </button>
                                    <button type="button"
                                            class="xtd-sidebar-reorder-btn"
                                            title="Subir"
                                            t-on-click.stop.prevent="() =&gt; this.moveXtdSidebarApp(app, -1)">
                                        <i class="oi" data-icon="expand_less"/>
                                    </button>
                                    <button type="button"
                                            class="xtd-sidebar-reorder-btn"
                                            title="Bajar"
                                            t-on-click.stop.prevent="() =&gt; this.moveXtdSidebarApp(app, 1)">
                                        <i class="oi" data-icon="expand_more"/>
                                    </button>
                                </span>
                            </a>
                        </li>
                    </t>
                </ul>
            </nav>
            <button type="button"
                    class="xtd-sidebar-settings"
                    t-att-class="{'xtd-sidebar-settings--active': this.xtdSidebarState.isReordering}"
                    title="Ordenar aplicaciones"
                    t-on-click.stop.prevent="this.toggleXtdSidebarReorder">
                <i class="oi" data-icon="settings"/>
                <span>Ordenar aplicaciones</span>
            </button>
        </xpath>

        <!-- Eliminamos el backdrop modal que pone web_responsive en móvil si queremos que se comporte como sidebar persistente -->
        <xpath expr="//div[hasclass('modal-backdrop')]" position="replace"/>
    </t>
</templates>
