<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="xtendoo_xtd_theme.CustomerDisplay" t-inherit="point_of_sale.CustomerDisplay" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'o_customer_display_logo')]/img" position="replace">
            <img class="img-fluid xtd-pos-customer-logo" src="/xtendoo_xtd_theme/static/src/img/xtd_logo.svg" alt="Xtd"/>
        </xpath>
        <xpath expr="//OdooLogo" position="replace">
            <img class="xtd-pos-powered-logo" src="/xtendoo_xtd_theme/static/src/img/xtd_logo.svg" alt="Xtd"/>
        </xpath>
    </t>
</templates>
