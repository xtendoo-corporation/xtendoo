<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Optional dashboard blocks. They are active, but not added to any layout by default. -->

    <record id="xtd_dashboard_available_overdue_invoices" model="xtd.dashboard.block">
        <field name="name">Facturas vencidas</field>
        <field name="technical_key">available_overdue_invoices</field>
        <field name="block_type">list</field>
        <field name="component">generic_list</field>
        <field name="model_name">account.move</field>
        <field name="default_size">large</field>
        <field name="sequence">1010</field>
        <field name="config" eval="{'fields': ['name', 'partner_id', 'amount_total', 'invoice_date_due', 'payment_state'], 'limit': 6, 'domain': [('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('payment_state', 'in', ['not_paid', 'partial']), ('invoice_date_due', '&lt;', '__today__')], 'date_field': 'invoice_date_due'}"/>
    </record>

    <record id="xtd_dashboard_available_draft_invoices" model="xtd.dashboard.block">
        <field name="name">Facturas en borrador</field>
        <field name="technical_key">available_draft_invoices</field>
        <field name="block_type">list</field>
        <field name="component">generic_list</field>
        <field name="model_name">account.move</field>
        <field name="default_size">large</field>
        <field name="sequence">1020</field>
        <field name="config" eval="{'fields': ['name', 'partner_id', 'amount_total', 'invoice_date', 'state'], 'limit': 6, 'domain': [('move_type', '=', 'out_invoice'), ('state', '=', 'draft')], 'date_field': 'invoice_date'}"/>
    </record>

    <record id="xtd_dashboard_available_vendor_bills_pending" model="xtd.dashboard.block">
        <field name="name">Facturas proveedor pendientes</field>
        <field name="technical_key">available_vendor_bills_pending</field>
        <field name="block_type">list</field>
        <field name="component">generic_list</field>
        <field name="model_name">account.move</field>
        <field name="default_size">large</field>
        <field name="sequence">1030</field>
        <field name="config" eval="{'fields': ['name', 'partner_id', 'amount_total', 'invoice_date_due', 'payment_state'], 'limit': 6, 'domain': [('move_type', '=', 'in_invoice'), ('state', '=', 'posted'), ('payment_state', 'in', ['not_paid', 'partial'])], 'date_field': 'invoice_date_due'}"/>
    </record>

    <record id="xtd_dashboard_available_stock_outgoing" model="xtd.dashboard.block">
        <field name="name">Entregas pendientes</field>
        <field name="technical_key">available_stock_outgoing</field>
        <field name="block_type">list</field>
        <field name="component">generic_list</field>
        <field name="model_name">stock.picking</field>
        <field name="default_size">large</field>
        <field name="sequence">1110</field>
        <field name="config" eval="{'fields': ['name', 'partner_id', 'scheduled_date', 'state'], 'limit': 6, 'domain': [('picking_type_code', '=', 'outgoing'), ('state', 'not in', ['done', 'cancel'])], 'date_field': 'scheduled_date'}"/>
    </record>

    <record id="xtd_dashboard_available_stock_incoming" model="xtd.dashboard.block">
        <field name="name">Recepciones pendientes</field>
        <field name="technical_key">available_stock_incoming</field>
        <field name="block_type">list</field>
        <field name="component">generic_list</field>
        <field name="model_name">stock.picking</field>
        <field name="default_size">large</field>
        <field name="sequence">1120</field>
        <field name="config" eval="{'fields': ['name', 'partner_id', 'scheduled_date', 'state'], 'limit': 6, 'domain': [('picking_type_code', '=', 'incoming'), ('state', 'not in', ['done', 'cancel'])], 'date_field': 'scheduled_date'}"/>
    </record>

    <record id="xtd_dashboard_available_stock_low" model="xtd.dashboard.block">
        <field name="name">Stock bajo</field>
        <field name="technical_key">available_stock_low</field>
        <field name="block_type">custom</field>
        <field name="component">generic_kanban</field>
        <field name="model_name">product.product</field>
        <field name="default_size">large</field>
        <field name="sequence">1130</field>
        <field name="config" eval="{'fields': ['display_name', 'qty_available', 'virtual_available'], 'limit': 8, 'domain': [('type', '=', 'consu')]}"/>
    </record>

    <record id="xtd_dashboard_available_crm_opportunities" model="xtd.dashboard.block">
        <field name="name">Oportunidades abiertas</field>
        <field name="technical_key">available_crm_opportunities</field>
        <field name="block_type">custom</field>
        <field name="component">generic_kanban</field>
        <field name="model_name">crm.lead</field>
        <field name="default_size">large</field>
        <field name="sequence">1210</field>
        <field name="config" eval="{'fields': ['name', 'partner_id', 'expected_revenue', 'stage_id'], 'limit': 8, 'domain': [('type', '=', 'opportunity'), ('active', '=', True), ('probability', '&lt;', 100)]}"/>
    </record>

    <record id="xtd_dashboard_available_crm_activities" model="xtd.dashboard.block">
        <field name="name">Actividades CRM vencidas</field>
        <field name="technical_key">available_crm_activities</field>
        <field name="block_type">list</field>
        <field name="component">generic_list</field>
        <field name="model_name">mail.activity</field>
        <field name="default_size">medium</field>
        <field name="sequence">1220</field>
        <field name="config" eval="{'fields': ['res_name', 'activity_type_id', 'user_id', 'date_deadline'], 'limit': 6, 'domain': [('date_deadline', '!=', False), ('date_deadline', '&lt;', '__today__')], 'date_field': 'date_deadline'}"/>
    </record>

    <record id="xtd_dashboard_available_project_tasks" model="xtd.dashboard.block">
        <field name="name">Tareas vencidas</field>
        <field name="technical_key">available_project_tasks</field>
        <field name="block_type">list</field>
        <field name="component">generic_list</field>
        <field name="model_name">project.task</field>
        <field name="default_size">large</field>
        <field name="sequence">1310</field>
        <field name="config" eval="{'fields': ['name', 'project_id', 'date_deadline', 'stage_id'], 'limit': 6, 'domain': [('date_deadline', '!=', False), ('date_deadline', '&lt;', '__today__')], 'date_field': 'date_deadline'}"/>
    </record>

    <record id="xtd_dashboard_available_helpdesk_tickets" model="xtd.dashboard.block">
        <field name="name">Tickets abiertos</field>
        <field name="technical_key">available_helpdesk_tickets</field>
        <field name="block_type">list</field>
        <field name="component">generic_list</field>
        <field name="model_name">helpdesk.ticket</field>
        <field name="default_size">large</field>
        <field name="sequence">1410</field>
        <field name="config" eval="{'fields': ['name', 'partner_id', 'user_id', 'stage_id'], 'limit': 6}"/>
    </record>

    <record id="xtd_dashboard_available_pos_sessions" model="xtd.dashboard.block">
        <field name="name">Sesiones TPV abiertas</field>
        <field name="technical_key">available_pos_sessions</field>
        <field name="block_type">list</field>
        <field name="component">generic_list</field>
        <field name="model_name">pos.session</field>
        <field name="default_size">medium</field>
        <field name="sequence">1510</field>
        <field name="config" eval="{'fields': ['name', 'user_id', 'start_at', 'state'], 'limit': 6, 'domain': [('state', '!=', 'closed')], 'date_field': 'start_at'}"/>
    </record>
</odoo>
