<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_simple_modif_xtd_color_scheme" model="ir.ui.view">
        <field name="name">res.users.preferences.form.xtd.color.scheme</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field
                    name="color_scheme"
                    widget="radio"
                    string="Theme"
                    options="{'horizontal': true}"
                />
                <field
                    name="xtd_use_custom_dashboard"
                    string="Dashboard personalizado Xtd"
                />
            </xpath>
        </field>
    </record>

    <record id="view_users_form_xtd_color_scheme" model="ir.ui.view">
        <field name="name">res.users.form.xtd.color.scheme</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field
                    name="color_scheme"
                    widget="radio"
                    string="Theme"
                    options="{'horizontal': true}"
                />
                <field
                    name="xtd_use_custom_dashboard"
                    string="Dashboard personalizado Xtd"
                />
            </xpath>
        </field>
    </record>

    <record id="res_users_form_view_inherit_xtd" model="ir.ui.view">
        <field name="name">res.users.form.inherit.xtd</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']//group[@name='other_preferences']" position="inside">
                <field name="action_id" invisible="0" readonly="0"/>
            </xpath>
        </field>
    </record>
</odoo>
