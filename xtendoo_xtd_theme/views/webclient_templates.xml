<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Branding básico de layout -->
    <template id="web_layout_xtd_branding" inherit_id="web.layout" name="Xtd Web Layout Branding">
        <xpath expr="//title" position="replace">
            <title t-esc="title or 'Xtd'"/>
        </xpath>
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link type="image/x-icon" rel="shortcut icon" t-att-href="x_icon or '/xtendoo_xtd_theme/static/src/img/favicon.ico'"/>
        </xpath>
    </template>
    <!-- Sobrescribir el layout de login por defecto para centrarlo todo -->
    <template id="login_layout_xtd_branding" inherit_id="web.login_layout" name="Xtd Login Branding">
        <xpath expr="//t[@t-call='web.frontend_layout']" position="replace">
            <t t-call="web.frontend_layout">
                <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
                <t t-set="body_classname" t-value="'xtd_login_body'"/>
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                <div class="xtd-login-wrapper">
                    <div class="xtd-login-card">
                        <div class="xtd-dots"/>
                        <div class="xtd-card-content">
                            <div class="xtd-login-logo">
                                <img src="/xtendoo_xtd_theme/static/src/img/xtd_logo.svg" alt="Xtd logo"/>
                            </div>
                            <t t-out="0"/>
                        </div>
                    </div>
                </div>
                <div class="xtd-login-footer-links" t-if="not disable_footer">
                    <t t-if="not disable_database_manager">
                        <a href="/web/database/manager">Manage Xtd Databases</a>
                        <span>|</span>
                    </t>
                    <span>Powered by Xtd</span>
                </div>
            </t>
        </xpath>
    </template>
    <!-- Personalizar el formulario de login -->
    <template id="login_xtd" inherit_id="web.login" name="Xtd Login">
        <!-- Forzamos que el formulario sea visible siempre, el componente JS se encargará de ocultarlo si hay varios usuarios -->
        <xpath expr="//form" position="attributes">
            <attribute name="t-attf-class">oe_login_form</attribute>
        </xpath>
        <!-- Títulos Bienvenido -->
        <xpath expr="//div[hasclass('oe_structure')][1]" position="after">
            <div class="text-start mb-4 position-relative">
                <h2>Bienvenido</h2>
                <p class="subtitle mb-2">Inicia sesión para continuar</p>
                <!-- Punto de anclaje para el botón de elegir usuario -->
                <div class="o_xtd_user_switch_btn_container"/>
            </div>
        </xpath>
        <!-- Empresa (Base de datos) - Eliminado a petición del usuario -->
        <xpath expr="//div[@t-if='databases and len(databases) &gt; 1']" position="replace"/>
        <!-- Usuario -->
        <xpath expr="//div[hasclass('field-login')]" position="replace">
            <div class="mb-4 field-login">
                <label for="login" class="form-label">Usuario</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-user-o"/></span>
                    <input type="text" placeholder="Introduce tu usuario" name="login" t-att-value="login" id="login" class="form-control" required="required" autocapitalize="off" autocomplete="username"/>
                </div>
            </div>
        </xpath>
        <!-- Contraseña (en Odoo 19 el campo está dentro de o_caps_lock_warning) -->
        <xpath expr="//div[hasclass('o_caps_lock_warning')]" position="replace">
            <div class="mb-3 field-password">
                <label for="password" class="form-label">Contraseña</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-lock"/></span>
                    <input type="password" placeholder="Introduce tu contraseña" name="password" id="password" class="form-control" required="required" autocomplete="current-password" t-att-autofocus="'autofocus' if login else None" maxlength="4096"/>
                    <span class="password-toggle o_show_password"><i class="fa fa-eye-slash"/></span>
                </div>
            </div>
        </xpath>
        <!-- ¿Has olvidado tu contraseña? -->
        <xpath expr="//form" position="inside">
            <div class="forgot-password">
                <a t-attf-href="/web/reset_password?{{ keep_query() }}" t-if="reset_password_enabled">¿Has olvidado tu contraseña?</a>
            </div>
        </xpath>
        <!-- Botones Iniciar sesión, o, Passkey -->
        <xpath expr="//div[hasclass('oe_login_buttons')]" position="replace">
            <div class="oe_login_buttons d-grid mb-1">
                <button type="submit" class="btn btn-primary btn-login">Iniciar sesión</button>
                <div class="separator">
                </div>
                
            </div>
        </xpath>
    </template>
    <!-- Campos de registro (Signup) -->
    <template id="auth_signup_fields_xtd" inherit_id="auth_signup.fields" name="Xtd Auth Signup Fields">
        <xpath expr="//div[hasclass('field-password')]" position="replace">
            <div class="mb-4 field-password">
                <label for="password" class="form-label">Contraseña</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-lock"/></span>
                    <input type="password" placeholder="Crea una contraseña" name="password" id="password" class="form-control" required="required" autocomplete="new-password"/>
                    <span class="password-toggle o_show_password text-muted"><i class="fa fa-eye-slash"/></span>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('field-confirm_password')]" position="replace">
            <div class="mb-4 field-confirm_password">
                <label for="confirm_password" class="form-label">Confirmar contraseña</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-lock"/></span>
                    <input type="password" placeholder="Confirma tu contraseña" name="confirm_password" id="confirm_password" class="form-control" required="required" autocomplete="new-password"/>
                    <span class="password-toggle o_show_password text-muted"><i class="fa fa-eye-slash"/></span>
                </div>
            </div>
        </xpath>
    </template>
    <!-- Pantalla de Signup -->
    <template id="auth_signup_signup_xtd" inherit_id="auth_signup.signup" name="Xtd Auth Signup">
        <xpath expr="//div[hasclass('oe_structure')][1]" position="after">
            <div class="text-start mb-4">
                <a t-attf-href="/web/login?{{ keep_query() }}" class="mb-3 d-inline-block text-muted"><i class="fa fa-arrow-left fa-lg"/></a>
                <h2>Crear cuenta</h2>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('field-name')]" position="replace">
            <div class="mb-4 field-name">
                <label for="name" class="form-label">Empresa</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-building-o"/></span>
                    <input type="text" placeholder="Nombre de tu empresa" name="name" t-att-value="name" id="name" class="form-control" autofocus="autofocus" required="required"/>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('field-login')]" position="replace">
            <div class="mb-4 field-login">
                <label for="login" class="form-label">Usuario / Correo electrónico</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-envelope-o"/></span>
                    <input type="text" placeholder="tu@email.com" name="login" t-att-value="login" id="login" class="form-control" required="required" autocapitalize="off"/>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('oe_login_buttons')]" position="replace">
            <div class="oe_login_buttons d-grid mb-1 pt-3">
                <button type="submit" class="btn btn-primary btn-login d-flex align-items-center justify-content-center">
                    Crear cuenta <i class="fa fa-arrow-right ms-auto"/>
                </button>
                <div class="signup-footer mt-4">
                    ¿Ya tienes una cuenta? <a t-attf-href="/web/login?{{ keep_query() }}">Inicia sesión</a>
                </div>
            </div>
        </xpath>
    </template>
    <!-- Meta theme color -->
    <template id="webclient_bootstrap_xtd_theme_color" inherit_id="web.webclient_bootstrap" name="Xtd Webclient Bootstrap Theme Color">
        <xpath expr="//meta[@name='theme-color']" position="replace">
            <meta name="theme-color" content="#FF7A00"/>
        </xpath>
    </template>
</odoo>
