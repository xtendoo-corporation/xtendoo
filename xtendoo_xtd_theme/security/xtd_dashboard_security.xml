<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 20: ir.model.access + ir.rule se fusionan en ir.access
         (permiso por grupo/operación con dominio opcional). Los permisos de
         un mismo modelo se suman (OR), igual que antes las reglas de grupo. -->
    <record id="access_xtd_dashboard_user_layout_own" model="ir.access">
        <field name="name">Xtd dashboard user layout: own records</field>
        <field name="model_id" ref="model_xtd_dashboard_user_layout"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="operation">crud</field>
        <field name="domain">[('user_id', '=', user.id)]</field>
    </record>

    <record id="access_xtd_dashboard_user_layout_admin" model="ir.access">
        <field name="name">Xtd dashboard user layout: administrators</field>
        <field name="model_id" ref="model_xtd_dashboard_user_layout"/>
        <field name="group_id" ref="base.group_system"/>
        <field name="operation">crud</field>
    </record>
</odoo>
