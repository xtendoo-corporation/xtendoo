<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_xtd_dashboard_user_layout_own" model="ir.rule">
        <field name="name">Xtd dashboard user layout: own records</field>
        <field name="model_id" ref="model_xtd_dashboard_user_layout"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_xtd_dashboard_user_layout_admin" model="ir.rule">
        <field name="name">Xtd dashboard user layout: administrators</field>
        <field name="model_id" ref="model_xtd_dashboard_user_layout"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
