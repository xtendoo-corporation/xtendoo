<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Extender la vista de configuración de Punto de Venta -->
        <record id="res_config_settings_view_form_pos_performance" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.pos.performance</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">

                <!-- Agregar campos de rendimiento usando field position -->
                <field name="pos_module_pos_restaurant" position="after">

                    <h2>Rendimiento del POS</h2>

                    <div class="row mt16 o_settings_container">
                        <!-- Límite de productos -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="pos_limited_product_count"/>
                                <div class="text-muted">
                                    Número máximo de productos a cargar al iniciar el TPV
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="pos_limited_product_count" class="oe_inline" style="width: 100px;"/>
                                        <span class="ms-2">productos</span>
                                    </div>
                                    <div class="text-muted small mt8">
                                        Recomendaciones:
                                        <ul class="small mb-0 mt4">
                                            <li>&lt; 5.000 productos: 0 (sin límite)</li>
                                            <li>5.000-15.000: 500-1.000</li>
                                            <li>15.000-50.000: 300-500</li>
                                            <li>&gt; 50.000: 200-300</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Límite de clientes -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="pos_limited_customer_count"/>
                                <div class="text-muted">
                                    Número máximo de clientes a cargar al iniciar el TPV
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="pos_limited_customer_count" class="oe_inline" style="width: 100px;"/>
                                        <span class="ms-2">clientes</span>
                                    </div>
                                    <div class="text-muted small mt8">
                                        Recomendaciones:
                                        <ul class="small mb-0 mt4">
                                            <li>&lt; 5.000 clientes: 0 (sin límite)</li>
                                            <li>5.000-15.000: 500-1.000</li>
                                            <li>15.000-50.000: 300-500</li>
                                            <li>&gt; 50.000: 200-300</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </field>

            </field>
        </record>

    </data>
</odoo>

