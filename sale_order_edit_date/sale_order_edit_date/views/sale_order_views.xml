<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited sale_order view: make date_order editable in confirmed state -->
    <record id="view_order_form_edit_date" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.edit.order.date</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order'][2]" position="replace">
                <field name="date_order"
                    invisible="state in ['draft', 'sent']"
                    readonly="state == 'cancel'"
                    nolabel="1" />
            </xpath>
        </field>
    </record>
</odoo>