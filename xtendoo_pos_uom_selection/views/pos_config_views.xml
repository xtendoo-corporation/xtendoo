<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_uom" model="ir.ui.view">
        <field name="name">pos.config.form.uom</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_config_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='product_management']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="allow_uom_selection"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="allow_uom_selection"/>
                        <div class="text-muted">
                            Permite a los usuarios cambiar la unidad de medición de los productos en el POS
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

