<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
         <template
            id="document_format_xtendoo.hide_taxes_sale_order"
            inherit_id="document_format_clean.report_saleorder_document_xtendoo">
             <!-- Ocultar el encabezado de la columna de impuestos -->
             <xpath expr="//th[@name='th_taxes']" position="replace">
             </xpath>

             <!-- Ocultar el contenido de la columna de impuestos en cada línea -->
             <xpath expr="//td[@name='td_taxes']" position="replace">
             </xpath>
         </template>
    </data>
</odoo>
