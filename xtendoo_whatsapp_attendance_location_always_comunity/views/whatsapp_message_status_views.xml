<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_message_status_list" model="ir.ui.view">
        <field name="name">whatsapp.message.status.list</field>
        <field name="model">whatsapp.message.status</field>
        <field name="arch" type="xml">
            <list create="0" edit="0"
                  decoration-danger="status == 'failed'"
                  decoration-success="status in ('delivered', 'read')">
                <field name="status_date"/>
                <field name="recipient_phone"/>
                <field name="status"/>
                <field name="error_code"/>
                <field name="error_title"/>
                <field name="conversation_category" optional="hide"/>
                <field name="wa_message_id" optional="hide"/>
                <field name="gateway_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_message_status_form" model="ir.ui.view">
        <field name="name">whatsapp.message.status.form</field>
        <field name="model">whatsapp.message.status</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="wa_message_id"/>
                            <field name="gateway_id"/>
                            <field name="recipient_phone"/>
                            <field name="status"/>
                            <field name="status_date"/>
                        </group>
                        <group>
                            <field name="error_code"/>
                            <field name="error_title"/>
                            <field name="error_details"/>
                            <field name="conversation_category"/>
                            <field name="notification_id"/>
                            <field name="message_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_whatsapp_message_status_search" model="ir.ui.view">
        <field name="name">whatsapp.message.status.search</field>
        <field name="model">whatsapp.message.status</field>
        <field name="arch" type="xml">
            <search>
                <field name="recipient_phone"/>
                <field name="wa_message_id"/>
                <field name="error_code"/>
                <filter name="failed" string="Fallidos" domain="[('status', '=', 'failed')]"/>
                <filter name="delivered" string="Entregados" domain="[('status', '=', 'delivered')]"/>
                <filter name="read" string="Leídos" domain="[('status', '=', 'read')]"/>
                <filter name="sent" string="Enviados" domain="[('status', '=', 'sent')]"/>
                <group>
                    <filter name="group_status" string="Estado" context="{'group_by': 'status'}"/>
                    <filter name="group_error" string="Código de error" context="{'group_by': 'error_code'}"/>
                    <filter name="group_phone" string="Teléfono" context="{'group_by': 'recipient_phone'}"/>
                    <filter name="group_day" string="Día" context="{'group_by': 'status_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_whatsapp_message_status" model="ir.actions.act_window">
        <field name="name">Estados de mensajes WhatsApp</field>
        <field name="res_model">whatsapp.message.status</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_whatsapp_message_status"
              name="WhatsApp - Estados de mensajes"
              parent="hr_attendance.menu_hr_attendance_root"
              action="action_whatsapp_message_status"
              groups="base.group_system"
              sequence="52"/>
</odoo>
