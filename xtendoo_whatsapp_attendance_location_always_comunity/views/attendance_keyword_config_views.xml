<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista formulario para configuración de palabras clave -->
    <record id="view_attendance_keyword_config_location_always_form" model="ir.ui.view">
        <field name="name">attendance.keyword.config.location.always.form</field>
        <field name="model">attendance.keyword.config.location.always</field>
        <field name="arch" type="xml">
            <form string="Configuración Palabras Clave Asistencia WhatsApp - Location Always">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de la configuración"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="attendance_type"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Palabras Clave">
                            <field name="keywords" placeholder="Una palabra clave por línea. Ejemplos:
/entrada
entrada
entrar
llegar
check in
fichar entrada"/>
                            <div class="alert alert-info">
                                <strong>Ayuda:</strong>
                                <ul>
                                    <li>Escribe una palabra clave por línea</li>
                                    <li>Se pueden usar comandos con / (ej: /entrada)</li>
                                    <li>No es sensible a mayúsculas/minúsculas</li>
                                    <li>Ejemplos: /entrada, entrada, entrar, llegar, check in, etc.</li>
                                </ul>
                            </div>
                        </page>

                        <page string="Mensaje de Confirmación">
                            <field name="custom_message" placeholder="Mensaje personalizado de confirmación.

Variables disponibles:
{employee_name} - Nombre del empleado
{time} - Hora del registro
{date} - Fecha del registro
{action} - Acción realizada (entrada/salida)

Ejemplo:
✅ Hola {employee_name},
Tu {action} ha sido registrada a las {time} del {date}.
¡Que tengas un buen día!"/>

                            <div class="alert alert-info">
                                <strong>Variables disponibles:</strong>
                                <ul>
                                    <li><code>{employee_name}</code> - Nombre del empleado</li>
                                    <li><code>{time}</code> - Hora del registro</li>
                                    <li><code>{date}</code> - Fecha del registro</li>
                                    <li><code>{action}</code> - Acción realizada (entrada/salida)</li>
                                </ul>
                            </div>
                        </page>

                        <page string="Solicitud de Ubicación">
                            <field name="location_request_message" placeholder="Mensaje para solicitar ubicación.

Variables disponibles:
{employee_name} - Nombre del empleado
{action} - Acción realizada (entrada/salida)

Ejemplo:
📍 Tu {action} ya está registrada ✅
Ahora envía tu ubicación para completar el registro."/>

                            <div class="alert alert-warning">
                                <strong>Este módulo SIEMPRE solicita la ubicación</strong>
                                <p>A diferencia del módulo base, este módulo siempre solicitará la ubicación al empleado después de registrar la asistencia.</p>
                            </div>
                        </page>

                        <page string="Confirmación de Ubicación">
                            <field name="location_received_message" placeholder="Mensaje cuando se recibe la ubicación.

Variables disponibles:
{employee_name} - Nombre del empleado
{latitude} - Latitud
{longitude} - Longitud
{maps_url} - URL de Google Maps

Ejemplo:
🎉 ¡Ubicación añadida!
📍 Coordenadas: {latitude}, {longitude}
🗺️ Ver en Maps: {maps_url}"/>

                            <div class="alert alert-info">
                                <strong>Variables disponibles:</strong>
                                <ul>
                                    <li><code>{employee_name}</code> - Nombre del empleado</li>
                                    <li><code>{latitude}</code> - Latitud de la ubicación</li>
                                    <li><code>{longitude}</code> - Longitud de la ubicación</li>
                                    <li><code>{maps_url}</code> - URL de Google Maps</li>
                                </ul>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista lista para configuración de palabras clave -->
    <record id="view_attendance_keyword_config_location_always_tree" model="ir.ui.view">
        <field name="name">attendance.keyword.config.location.always.tree</field>
        <field name="model">attendance.keyword.config.location.always</field>
        <field name="arch" type="xml">
            <list string="Configuración Palabras Clave - Location Always">
                <field name="name"/>
                <field name="attendance_type"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Acción para abrir las configuraciones -->
    <record id="action_attendance_keyword_config_location_always" model="ir.actions.act_window">
        <field name="name">Configuración Palabras Clave (Location Always)</field>
        <field name="res_model">attendance.keyword.config.location.always</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configura las palabras clave para la asistencia automática por WhatsApp con ubicación obligatoria
            </p>
            <p>
                Aquí puedes configurar qué palabras o frases activarán automáticamente
                el registro de entrada o salida cuando los empleados envíen mensajes por WhatsApp.
                <strong>Este módulo SIEMPRE solicita la ubicación del empleado.</strong>
            </p>
        </field>
    </record>

    <!-- Menú en Asistencias → Configuración -->
    <menuitem id="menu_attendance_keyword_config_location_always"
              name="WhatsApp - Palabras Clave (Location Always)"
              parent="hr_attendance.menu_hr_attendance_root"
              action="action_attendance_keyword_config_location_always"
              groups="base.group_user,base.group_system"
              sequence="51"/>

</odoo>

