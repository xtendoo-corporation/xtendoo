<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_journal_update" model="ir.ui.view">
        <field name="name">account.move.form.xtendoo.update.journal</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']/field[@name='journal_id']" position="before">
                <field name="can_update_journal" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='journal_div']/field[@name='journal_id']" position="attributes">
                <attribute name="readonly">
                    state != 'draft' or (posted_before and name not in (False, '', '/') and not can_update_journal)
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>
