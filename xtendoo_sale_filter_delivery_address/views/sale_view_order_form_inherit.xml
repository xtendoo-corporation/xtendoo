<odoo>
  <record id="view_order_form_inherit_partner_shipping_id" model="ir.ui.view">
    <field name="name">sale.order.form.inherit.partner_shipping_id</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
        <attribute name="domain">[('parent_id', '=', partner_id), ('type', '=', 'delivery')]</attribute>
      </xpath>
    </field>
  </record>
</odoo>
