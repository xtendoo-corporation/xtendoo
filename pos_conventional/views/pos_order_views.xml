
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Heredar la vista tree de pos.order para asignar el controller personalizado -->
    <record id="view_pos_order_tree_inherit_close_session" model="ir.ui.view">
        <field name="name">pos.order.list.inherit.conventional</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree" />
        <field name="arch" type="xml">
            <!-- Asignar el controller personalizado con js_class -->
            <xpath expr="//list" position="attributes">
                <attribute name="js_class">button_in_tree</attribute>
                <attribute name="create">true</attribute>
                <!-- Sobrescribir decoraciones: azul solo para borradores NO vinculados, gris para
                vinculados -->
                <attribute name="decoration-info">state == 'draft' and not is_linked_to_sale</attribute>
                <attribute name="decoration-muted">is_linked_to_sale or state == 'cancel'</attribute>
            </xpath>
            <!-- Añadir columna para mostrar si está vinculado a sale.order -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_linked_to_sale" invisible="1" />
                <field name="linked_sale_order_id" string="Pedido venta" optional="show"
                    widget="many2one" options="{'no_open': False}" />
            </xpath>
            <!-- Hacer el campo state opcional (oculto por defecto) -->
            <xpath expr="//field[@name='state'][@widget='badge']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <!-- Heredar la vista form de pos.order para asignar el controller de barcode -->
    <record id="view_pos_order_form_inherit_barcode" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.barcode</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form" />
        <field name="arch" type="xml">
            <!-- Asignar el controller personalizado con js_class para escaneo de barcode -->
            <xpath expr="//form" position="attributes">
                <attribute name="js_class">pos_order_barcode_form</attribute>
                <attribute name="disable_autofocus">1</attribute>
            </xpath>

            <!-- Ocultar el botón original de Invoice en el header -->
            <xpath expr="//header/button[@name='action_pos_order_invoice']" position="replace">
                <button
                    name="action_print_factura_simplificada"
                    type="object"
                    string="Factura simplificada 80mm"
                    class="btn-primary"
                    invisible="state == 'draft'"
                />
                <button
                    name="action_send_email"
                    type="object"
                    string="Envío por correo electrónico"
                    class="btn-primary"
                    invisible="state == 'draft'"
                />

            </xpath>
        </field>
    </record>

    <!-- Añadir un bloque de totales a la derecha del bloque de cliente/pedido y quitar los bloques
    originales -->
    <record id="view_pos_order_form_inherit_totals" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.totals</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form" />
        <field name="arch" type="xml">
            <!-- Reemplazar el grupo de campos del pedido por dos columnas: izquierda con campos y
            derecha con totales -->
            <xpath expr="//group[@name='order_fields']" position="replace">
                <!-- Campo auxiliar para detectar si está vinculado a sale.order -->
                <field name="is_linked_to_sale" invisible="1" />

                <!-- Panel especial cuando está vinculado a un sale.order -->
                <div class="alert alert-info" role="alert" invisible="not is_linked_to_sale">
                    <h4 class="alert-heading">
                        <i class="fa fa-link me-2" />Pedido vinculado a venta tradicional </h4>
                    <p>Este pedido POS está vinculado a un pedido de venta tradicional.
                        La gestión del stock y facturación se realiza desde el pedido de venta
                        asociado.
                    </p>
                    <hr />
                    <div class="mb-0">
                        <label for="linked_sale_order_id" class="fw-bold">Pedido de venta:</label>
                        <field name="linked_sale_order_id" widget="many2one"
                            options="{'no_create': True, 'no_open': False}"
                            class="ms-2" />
                    </div>
                </div>

                <!-- Título principal como en Ventas -->
                <div class="oe_title" invisible="is_linked_to_sale">
                    <h1>
                        <field name="name" readonly="1" invisible="name == '/'" />
                        <span invisible="name != '/'">Nuevo</span>
                    </h1>
                </div>

                <!-- Estructura Híbrida: Cliente "Gigante" + Resto estándar -->
                <div class="row mb-3" invisible="is_linked_to_sale">
                    <div class="col-7 pe-4">
                        <!-- Campo de cliente Gigante (Mantenido) -->
                        <div class="mb-4 mt-2">
                            <label for="partner_id" class="fw-bold fs-2 d-block mb-1 text-dark">
                                Cliente</label>
                            <field name="partner_id"
                                widget="res_partner_many2one"
                                nolabel="1"
                                class="w-100 fs-4 text-dark"
                                context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                                placeholder="Escriba para buscar un cliente..."
                                readonly="state != 'draft'" />
                        </div>

                        <!-- Restauración de otros campos a grupo estándar -->
                        <group col="2" name="order_fields" class="mt-2">
                            <field name="source" readonly="True" />
                            <field name="date_order" readonly="state != 'draft'" />
                            <field string="Usuario" name="user_id" readonly="1" />
                            <field name="session_id" readonly="state != 'draft'" invisible="1" />
                            <field name="show_albaran_button" invisible="1" />
                            <field name="order_edit_tracking" invisible="1" />
                            <field name="is_edited" readonly="1" invisible="not order_edit_tracking" />
                            <field name="fiscal_position_id" options="{'no_create': True}"
                                readonly="state != 'draft'"
                                invisible="1" />
                        </group>
                        <field name="has_order_lines" invisible="1" />
                    </div>

                    <!-- Columna Derecha: Totales Sencillos (Restaurados) -->
                    <div class="col-5 ps-4 pt-2">
                        <group col="1" name="order_totals_sidebar" class="oe_subtotal_sidebar">
                            <div class="row">
                                <div class="col-6 py-2 text-muted">Importe base:</div>
                                <div class="col-6 py-2 text-end fw-bold text-nowrap">
                                    <field name="amount_untaxed" widget="monetary" nolabel="1" />
                                </div>
                                <div class="col-6 py-2 text-muted text-nowrap">Impuestos:</div>
                                <div class="col-6 py-2 text-end fw-bold text-nowrap">
                                    <field name="amount_tax" force_save="1" widget="monetary"
                                        nolabel="1" />
                                </div>
                                <div class="col-6 py-2 fs-2 fw-bold text-dark text-nowrap">Total:</div>
                                <div class="col-6 py-2 text-end fs-2 fw-bold text-dark text-nowrap">
                                    <field name="amount_total" force_save="1" widget="monetary"
                                        nolabel="1" />
                                </div>
                                <div class="col-6 py-2 text-muted border-top pt-3"
                                    invisible="state == 'draft'">Total pagado:</div>
                                <div class="col-6 py-2 text-end fw-bold border-top pt-3 text-nowrap"
                                    invisible="state == 'draft'">
                                    <field name="amount_paid" nolabel="1" widget="monetary"
                                        readonly="state != 'draft'" />
                                </div>
                            </div>
                        </group>
                        <field name="currency_id" invisible="1" />
                    </div>
                </div>
            </xpath>

            <!-- Eliminar totales originales de la página Products -->
            <xpath expr="//page[@name='products']/group[@name='order_total']" position="replace" />

            <!-- Eliminar totales originales de la página Payments -->
            <xpath expr="//page[@name='payments']/group[@name='order_total']" position="replace" />

        </field>
    </record>

    <!-- Sustituir el botón de Payment por dos botones: Pagar en efectivo y Pagar con tarjeta -->
    <record id="view_pos_order_form_inherit_payment_buttons" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.payment.buttons</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form" />
        <field name="arch" type="xml">
            <!-- Eliminar el botón original de Payment -->
            <xpath expr="//header/button[1]" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="class">me-2</attribute>
            </xpath>
            <xpath expr="//header/button[1]" position="after">
                <button name="action_open_payment_popup"
                    string="Pago"
                    type="object"
                    class="btn-primary"
                    invisible="state != 'draft' or not has_order_lines or is_linked_to_sale" />

                <button name="action_pay_cash" string="Pagar en efectivo" type="object"
                    class="btn-secondary"
                    invisible="state != 'draft' or not has_order_lines or is_linked_to_sale" />
                <button name="action_pay_card" string="Pagar con tarjeta" type="object"
                    class="btn-secondary ms-2"
                    invisible="state != 'draft' or not has_order_lines or is_linked_to_sale" />
                <button name="action_pay_account"
                    string="Crear albarán"
                    type="object"
                    class="btn-secondary ms-2"
                    invisible="not show_albaran_button or state != 'draft' or not has_order_lines or is_linked_to_sale" />
            </xpath>

        </field>
    </record>

    <!-- Hacer readonly las líneas de productos cuando el pedido está vinculado a sale.order -->
    <record id="view_pos_order_form_inherit_readonly_linked" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.readonly.linked</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form" />
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Hacer readonly la página de productos cuando está vinculado -->
            <xpath expr="//page[@name='products']//field[@name='lines']" position="attributes">
                <attribute name="readonly">state != 'draft' or is_linked_to_sale</attribute>
            </xpath>

            <!-- Hacer readonly la página de pagos cuando está vinculado -->
            <xpath expr="//page[@name='payments']//field[@name='payment_ids']" position="attributes">
                <attribute name="readonly">state != 'draft' or is_linked_to_sale</attribute>
            </xpath>

            <!-- Ocultar las páginas de productos y pagos cuando está vinculado (opcional, para más
            limpieza) -->
            <xpath expr="//page[@name='products']" position="attributes">
                <attribute name="invisible">is_linked_to_sale</attribute>
            </xpath>
            <xpath expr="//page[@name='payments']" position="attributes">
                <attribute name="invisible">is_linked_to_sale</attribute>
            </xpath>
            <!-- Ocultar información adicional y nota de cliente cuando está vinculado -->
            <xpath expr="//page[@name='extra']" position="attributes">
                <attribute name="invisible">is_linked_to_sale</attribute>
            </xpath>
            <xpath expr="//page[@name='notes']" position="attributes">
                <attribute name="invisible">is_linked_to_sale</attribute>
            </xpath>

            <!-- Ocultar el statusbar (campo de estado) cuando está vinculado -->
            <xpath expr="//header/field[@name='state'][1]" position="attributes">
                <attribute name="invisible">state == 'cancel' or is_linked_to_sale</attribute>
            </xpath>
            <xpath expr="//header/field[@name='state'][2]" position="attributes">
                <attribute name="invisible">state != 'cancel' or is_linked_to_sale</attribute>
            </xpath>
        </field>
    </record>
</odoo>
