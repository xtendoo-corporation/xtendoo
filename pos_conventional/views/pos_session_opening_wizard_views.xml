<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_session_opening_wizard_form" model="ir.ui.view">
        <field name="name">pos.session.opening.wizard.form</field>
        <field name="model">pos.session.opening.wizard</field>
        <field name="arch" type="xml">
            <form string="Control de apertura" class="o_pos_conventional_wizard">
                <field name="session_id" invisible="1" />
                <field name="user_id" invisible="1" />
                <field name="currency_id" invisible="1" />
                <field name="cash_control" invisible="1" />

                <sheet>
                    <group>
                        <label for="cash_register_balance_start" string="Caja de apertura"
                            invisible="not cash_control" />
                        <div class="o_row" invisible="not cash_control">
                            <field name="cash_register_balance_start"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                                nolabel="1" />
                            <button name="action_open_cash_calculator"
                                type="object"
                                icon="fa-calculator"
                                class="btn-link"
                                title="Calculadora" />
                        </div>
                        <field name="opening_notes" placeholder="Añadir una nota de apertura..." />
                    </group>
                </sheet>

                <footer>
                    <button name="action_validate_and_open"
                        string="Abrir caja registradora"
                        type="object"
                        class="btn-primary btn-lg" />
                    <button string="Descartar"
                        class="btn-secondary btn-lg"
                        special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>