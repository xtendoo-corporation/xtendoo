<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_session_opening_wizard_form" model="ir.ui.view">
        <field name="name">pos.session.opening.wizard.form</field>
        <field name="model">pos.session.opening.wizard</field>
        <field name="arch" type="xml">
            <form string="Control de apertura">
                <field name="session_id" invisible="1" />
                <field name="user_id" invisible="1" />
                <field name="currency_id" invisible="1" />
                <field name="cash_control" invisible="1" />
                <field name="pending_order_count" invisible="1" />

                <sheet>
                    <!-- Estado de pedidos (Orders status) -->
                    <div class="mb-3" invisible="pending_order_count == 0">
                        <div class="mb-2">Estado de los pedidos</div>
                        <div class="alert alert-info mb-0" role="alert">
                            <span>Aún tiene </span>
                            <field name="pending_order_count" widget="integer" nolabel="1" readonly="1" class="d-inline fw-bold"/>
                            <span> pedidos abiertos para los próximos días.</span>
                        </div>
                    </div>

                    <!-- Caja de apertura (Opening cash) -->
                    <div class="mb-3" invisible="not cash_control">
                        <label for="cash_register_balance_start" string="Caja de apertura"/>
                        <div style="max-width: 250px;">
                            <field name="cash_register_balance_start"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                                nolabel="1"
                                placeholder="0,00" />
                        </div>
                    </div>

                    <!-- Nota de apertura (Opening note) -->
                    <div class="mb-0">
                        <label for="opening_notes" string="Nota de apertura"/>
                        <field name="opening_notes"
                            widget="text"
                            nolabel="1"
                            placeholder="Añadir una nota de apertura..." />
                    </div>
                </sheet>

                <footer>
                    <button name="action_validate_and_open"
                        string="Abrir caja registradora"
                        type="object"
                        class="btn btn-primary" />
                    <button string="Descartar"
                        class="btn btn-secondary"
                        special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
