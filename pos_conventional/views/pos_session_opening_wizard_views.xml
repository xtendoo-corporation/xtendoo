<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_session_opening_wizard_form" model="ir.ui.view">
        <field name="name">pos.session.opening.wizard.form</field>
        <field name="model">pos.session.opening.wizard</field>
        <field name="arch" type="xml">
            <form string="Apertura de Sesión POS - Modo no táctil">
                <sheet>
                    <div class="alert alert-info mb-3" role="alert">
                        <p class="mb-0">
                            <strong>Apertura de sesión en modo no táctil</strong><br/>
                            Por favor, ingrese el dinero inicial para abrir la sesión.
                        </p>
                    </div>
                    <group>
                        <group>
                            <field name="session_id" invisible="1"/>
                            <field name="user_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="cash_control" invisible="1"/>
                        </group>
                    </group>
                    <field name="cash_register_balance_start"
                           invisible="not cash_control"
                           widget="monetary"
                           options="{'currency_field': 'currency_id'}"
                           class="w-100"/>
                    <div class="alert alert-warning" role="alert" invisible="not cash_control">
                        <p class="mb-0">Por favor, cuente e ingrese el dinero inicial en la caja registradora.</p>
                    </div>
                </sheet>
                <footer>
                    <button name="action_validate_and_open"
                            string="Abrir Sesión"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
