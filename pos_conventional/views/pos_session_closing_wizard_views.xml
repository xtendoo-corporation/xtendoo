<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_session_closing_wizard_form" model="ir.ui.view">
        <field name="name">pos.session.closing.wizard.form</field>
        <field name="model">pos.session.closing.wizard</field>
        <field name="arch" type="xml">
            <form string="Control de cierre">
                <field name="state" invisible="1" />
                <field name="currency_id" invisible="1" />
                <field name="cash_control" invisible="1" />
                <field name="cash_payments" invisible="1" />
                <field name="card_payments" invisible="1" />
                <field name="other_payments" invisible="1" />
                <field name="linked_sale_orders_count" invisible="1" />
                <field name="linked_sale_orders_total" invisible="1" />

                <!-- Input State -->
                <group invisible="state != 'input'">
                    <group string="Detalles de sesión" invisible="not cash_control">
                        <label for="cash_register_balance_end" string="Esperado"/>
                        <div>
                            <field name="cash_register_balance_end"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                                nolabel="1"
                                readonly="1"/>
                            <div class="text-muted small">
                                Apertura: <field name="cash_register_balance_start"
                                    widget="monetary"
                                    nolabel="1"
                                    readonly="1"/>
                                + Pagos: <field name="total_payments"
                                    widget="monetary"
                                    nolabel="1"
                                    readonly="1"/>
                                <span invisible="cash_in_out_total == 0">
                                    + Entrada/Salida: <field name="cash_in_out_total"
                                        widget="monetary"
                                        nolabel="1"
                                        readonly="1"/>
                                </span>
                            </div>
                        </div>

                        <field name="cash_register_balance_end_real"
                            string="Contado"
                            widget="monetary"
                            options="{'currency_field': 'currency_id'}"
                            placeholder="0,00"/>

                        <label for="cash_register_difference"
                            string="Diferencia"
                            class="fw-bold"
                            invisible="cash_register_difference == 0"/>
                        <div invisible="cash_register_difference == 0">
                            <field name="cash_register_difference"
                                widget="monetary"
                                nolabel="1"
                                readonly="1"
                                class="text-danger fw-bold"/>
                        </div>
                    </group>

                    <group invisible="cash_control">
                        <div colspan="2" class="alert alert-info">
                            Esta caja registradora no requiere control de efectivo.
                        </div>
                    </group>

                    <field name="closing_note"
                        string="Nota de cierre"
                        colspan="2"
                        placeholder="Razón de cierre (opcional)..."/>
                </group>

                <!-- Confirmation State -->
                <div invisible="state != 'confirmation'" class="alert alert-warning text-center">
                    <h4>Diferencia de pago</h4>
                    <p class="mb-0">
                        El efectivo contado no coincide con la cantidad esperada.<br/>
                        ¿Deseas registrar esta diferencia en las cuentas?
                    </p>
                </div>

                <footer>
                    <!-- Input buttons -->
                    <button name="action_close_session"
                        string="Cerrar caja"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'input'"
                        data-hotkey="q"/>

                    <!-- Confirmation buttons -->
                    <button name="action_close_session"
                        string="Continuar de todos modos"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'confirmation'"
                        data-hotkey="q"/>

                    <button name="action_open_cash_calculator"
                        string="💰 Calculadora de efectivo"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'input' or not cash_control"
                        data-hotkey="c"/>

                    <button string="Cancelar"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
