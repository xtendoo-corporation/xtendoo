<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_session_closing_wizard_form" model="ir.ui.view">
        <field name="name">pos.session.closing.wizard.form</field>
        <field name="model">pos.session.closing.wizard</field>
        <field name="arch" type="xml">
            <form string="Cerrando la caja registradora" class="o_pos_conventional_wizard">
                <field name="state" invisible="1" />
                <field name="currency_id" invisible="1" />
                <field name="cash_control" invisible="1" />
                <field name="cash_payments" invisible="1" />
                <field name="card_payments" invisible="1" />
                <field name="other_payments" invisible="1" />
                <field name="linked_sale_orders_count" invisible="1" />
                <field name="linked_sale_orders_total" invisible="1" />

                <sheet>
                    <div class="alert alert-warning text-center" invisible="state != 'confirmation'"
                        role="alert">
                        <div class="fw-bold"><i class="fa fa-exclamation-triangle" /> Diferencia
                            Detectada</div>
                        <div>El dinero contado no coincide con el esperado. ¿Desea registrar esta
                            diferencia y continuar?</div>
                    </div>

                    <!-- Layout limpio por secciones -->
                    <div invisible="state != 'input'">

                        <!-- Sección Efectivo -->
                        <div class="mb-3" invisible="not cash_control">
                            <h5 class="border-bottom pb-1 mb-2">Efectivo</h5>

                            <div class="row ps-2">
                                <div class="col-8 text-muted">Apertura</div>
                                <div class="col-4 text-end">
                                    <field name="cash_register_balance_start" widget="monetary"
                                        nolabel="1" />
                                </div>
                            </div>

                            <div class="row ps-2">
                                <div class="col-8 text-muted">Pagos</div>
                                <div class="col-4 text-end">
                                    <field name="cash_payments" widget="monetary" nolabel="1" />
                                </div>
                            </div>

                            <div class="row ps-2">
                                <div class="col-8 text-muted">Variables (Entrada/Salida)</div>
                                <div class="col-4 text-end">
                                    <field name="cash_in_out_total" widget="monetary" nolabel="1" />
                                </div>
                            </div>

                            <!-- Recuento y Diferencia -->
                            <div class="mt-2 pt-2 border-top">
                                <div class="row align-items-center mb-1">
                                    <div class="col-6 fw-bold">Dinero contado</div>
                                    <div class="col-6">
                                        <div class="o_row d-flex justify-content-end">
                                            <field name="cash_register_balance_end_real"
                                                widget="monetary"
                                                options="{'currency_field': 'currency_id'}"
                                                nolabel="1"
                                                class="text-end" />
                                            <button name="action_open_cash_calculator"
                                                type="object"
                                                icon="fa-calculator"
                                                class="btn-link ps-2"
                                                title="Calculadora" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row" invisible="cash_register_difference == 0">
                                    <div class="col-8 text-danger"
                                        invisible="cash_register_difference &gt;= 0">Diferencia</div>
                                    <div class="col-8 text-success"
                                        invisible="cash_register_difference &lt; 0">Diferencia</div>
                                    <div class="col-4 text-end">
                                        <field name="cash_register_difference" widget="monetary"
                                            nolabel="1"
                                            decoration-danger="cash_register_difference &lt; 0"
                                            decoration-success="cash_register_difference &gt; 0" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sección Tarjeta -->
                        <div class="mb-3" invisible="card_payments == 0">
                            <h5 class="border-bottom pb-1 mb-2">Tarjeta</h5>
                            <div class="row ps-2">
                                <div class="col-8 text-muted">Pagos</div>
                                <div class="col-4 text-end">
                                    <field name="card_payments" widget="monetary" nolabel="1" />
                                </div>
                            </div>
                        </div>

                        <!-- Sección Otros -->
                        <div class="mb-3" invisible="other_payments == 0">
                            <h5 class="border-bottom pb-1 mb-2">Otros</h5>
                            <div class="row ps-2">
                                <div class="col-8 text-muted">Pagos</div>
                                <div class="col-4 text-end">
                                    <field name="other_payments" widget="monetary" nolabel="1" />
                                </div>
                            </div>
                        </div>

                        <!-- Sección Cuenta Cliente -->
                        <div class="mb-3" invisible="linked_sale_orders_count == 0">
                            <h5 class="border-bottom pb-1 mb-2">Cuenta de cliente</h5>
                            <div class="row ps-2">
                                <div class="col-8 text-muted">Pedidos</div>
                                <div class="col-4 text-end">
                                    <field name="linked_sale_orders_total" widget="monetary"
                                        nolabel="1" />
                                </div>
                            </div>
                        </div>

                        <!-- Nota -->
                        <div class="mt-4">
                            <field name="closing_note" placeholder="Añadir una nota de cierre..." />
                        </div>

                    </div>
                </sheet>

                <footer>
                    <!-- Boton Principal -->
                    <button name="action_close_session"
                        string="Cerrar caja registradora"
                        type="object"
                        class="btn-primary btn-lg" />

                    <!-- Descartar -->
                    <button string="Descartar" class="btn-secondary btn-lg" special="cancel" />

                    <!-- Botones Secundarios -->
                    <div class="float-end">
                        <button name="action_open_cash_move_wizard"
                            string="Entrada/salida de efectivo"
                            type="object"
                            class="btn-secondary btn-lg me-1"
                            invisible="state != 'input'" />

                        <button name="action_print_daily_report"
                            string="Venta diaria"
                            type="object"
                            class="btn-secondary btn-lg"
                            invisible="state != 'input'" />
                    </div>
                </footer>
            </form>
        </field>
    </record>
</odoo>