<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_session_closing_wizard_form" model="ir.ui.view">
        <field name="name">pos.session.closing.wizard.form</field>
        <field name="model">pos.session.closing.wizard</field>
        <field name="arch" type="xml">
            <form string="Cerrando la caja registradora" class="o_pos_session_closing_wizard">
                <field name="state" invisible="1" />
                <field name="currency_id" invisible="1" />
                <field name="cash_control" invisible="1" />
                <field name="linked_sale_orders_count" invisible="1" />
                <field name="linked_sale_orders_total" invisible="1" />
                <field name="total_payments" invisible="1" />
                <field name="cash_in_out_total" invisible="1" />
                <field name="cash_register_balance_start" invisible="1" />
                <field name="cash_register_balance_end" invisible="1" />
                <field name="cash_register_difference" invisible="1" />
                <field name="session_name" invisible="1" />

                <!-- Título sin fondo: div simple, sin <header>, con nombre de sesión -->
                <div class="d-flex align-items-baseline gap-2 border-bottom pb-2 mb-3">
                    <h4 class="mb-0">Cerrando la caja registradora</h4>
                    <field name="session_name" class="text-muted fs-6" readonly="1" nolabel="1"/>
                </div>

                <!-- Input State -->
                <div invisible="state != 'input'">
                    <!-- Sección Efectivo -->
                    <div class="o_payment_method_section" invisible="not cash_control">
                        <div class="o_payment_method_line">
                            <div class="o_label">Pagos Totales</div>
                            <div class="o_value">
                                <field name="cash_register_balance_end"
                                    widget="monetary"
                                    options="{'currency_field': 'currency_id'}"
                                    nolabel="1"
                                    readonly="1"/>
                            </div>
                        </div>

                        <!-- Desglose de efectivo -->
                        <div class="o_cash_breakdown">
                            <div class="o_cash_breakdown_line">
                                <span class="o_label">Apertura:</span>
                                <field name="cash_register_balance_start"
                                    widget="monetary"
                                    nolabel="1"
                                    readonly="1"
                                    class="o_value"/>
                            </div>
                            <div class="o_cash_breakdown_line">
                                <span class="o_label">+ Pagos:</span>
                                <field name="total_payments"
                                    widget="monetary"
                                    nolabel="1"
                                    readonly="1"
                                    class="o_value"/>
                            </div>
                            <div class="o_cash_breakdown_line" invisible="cash_in_out_total == 0">
                                <span class="o_label">+ Entrada/Salida:</span>
                                <field name="cash_in_out_total"
                                    widget="monetary"
                                    nolabel="1"
                                    readonly="1"
                                    class="o_value"/>
                            </div>

                            <!-- Entrada y salida de efectivo (desplegable) -->
                            <details class="o_cash_moves_details" invisible="cash_in_out_total == 0">
                                <summary class="o_cash_moves_summary">Entrada y salida de efectivo</summary>
                                <div class="o_cash_moves_list">
                                    <field name="cash_in_out_line_ids" nolabel="1" readonly="1" class="o_non_clickable_list">
                                        <list create="0" edit="0" delete="0" open="0" decoration-muted="True">
                                            <field name="date"/>
                                            <field name="payment_ref" string="Referencia"/>
                                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        </list>
                                    </field>
                                </div>
                            </details>
                        </div>

                        <!-- Diferencia -->
                        <div class="o_closing_difference_line" invisible="cash_register_difference == 0">
                            <span class="o_label">Diferencia</span>
                            <div class="o_value text-danger" invisible="cash_register_difference &gt;= 0">
                                <field name="cash_register_difference"
                                    widget="monetary"
                                    nolabel="1"
                                    readonly="1"/>
                            </div>
                            <div class="o_value text-success" invisible="cash_register_difference &lt; 0">
                                <field name="cash_register_difference"
                                    widget="monetary"
                                    nolabel="1"
                                    readonly="1"/>
                            </div>
                        </div>
                    </div>

                    <!-- Secciones dinámicas de métodos de pago (no efectivo) -->
                    <group string="Métodos de pago" invisible="not payment_method_line_ids">
                        <field name="payment_method_line_ids" nolabel="1">
                            <list editable="bottom" create="0" delete="0" decoration-danger="difference &lt; 0" decoration-success="difference &gt; 0">
                                <field name="payment_method_name" string="Método de pago" readonly="1"/>
                                <field name="amount_expected" widget="monetary" string="Esperado" readonly="1"/>
                                <field name="amount_counted" widget="monetary" string="Contado"/>
                                <field name="difference" widget="monetary" string="Diferencia" readonly="1"/>
                                <field name="is_cash" column_invisible="1"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list>
                        </field>
                    </group>

                    <!-- Info sin control de efectivo -->
                    <div class="o_pos_no_cash_control_info" invisible="cash_control">
                        Esta caja registradora no requiere control de efectivo.
                    </div>

                    <!-- Nota de cierre -->
                    <div class="o_closing_note_section">
                         <span>Nota de cierre</span>
                        <field name="closing_note"
                            string="Razón de cierre (opcional)"
                            placeholder="Razón de cierre (opcional)..."/>
                    </div>
                </div>

                <!-- Confirmation State -->
                <div invisible="state != 'confirmation'" class="o_pos_closing_confirmation">
                    <h4>Diferencia de pago</h4>
                    <p>
                        El efectivo contado no coincide con la cantidad esperada.<br/>
                        ¿Deseas registrar esta diferencia en las cuentas?
                    </p>
                </div>

                <footer>
                    <!-- Input buttons -->
                    <button name="action_close_session"
                        string="Cerrar caja"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'input'"
                        data-hotkey="q"/>

                    <!-- Confirmation buttons -->
                    <button name="action_close_session"
                        string="Continuar de todos modos"
                        type="object"
                        class="button confirm btn btn-lg lh-lg btn-primary"
                        invisible="state != 'confirmation'"
                        data-hotkey="q"/>

                    <button name="action_open_cash_move_wizard"
                        string="Entrada/Salida de efectivo"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'input'"
                        data-hotkey="c"/>

                    <button string="Cancelar"
                        class="button cancel btn btn-lg lh-lg btn-secondary"
                        special="cancel"
                        data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
