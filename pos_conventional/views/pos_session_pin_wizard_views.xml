<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_session_pin_wizard_form" model="ir.ui.view">
        <field name="name">pos.session.pin.wizard.form</field>
        <field name="model">pos.session.pin.wizard</field>
        <field name="arch" type="xml">
            <form string="Introduzca su PIN" class="o_pos_conventional_wizard">
                <field name="session_id" invisible="1" />
                <field name="user_id" invisible="1" />

                <sheet>
                    <group>
                        <field name="employee_pin" password="True" string="PIN del Empleado" />
                    </group>
                </sheet>

                <footer>
                    <button name="action_validate_pin" string="Validar PIN" type="object"
                        class="btn-primary btn-lg" />
                    <button string="Cancelar" class="btn-secondary btn-lg" special="cancel"
                        invisible="context.get('no_cancel')" />
                </footer>
            </form>
        </field>
    </record>
</odoo>