<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_session_pin_wizard_form" model="ir.ui.view">
        <field name="name">pos.session.pin.wizard.form</field>
        <field name="model">pos.session.pin.wizard</field>
        <field name="arch" type="xml">
            <form string="Validar PIN" class="o_pos_wizard_base o_pos_pin_wizard">
                <field name="session_id" invisible="1" />
                <field name="user_id" invisible="1" />

                <sheet>
                    <!-- Header -->
                    <div class="o_pos_wizard_header">
                        <div class="o_wizard_icon">
                            <i class="fa fa-lock" />
                        </div>
                        <h2 class="o_wizard_title">Validación de PIN</h2>
                        <p class="o_wizard_subtitle">Ingrese su PIN para continuar con la apertura
                            de sesión</p>
                    </div>

                    <!-- Content -->
                    <div class="o_pos_wizard_content">
                        <div class="o_pin_input_container">
                            <field name="employee_pin" password="True" placeholder="••••"
                                nolabel="1" />
                        </div>
                    </div>
                </sheet>

                <footer>
                    <button name="action_validate_pin" string="Validar PIN" type="object"
                        class="btn-primary" />
                    <button string="Cancelar" class="btn-secondary" special="cancel"
                        invisible="context.get('no_cancel')" />
                </footer>
            </form>
        </field>
    </record>
</odoo>