<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_make_payment_wizard_form" model="ir.ui.view">
        <field name="name">pos.make.payment.wizard.form</field>
        <field name="model">pos.make.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Realizar Pago">
                <sheet>
                    <field name="order_id" invisible="1"/>
                    <field name="config_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="available_payment_method_ids" invisible="1"/>

                    <div class="o_horizontal_separator text-uppercase fw-bolder mb-3">Registrar Pago</div>
                    
                    <group>
                        <group>
                            <field name="is_cash_payment" invisible="1"/>
                            <field name="payment_method_id" 
                                   options="{'no_create': True, 'no_open': True}" 
                                   required="1"/>
                            <label for="amount_tendered"/>
                            <div class="o_row">
                                <field name="amount_tendered" class="oe_inline"/>
                                <button name="action_add_payment" type="object" string="Añadir" class="btn-primary"/>
                            </div>
                            <field name="amount_change" invisible="not is_cash_payment" class="text-danger fw-bold"/>
                        </group>
                        <group class="text-end">
                            <div class="o_td_label">
                                <label for="amount_due" string="TOTAL A PAGAR" class="fw-bold"/>
                            </div>
                            <field name="amount_due" widget="monetary" options="{'currency_field': 'currency_id'}" nolabel="1" class="oe_subtotal_footer_separator"/>
                            
                            <field name="amount_paid" widget="monetary" options="{'currency_field': 'currency_id'}" string="Pagado"/>
                        </group>
                    </group>

                    <div class="o_horizontal_separator text-uppercase fw-bolder mt-4 mb-3">Pagos registrados</div>
                    
                    <field name="payment_ids" nolabel="1" mode="list">
                        <list create="0" delete="1">
                            <field name="payment_method_id"/>
                            <field name="amount" sum="Total"/>
                            <button name="unlink" type="object" icon="fa-trash" class="text-danger" title="Eliminar"/>
                        </list>
                    </field>
                    
                    <div class="text-center text-muted p-3 italic" invisible="payment_ids">
                        Aún no hay pagos registrados para este pedido.
                    </div>
                </sheet>
                <footer>
                    <button name="action_validate" type="object" 
                            string="VALIDAR" 
                            class="btn-primary" 
                            icon="fa-check"
                            invisible="amount_due &gt; 0.01"/>
                    <button string="Descartar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Nuevo Asistente para Cobro en Efectivo (Grande) -->
    <record id="view_pos_make_payment_wizard_cash_form" model="ir.ui.view">
        <field name="name">pos.make.payment.wizard.cash.form</field>
        <field name="model">pos.make.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Cobro en Efectivo" class="o_pos_cash_wizard">
                <sheet>
                    <field name="is_cash_payment" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="order_id" invisible="1"/>
                    <field name="payment_method_id" invisible="1"/>

                    <div class="container-fluid">
                        <div class="row text-center mb-4">
                            <div class="col-12">
                                <span class="text-uppercase fw-bold text-muted h4">Total a Pagar</span>
                                <div class="display-3 fw-bolder text-dark">
                                    <field name="amount_due" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                        </div>

                        <div class="row text-center mb-4 p-4 border rounded bg-light shadow-sm">
                            <div class="col-12 text-center" style="min-height: 160px;">
                                <label for="amount_tendered" string="IMPORTE ENTREGADO" class="fw-bolder h2 text-muted mb-3 d-block"/>
                                <table style="margin: 0 auto; border-collapse: collapse;">
                                    <tr>
                                        <td style="vertical-align: middle; text-align: right;">
                                            <field name="amount_tendered" 
                                                   widget="float"
                                                   nolabel="1"
                                                   placeholder="0.00"
                                                   default_focus="1"
                                                   style="font-size: 8rem !important; font-weight: 900 !important; color: #212529 !important; border: none !important; background: transparent !important; text-align: right !important; width: 350px !important; margin: 0 !important; padding: 0 !important;"/>
                                        </td>
                                        <td style="vertical-align: middle; padding-left: 20px; text-align: left;">
                                            <span style="font-size: 6rem !important; font-weight: 900 !important; color: #212529 !important; display: block; line-height: 1;">€</span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="row text-center mt-4" invisible="not is_cash_payment">
                            <div class="col-12 p-3 rounded bg-light border">
                                <span class="text-uppercase fw-bold text-muted h2 d-block mb-2">Cambio a Devolver</span>
                                <div class="display-2 fw-bolder text-dark">
                                    <field name="amount_change" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
                <footer class="justify-content-center border-0 pb-4">
                    <button name="action_validate" type="object" 
                            string="VALIDAR Y FINALIZAR" 
                            class="btn-primary btn-lg px-5 py-3 fw-bold h3" 
                            icon="fa-check-circle"/>
                    <button string="Cancelar" special="cancel" class="btn-link text-muted btn-lg"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- La Acción para este Wizard -->
    <record id="action_pos_make_payment_wizard" model="ir.actions.act_window">
        <field name="name">Realizar Pago</field>
        <field name="res_model">pos.make.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pos_make_payment_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
