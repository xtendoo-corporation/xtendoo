<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.conventional</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Ubicar el checkbox junto al campo de "Modo Restaurante" -->
            <xpath expr="//setting[@id='is_restaurant']" position="after">
                <setting id="pos_non_touch_setting" string="POS no táctil" help="Activa un modo de punto de venta optimizado para equipos sin pantalla táctil.">
                    <field name="pos_non_touch"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>

