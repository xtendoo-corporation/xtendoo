<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_form_inherit" model="ir.ui.view">
        <field name="name">pos.make.payment.form.inherit</field>
        <field name="model">pos.make.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment"/>
        <field name="arch" type="xml">
            <!-- Agregar campos invisibles para cálculos -->
            <xpath expr="//field[@name='config_id']" position="after">
                <field name="is_cash_payment" invisible="1"/>
            </xpath>

            <!-- Agregar el campo de importe recibido después del campo amount -->
            <xpath expr="//field[@name='amount']" position="after">
                <field name="amount_received"
                       invisible="not is_cash_payment"
                       required="is_cash_payment"/>
                <field name="amount_change"
                       invisible="not is_cash_payment"
                       readonly="1"
                       class="fw-bold"/>
            </xpath>
        </field>
    </record>
</odoo>

