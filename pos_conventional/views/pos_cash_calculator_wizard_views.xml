                                </div>
                                <div class="col-4 text-center p-1">
                                    <field name="qty_2" class="text-center o_input" nolabel="1"/>
                                </div>
                                <div class="col-1 text-center p-0">
                                    <button name="increment_2" type="object" class="btn btn-light btn-sm">+</button>
                                </div>
                                <div class="col-6">
                                    <span class="badge bg-light text-dark w-100 py-2" style="border: 1px solid #ddd;">2,00 €</span>
                                </div>
                            </div>
                        </div>

                        <!-- Columna derecha: Monedas pequeñas -->
                        <div class="col-6">
                            <!-- 1€ -->
                            <div class="row mb-2 align-items-center">
                                <div class="col-1 text-center p-0">
                                    <button name="decrement_1" type="object" class="btn btn-light btn-sm">−</button>
                                </div>
                                <div class="col-4 text-center p-1">
                                    <field name="qty_1" class="text-center o_input" nolabel="1"/>
                                </div>
                                <div class="col-1 text-center p-0">
                                    <button name="increment_1" type="object" class="btn btn-light btn-sm">+</button>
                                </div>
                                <div class="col-6">
                                    <span class="badge bg-light text-dark w-100 py-2" style="border: 1px solid #ddd;">1,00 €</span>
                                </div>
