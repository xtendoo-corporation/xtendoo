                            </div>

                            <!-- 0,20€ -->
                            <div class="row mb-2 align-items-center">
                                <div class="col-1 text-center p-0">
                                    <button name="decrement_020" type="object" class="btn btn-light btn-sm">−</button>
                                </div>
                                <div class="col-4 text-center p-1">
                                    <field name="qty_020" class="text-center o_input" nolabel="1"/>
                                </div>
                                <div class="col-1 text-center p-0">
                                    <button name="increment_020" type="object" class="btn btn-light btn-sm">+</button>
                                </div>
                                <div class="col-6">
                                    <span class="badge bg-light text-dark w-100 py-2" style="border: 1px solid #ddd;">0,20 €</span>
                                </div>
                            </div>

                            <!-- 0,10€ -->
                            <div class="row mb-2 align-items-center">
                                <div class="col-1 text-center p-0">
                                    <button name="decrement_010" type="object" class="btn btn-light btn-sm">−</button>
                                </div>
                                <div class="col-4 text-center p-1">
                                    <field name="qty_010" class="text-center o_input" nolabel="1"/>
                                </div>
                                <div class="col-1 text-center p-0">
                                    <button name="increment_010" type="object" class="btn btn-light btn-sm">+</button>
                                </div>
                                <div class="col-6">
                                    <span class="badge bg-light text-dark w-100 py-2" style="border: 1px solid #ddd;">0,10 €</span>
                                </div>
                            </div>

                            <!-- 0,05€ -->
                            <div class="row mb-2 align-items-center">
                                <div class="col-1 text-center p-0">
                                    <button name="decrement_005" type="object" class="btn btn-light btn-sm">−</button>
                                </div>
                                <div class="col-4 text-center p-1">
                                    <field name="qty_005" class="text-center o_input" nolabel="1"/>
                                </div>
                                <div class="col-1 text-center p-0">
                                    <button name="increment_005" type="object" class="btn btn-light btn-sm">+</button>
                                </div>
                                <div class="col-6">
                                    <span class="badge bg-light text-dark w-100 py-2" style="border: 1px solid #ddd;">0,05 €</span>
                                </div>
                            </div>

                            <!-- 0,02€ -->
                            <div class="row mb-2 align-items-center">
                                <div class="col-1 text-center p-0">
                                    <button name="decrement_002" type="object" class="btn btn-light btn-sm">−</button>
                                </div>
                                <div class="col-4 text-center p-1">
                                    <field name="qty_002" class="text-center o_input" nolabel="1"/>
                                </div>
                                <div class="col-1 text-center p-0">
                                    <button name="increment_002" type="object" class="btn btn-light btn-sm">+</button>
                                </div>
                                <div class="col-6">
                                    <span class="badge bg-light text-dark w-100 py-2" style="border: 1px solid #ddd;">0,02 €</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Total calculado -->
                    <div class="row border-top pt-3 mt-3">
                        <div class="col-12 text-end">
                            <h4>
                                <span class="text-muted">Total</span>
                                <field name="total" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       class="text-dark ms-2 fw-bold" nolabel="1" readonly="1"/>
                            </h4>
                        </div>
                    </div>
                </div>

                <footer>
                    <button name="action_confirm"
                            string="Confirmar"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

