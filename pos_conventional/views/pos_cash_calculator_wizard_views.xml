<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_cash_calculator_wizard_form" model="ir.ui.view">
        <field name="name">pos.cash.calculator.wizard.form</field>
        <field name="model">pos.cash.calculator.wizard</field>
        <field name="arch" type="xml">
            <form string="Monedas/billetes">
                <field name="currency_id" invisible="1"/>
                <field name="closing_wizard_id" invisible="1"/>

                <!-- Calculadora de efectivo con diseño moderno -->
                <div class="container-fluid p-3">
                    <div class="row">
                        <!-- Columna izquierda: Billetes y monedas grandes -->
                        <div class="col-6">
                            <!-- 200€ -->
                            <div class="row mb-2 align-items-center">
                                <div class="col-1 text-center p-0">
                                    <button name="decrement_200" type="object" class="btn btn-light btn-sm">−</button>
                                </div>
                                <div class="col-4 text-center p-1">
                                    <field name="qty_200" class="text-center o_input" nolabel="1"/>
                                </div>
                                <div class="col-1 text-center p-0">
                                    <button name="increment_200" type="object" class="btn btn-light btn-sm">+</button>
                                </div>
                                <div class="col-6">
                                    <span class="badge bg-light text-dark w-100 py-2" style="border: 1px solid #ddd;">200,00 €</span>
                                </div>
                            </div>

                            <!-- 100€ -->
                            <div class="row mb-2 align-items-center">
                                <div class="col-1 text-center p-0">
                                    <button name="decrement_100" type="object" class="btn btn-light btn-sm">−</button>
                                </div>
                                <div class="col-4 text-center p-1">
                                    <field name="qty_100" class="text-center o_input" nolabel="1"/>
                                </div>
                                <div class="col-1 text-center p-0">
                                    <button name="increment_100" type="object" class="btn btn-light btn-sm">+</button>
                                </div>
                                <div class="col-6">
                                    <span class="badge bg-light text-dark w-100 py-2" style="border: 1px solid #ddd;">100,00 €</span>
                                </div>
                            </div>

                            <!-- 50€ -->
                            <div class="row mb-2 align-items-center">
                                <div class="col-1 text-center p-0">
                                    <button name="decrement_50" type="object" class="btn btn-light btn-sm">−</button>
                                </div>
                                <div class="col-4 text-center p-1">
                                    <field name="qty_50" class="text-center o_input" nolabel="1"/>
                                </div>
                                <div class="col-1 text-center p-0">
                                    <button name="increment_50" type="object" class="btn btn-light btn-sm">+</button>
                                </div>
                                <div class="col-6">
                                    <span class="badge bg-light text-dark w-100 py-2" style="border: 1px solid #ddd;">50,00 €</span>
                                </div>
                            </div>

                            <!-- 20€ -->
                            <div class="row mb-2 align-items-center">
                                <div class="col-1 text-center p-0">
                                    <button name="decrement_20" type="object" class="btn btn-light btn-sm">−</button>
                                </div>
                                <div class="col-4 text-center p-1">
                                    <field name="qty_20" class="text-center o_input" nolabel="1"/>
                                </div>
                                <div class="col-1 text-center p-0">
                                    <button name="increment_20" type="object" class="btn btn-light btn-sm">+</button>
                                </div>
                                <div class="col-6">
