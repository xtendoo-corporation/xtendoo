<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Heredar la plantilla ListView para controlar los botones del panel de control -->
    <t t-name="pos_conventional.ListView" t-inherit="web.ListView" t-inherit-mode="extension">
        <!-- Reemplazar el botón "New" estándar para controlarlo con nuestro estado -->
        <xpath expr="//t[@t-set-slot='control-panel-create-button']/button[@class='btn btn-primary o_list_button_add']" position="attributes">
            <!-- Solo mostrar el botón Nuevo si estamos dentro de una caja no táctil -->
            <attribute name="t-if">(props.resModel !== 'pos.order') or (state and state.showCloseButton)</attribute>
        </xpath>

        <!-- Pasar las props de menú al CogMenu para que muestre nuestras acciones aunque no haya
        selección -->
        <xpath expr="//t[@t-set-slot='control-panel-additional-actions']/CogMenu" position="attributes">
            <attribute name="t-props">props.resModel === 'pos.order' ? actionMenuProps : undefined</attribute>
        </xpath>

        <!-- 
            En lugar de añadir botones físicos, ahora las acciones están en actionMenuItems del controlador.
            Removemos los botones antiguos que añadimos en la versión anterior si existieran (o simplemente no
        los añadimos aquí).
        -->
    </t>
</templates>