<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_whatsapp_automation" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.whatsapp.automation</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group[@name='sale']" position="inside">
                <field name="communication_manager_id" />
                <field name="communication_employee_id" />
            </xpath>
        </field>
    </record>
</odoo>