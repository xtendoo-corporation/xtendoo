<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="payment_form_cod" inherit_id="payment.form" name="Payment Form Contrareembolso">
        <xpath expr="//div[contains(@class,'o_payment_form')]" position="inside">
            <t t-if="provider == 'cod'">
                <div>
                    <p>Pago contra reembolso. Paga cuando recibas tu pedido.</p>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
