<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ai_connector" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ai.connector</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="AI Connector" name="xtendoo_ai_connector"
                     logo="/xtendoo_ai_connector/static/description/icon.png">
                    <block title="AI Provider Configuration">
                        <setting string="AI Provider"
                            help="Select the AI provider for all AI-powered modules.">
                            <field name="ai_provider"/>
                        </setting>
                        <setting string="AI Model"
                            help="Model identifier for the selected provider.">
                            <field name="ai_model"/>
                        </setting>
                        <setting string="AI API Key"
                            help="API key for the selected AI provider.">
                            <field name="ai_api_key" password="True"/>
                        </setting>
                        <setting>
                            <button
                                name="action_test_ai_connection"
                                string="Test AI Connection"
                                type="object"
                                class="btn-secondary"
                                icon="fa-plug"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
