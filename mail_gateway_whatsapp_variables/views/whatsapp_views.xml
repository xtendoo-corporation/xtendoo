<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de plantilla con variables y botones -->
    <record id="view_mail_whatsapp_template_form_variables_v2" model="ir.ui.view">
        <field name="name">mail.whatsapp.template.form.variables.v2</field>
        <field name="model">mail.whatsapp.template</field>
        <field name="inherit_id" ref="mail_gateway_whatsapp.view_mail_whatsapp_template_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- Agregar notebook con pestañas -->
            <xpath expr="//page[@name='body']" position="after">
                <page string="Model &amp; Variables" name="model_variables">
                    <group>
                        <group>
                            <field name="model_id" required="1"/>
                        </group>
                    </group>
                    <separator string="Variables"/>
                    <field name="variable_ids" widget="one2many">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="variable_index"/>
                            <field name="line_type"/>
                            <field name="field_type"/>
                            <field name="field_id" optional="show"/>
                            <field name="demo_value"/>
                        </list>
                        <form>
                            <group>
                                <field name="name"/>
                                <field name="variable_index"/>
                                <field name="line_type"/>
                                <field name="field_type"/>
                                <field name="template_model_id" invisible="1"/>
                                <field name="field_id"
                                    invisible="field_type != 'field'"
                                    required="field_type == 'field'"
                                    options="{'no_create': True, 'no_open': True}"/>
                                <field name="field_name"
                                    invisible="field_type != 'field'"
                                    readonly="1"/>
                                <field name="demo_value"/>
                                <field name="sequence"/>
                            </group>
                        </form>
                    </field>
                </page>
                <page string="Buttons" name="buttons">
                    <field name="button_ids" widget="one2many" context="{'default_sequence': 10}">
                        <list>
                            <field name="name"/>
                        </list>
                        <form>
                            <group>
                                <field name="name"/>
                                <field name="button_type"/>
                                <field name="call_number"/>
                                <field name="website_url"/>
                                <field name="url_type"/>
                                <field name="sequence"/>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

