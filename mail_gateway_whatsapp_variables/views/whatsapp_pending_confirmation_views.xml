<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario para confirmaciones pendientes -->
    <record id="view_whatsapp_pending_confirmation_form" model="ir.ui.view">
        <field name="name">whatsapp.pending.confirmation.form</field>
        <field name="model">whatsapp.pending.confirmation</field>
        <field name="arch" type="xml">
            <form string="Confirmación Pendiente">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="channel_id"/>
                            <field name="template_id"/>
                            <field name="confirmation_template_id"/>
                        </group>
                        <group>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="confirmation_type"/>
                            <field name="sent_date"/>
                            <field name="response_date"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                    <group string="Notas">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de árbol para confirmaciones pendientes -->
    <record id="view_whatsapp_pending_confirmation_tree" model="ir.ui.view">
        <field name="name">whatsapp.pending.confirmation.tree</field>
        <field name="model">whatsapp.pending.confirmation</field>
        <field name="arch" type="xml">
            <list string="Confirmaciones Pendientes" decoration-success="state=='confirmed'" decoration-danger="state=='expired'" decoration-warning="state=='waiting'">
                <field name="partner_id"/>
                <field name="template_id"/>
                <field name="confirmation_template_id"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="sent_date"/>
                <field name="response_date"/>
                <field name="expiry_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Vista de búsqueda -->
    <record id="view_whatsapp_pending_confirmation_search" model="ir.ui.view">
        <field name="name">whatsapp.pending.confirmation.search</field>
        <field name="model">whatsapp.pending.confirmation</field>
        <field name="arch" type="xml">
            <search string="Buscar Confirmaciones">
                <field name="partner_id"/>
                <field name="template_id"/>
                <field name="res_model"/>
                <filter string="Esperando" name="waiting" domain="[('state', '=', 'waiting')]"/>
                <filter string="Confirmadas" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Expiradas" name="expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Canceladas" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Hoy" name="today" domain="[('sent_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Cliente" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Plantilla" name="group_template" context="{'group_by': 'template_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_whatsapp_pending_confirmation" model="ir.actions.act_window">
        <field name="name">Confirmaciones WhatsApp</field>
        <field name="res_model">whatsapp.pending.confirmation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_waiting': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay confirmaciones pendientes
            </p>
            <p>
                Las confirmaciones pendientes se crean automáticamente cuando se envía una plantilla
                de WhatsApp que requiere confirmación.
            </p>
        </field>
    </record>

    <!-- Menú -->
    <menuitem
        id="menu_whatsapp_pending_confirmation"
        name="Confirmaciones WhatsApp"
        parent="mail.menu_root_discuss"
        action="action_whatsapp_pending_confirmation"
        sequence="50"/>

    <!-- Extender la vista de formulario de plantillas WhatsApp -->
    <record id="view_mail_whatsapp_template_form_confirmation" model="ir.ui.view">
        <field name="name">mail.whatsapp.template.form.confirmation</field>
        <field name="model">mail.whatsapp.template</field>
        <field name="inherit_id" ref="mail_gateway_whatsapp.view_mail_whatsapp_template_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group[2]" position="inside">
                <separator string="Confirmación Automática" colspan="2"/>
                <field name="requires_confirmation" nolabel="0"/>
                <field name="confirmation_template_id"
                       invisible="not requires_confirmation"
                       required="requires_confirmation"
                       options="{'no_create': True}"
                       nolabel="0"/>
                <field name="confirmation_type"
                       invisible="not requires_confirmation"
                       required="requires_confirmation"
                       nolabel="0"/>
            </xpath>
            <xpath expr="//notebook" position="before">
                <div invisible="not requires_confirmation" class="alert alert-info mt-2" role="alert">
                    <strong>ℹ️ Flujo de Confirmación Automática:</strong><br/>
                    Cuando se envíe esta plantilla, el sistema esperará una respuesta del cliente para enviar automáticamente la plantilla de confirmación.
                </div>
            </xpath>
        </field>
    </record>

    <!-- Cron para expirar confirmaciones pendientes -->
    <record id="ir_cron_expire_pending_confirmations" model="ir.cron">
        <field name="name">WhatsApp: Expirar Confirmaciones Pendientes</field>
        <field name="model_id" ref="model_whatsapp_pending_confirmation"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_pending_confirmations()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

</odoo>

