<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_appcc_registration_tree" model="ir.ui.view">
        <field name="name">appcc.registration.tree</field>
        <field name="model">appcc.registration</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="responsible_id"/>
                <field name="result_selection"/>
            </list>
        </field>
    </record>
    <record id="view_appcc_registration_form" model="ir.ui.view">
        <field name="name">appcc.registration.form</field>
        <field name="model">appcc.registration</field>
