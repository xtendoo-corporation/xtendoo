<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_order_picking_all_done.view_order_form_inherit" model="ir.ui.view">
        <field name="name">view.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="before">
                <button
                    name="action_sale_order_confirm_and_delivery"
                    string="Confirmar y entregar"
                    type="object"
                    class="oe_highlight"
                    invisible="state not in ['draft', 'sent']"
                />
                <button
                    name="action_sale_order_confirm_and_invoice"
                    string="Confirmar, entregar y facturar"
                    type="object"
                    class="oe_highlight"
                    invisible="state not in ['draft', 'sent'] or invoice_status == 'invoiced'"
                />
                <button
                    name="action_sale_order_delivery"
                    string="Entregar todo"
                    type="object"
                    class="oe_highlight"
                    invisible="state not in ['sale']"
                />
                <button
                    name="action_sale_order_delivery_and_invoiced"
                    string="Entregar y facturar"
                    type="object"
                    class="oe_highlight"
                    invisible="state not in ['sale'] or invoice_status == 'invoiced'"
                />
            </xpath>
        </field>
    </record>
</odoo>
