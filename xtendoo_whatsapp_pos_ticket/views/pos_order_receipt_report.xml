        <t t-call="web.html_container">
            <t t-call="xtendoo_pos_receipt.OrderReceipt"/>
        </t>
    </template>

    <report
        id="action_report_pos_order_receipt"
        string="Recibo POS PDF"
        model="pos.order"
        report_type="qweb-pdf"
        name="xtendoo_whatsapp_pos_ticket.report_pos_order_receipt_document"
        file="xtendoo_whatsapp_pos_ticket.report_pos_order_receipt_document"
        print_report_name="'Recibo_POS_' + object.name.replace('/', '_')"
    />
</odoo>

