API_KEY=mi_clave_super_secreta
PORT=3211
HOST=0.0.0.0
# Orígenes CORS permitidos (separados por coma). Dejar vacío = permitir cualquier origen.
# Añadir aquí todas las URLs desde las que se accede a Odoo.
ALLOWED_ORIGINS=https://confiteriadelcarmen.xtd.es
DEFAULT_PRINTER=POS-80C
# Certificados generados con: mkcert 127.0.0.1 192.168.18.7 localhost
# Regenerar ejecutando install.ps1 de nuevo en el PC Windows
# El servidor HTTPS escucha en PORT+1 = 3212
# Configurar en Odoo TPV -> URL del bridge: https://192.168.18.7:3212
CERT_KEY=127.0.0.1+2-key.pem
CERT_CERT=127.0.0.1+2.pem
