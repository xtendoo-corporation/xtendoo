<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_ai_form_inherit" model="ir.ui.view">
        <field name="name">account.move.ai.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_ai_document_wizard"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-robot"
                    invisible="state != 'draft'"
                    string="Import with AI"
                />
            </xpath>
            <xpath expr="//sheet" position="before">
                <div
                    class="alert alert-info"
                    role="alert"
                    invisible="not ai_processed"
                >
                    <strong>AI Processed</strong> — Document type detected:
                    <field name="ai_document_type" readonly="1" class="d-inline"/>
                    <span invisible="not ai_has_corrections">
                        &amp;nbsp;·&amp;nbsp;
                        <em>Manual corrections detected — consider re-processing.</em>
                    </span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
