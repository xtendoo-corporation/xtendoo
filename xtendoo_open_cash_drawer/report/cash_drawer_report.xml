<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_cash_drawer_receipt" model="ir.actions.report">
        <field name="name">Cash Drawer Dummy Receipt</field>
        <field name="model">pos.config</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">xtendoo_open_cash_drawer.report_cash_drawer_receipt</field>
        <field name="report_file">xtendoo_open_cash_drawer.report_cash_drawer_receipt</field>
        <field name="print_report_name">'CashDrawerReceipt'</field>
        <field name="binding_model_id" ref="point_of_sale.model_pos_config"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_cash_drawer_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page text-center" style="font-family: monospace;">
                        <div style="margin-top: 50px; margin-bottom: 50px;">
                            .
                        </div>
                        <div style="font-size: 8px; color: #ccc;">
                            [CASH DRAWER OPEN]
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
