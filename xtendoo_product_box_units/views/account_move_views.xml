<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Account Move Form: lista y formulario -->
    <record id="view_move_form_box_units" model="ir.ui.view">
        <field name="name">account.move.form.box.units</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Lista de líneas (tree) -->
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='product_id']" position="after">
                <field name="account_id" string="Cuenta"/>
                <field name="boxes" string="Cajas" optional="show" widget="float" options="{'digits': [16, 2]}"/>
                <field name="box_units" string="Unidades por Caja" optional="show" widget="float" options="{'digits': [16, 2]}"/>
            </xpath>

            <!-- Formulario principal dentro del invoice -->
            <xpath expr="//form//sheet//group//field[@name='quantity']" position="before">
                <field name="account_id" string="Cuenta"/>
                <field name="boxes" string="Cajas" widget="float" options="{'digits': [16, 2]}"/>
                <field name="box_units" string="Unidades por Caja" widget="float" options="{'digits': [16, 2]}"/>
            </xpath>

        </field>
    </record>

    <!-- Formulario de línea móvil -->
    <record id="view_account_move_line_form_box_units" model="ir.ui.view">
        <field name="name">account.move.line.form.box.units</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="before">
                <field name="account_id" string="Cuenta"/>
                <field name="boxes" string="Cajas" widget="float" options="{'digits': [16, 2]}"/>
                <field name="box_units" string="Unidades por Caja" widget="float" options="{'digits': [16, 2]}"/>
            </xpath>
        </field>
    </record>

</odoo>
