<odoo>
    <!-- Account Move Line Tree View in Invoice Form -->
    <record id="view_move_form_box_units" model="ir.ui.view">
        <field name="name">account.move.form.box.units</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='quantity']" position="before">
                <field name="boxes" optional="show"/>
                <field name="box_units" optional="hide" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Account Move Line Form View -->
    <record id="view_account_move_line_form_box_units" model="ir.ui.view">
        <field name="name">account.move.line.form.box.units</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="before">
                <field name="boxes"/>
                <field name="box_units" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Account Move Line Tree View (standalone) -->
    <record id="view_account_move_line_tree_box_units" model="ir.ui.view">
        <field name="name">account.move.line.tree.box.units</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="before">
                <field name="boxes" optional="show"/>
                <field name="box_units" optional="hide" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
