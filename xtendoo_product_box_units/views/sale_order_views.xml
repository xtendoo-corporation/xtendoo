<odoo>

    <record id="sale_order_commitment_date_form_view" model="ir.ui.view">
        <field name="name">sale.order.commitment.date.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/form//field[@name='price_unit']"
                position="before"
            >
                <br/>
                <field name="boxes" />
                <field name="box_units" string="Unidades por Caja"/>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/list/field[@name='price_unit']"
                position="before"
            >
                <field name="boxes" />
                <field name="box_units" string="Unidades por Caja"/>
            </xpath>
        </field>
    </record>

    <!-- Sale Order Line Form View for mobile editing -->
    <record id="view_sale_order_line_form_box_units" model="ir.ui.view">
        <field name="name">sale.order.line.form.box.units</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.sale_order_line_view_form_readonly"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_qty']" position="before">
                <field name="boxes" string="Cajas"/>
                <field name="box_units" string="Unidades por Caja"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_line_ext_tree_view" model="ir.ui.view">
        <field name="name">sale.order.line.ext.list</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="boxes" optional="show" />
                <field name="box_units" optional="show" />
            </field>
        </field>
    </record>
</odoo>
