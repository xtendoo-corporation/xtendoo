<odoo>

    <!-- Sale Order Line Form View for mobile -->
    <record id="view_order_form_box_units" model="ir.ui.view">
        <field name="name">sale.order.form.box.units</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="order_line" position="attributes">
                <attribute name="context">{'tree_view_ref': 'xtendoo_product_box_units.view_sale_order_line_tree_box_units'}</attribute>
            </field>
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_qty']" position="before">
                <field name="boxes" string="Cajas" widget="float" options="{'digits': [16, 2]}"/>
                <field name="box_units" string="Unidades por Caja" widget="float" options="{'digits': [16, 2]}"/>
            </xpath>
            <!-- Add fields to kanban view for mobile -->
            <xpath expr="//field[@name='order_line']/kanban//field[@name='product_uom_qty']" position="before">
                <field name="boxes"/>
                <field name="box_units"/>
            </xpath>
        </field>
    </record>

    <!-- Sale Order Line Form View for mobile editing -->
    <record id="view_sale_order_line_form_box_units" model="ir.ui.view">
        <field name="name">sale.order.line.form.box.units</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.sale_order_line_view_form_readonly"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_qty']" position="before">
                <field name="boxes" string="Cajas"/>
                <field name="box_units" string="Unidades por Caja"/>
            </xpath>
        </field>
    </record>

</odoo>
