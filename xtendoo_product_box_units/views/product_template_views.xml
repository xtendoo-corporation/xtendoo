<odoo>
    <record id="product_template_form_view_box_units" model="ir.ui.view">
        <field name="name">product.template.form.box.units</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_tooltip']" position="after">
                <field name="box_units" invisible="type != 'consu'"/>
            </xpath>
        </field>
    </record>
</odoo>
