<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Palabras clave por defecto para solicitar vacaciones -->
        <record id="vacation_keyword_1" model="vacation.keyword.config">
            <field name="name">Vacaciones principal</field>
            <field name="sequence">10</field>
            <field name="keyword">/vacaciones</field>
            <field name="active">True</field>
            <field name="description">Comando principal para solicitar vacaciones</field>
        </record>

        <record id="vacation_keyword_2" model="vacation.keyword.config">
            <field name="name">Solicitar vacaciones</field>
            <field name="sequence">20</field>
            <field name="keyword">/solicitar vacaciones</field>
            <field name="active">True</field>
            <field name="description">Comando alternativo para solicitar vacaciones</field>
        </record>

        <record id="vacation_keyword_3" model="vacation.keyword.config">
            <field name="name">Pedir vacaciones</field>
            <field name="sequence">30</field>
            <field name="keyword">/pedir vacaciones</field>
            <field name="active">True</field>
            <field name="description">Comando para pedir vacaciones</field>
        </record>

        <record id="vacation_keyword_4" model="vacation.keyword.config">
            <field name="name">Días libres</field>
            <field name="sequence">40</field>
            <field name="keyword">/dias libres</field>
            <field name="active">True</field>
            <field name="description">Comando alternativo para días libres</field>
        </record>

        <record id="vacation_keyword_5" model="vacation.keyword.config">
            <field name="name">Holiday</field>
            <field name="sequence">50</field>
            <field name="keyword">/holiday</field>
            <field name="active">True</field>
            <field name="description">Comando en inglés para vacaciones</field>
        </record>

        <record id="vacation_keyword_6" model="vacation.keyword.config">
            <field name="name">Permisos</field>
            <field name="sequence">60</field>
            <field name="keyword">/permisos</field>
            <field name="active">True</field>
            <field name="description">Comando para solicitar permisos/vacaciones</field>
        </record>

    </data>
</odoo>
