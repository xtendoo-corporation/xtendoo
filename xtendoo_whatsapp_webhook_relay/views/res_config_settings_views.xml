<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.xtendoo.whatsapp.webhook.relay</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position="after">
                <block
                    title="WhatsApp Webhook Relay (Xtendoo)"
                    name="xtendoo_whatsapp_webhook_relay_block"
                    groups="base.group_system"
                >
                    <setting id="xtendoo_whatsapp_relay_api_key_setting">
                        <field name="xtendoo_whatsapp_relay_api_key" password="True" />
                        <label for="xtendoo_whatsapp_relay_api_key" string="WhatsApp Relay API Key" />
                        <div class="text-muted">
                            Shared secret clients use to register/unregister their
                            phone number with this relay. Must match the value
                            configured on each client's xtendoo_whatsapp_onboarding
                            settings.
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
