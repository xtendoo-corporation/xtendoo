<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_employee_portal_sessions" model="ir.actions.act_window">
        <field name="name">Sesiones del Portal</field>
        <field name="res_model">employee.portal.session</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay sesiones activas en este momento.
            </p>
        </field>
    </record>

    <record id="view_employee_portal_session_tree" model="ir.ui.view">
        <field name="name">employee.portal.session.tree</field>
        <field name="model">employee.portal.session</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="create_date"/>
                <field name="expiration_date"/>
                <field name="is_valid"/>
            </list>
        </field>
    </record>

    <record id="view_employee_portal_session_form" model="ir.ui.view">
        <field name="name">employee.portal.session.form</field>
        <field name="model">employee.portal.session</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="session_token"/>
                        <field name="create_date"/>
                        <field name="expiration_date"/>
                        <field name="is_valid"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
