<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plantilla de inicio de sesión -->
    <template id="employee_login_template" name="Inicio de sesión de empleado">
        <t t-call="web.frontend_layout">
            <div class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-lg-5 col-md-7 col-sm-9">
                        <div class="card shadow">
                            <div class="card-header bg-primary text-white">
                                <h4 class="mb-0 text-center">Portal de Empleados</h4>
                            </div>
                            <div class="card-body">
                                <form action="/employee/portal/authenticate" method="post" class="js_employee_pin_form">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="form-group mb-3">
                                        <label for="pin" class="form-label">PIN de Empleado</label>
                                        <input type="password" class="form-control" id="pin" name="pin" maxlength="4" placeholder="Ingrese su PIN de 4 dígitos" required="required" autocomplete="off" />
                                    </div>
                                    <div t-if="request.params.get('error')" class="alert alert-danger">
                                        <t t-if="request.params.get('error') == 'invalid_pin'">
                                            El PIN debe ser de 4 dígitos.
                                        </t>
                                        <t t-elif="request.params.get('error') == 'wrong_pin'">
                                            PIN incorrecto. Por favor, intente nuevamente.
                                        </t>
                                        <t t-else="">
                                            Ha ocurrido un error. Por favor, intente nuevamente.
                                        </t>
                                    </div>
                                    <div class="d-grid gap-2">
                                        <button type="submit" class="btn btn-primary">Iniciar Sesión</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Layout base para el portal de empleados -->
    <template id="employee_portal_layout" name="Layout del Portal de Empleados">
        <t t-call="web.frontend_layout">
            <div class="container mt-3">
                <div class="row mb-3">
                    <div class="col-12">
                        <nav class="navbar navbar-expand-lg navbar-light bg-light">
                            <div class="container-fluid">
                                <a class="navbar-brand" href="/employee/portal/dashboard">Portal de Empleados</a>
                                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#employeeNavbar">
                                    <span class="navbar-toggler-icon"></span>
                                </button>
                                <div class="collapse navbar-collapse" id="employeeNavbar">
                                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                                        <li class="nav-item">
                                            <a t-attf-class="nav-link #{active == 'attendance' and 'active' or ''}" href="/employee/portal/attendance">Fichar</a>
                                        </li>
                                        <li class="nav-item">
                                            <a t-attf-class="nav-link #{active == 'leaves' and 'active' or ''}" href="/employee/portal/leaves">Ausencias</a>
                                        </li>
                                        <li class="nav-item">
                                            <a t-attf-class="nav-link #{active == 'calendar' and 'active' or ''}" href="/employee/portal/resource/calendar">Planificación</a>
                                        </li>
                                        <t t-if="available_features.get('timesheet')">
                                            <li class="nav-item">
                                                <a t-attf-class="nav-link #{active == 'timesheets' and 'active' or ''}" href="/employee/portal/timesheets">Partes de horas</a>
                                            </li>
                                        </t>
                                        <li class="nav-item">
                                            <a t-attf-class="nav-link #{active == 'history' and 'active' or ''}" href="/employee/portal/attendance/history">Registros</a>
                                        </li>
                                    </ul>
                                    <div class="d-flex">
                                        <span class="navbar-text me-3">
                                            <t t-esc="employee.name"/>
                                        </span>
                                        <a href="/employee/portal/logout" class="btn btn-outline-danger btn-sm">Cerrar Sesión</a>
                                    </div>
                                </div>
                            </div>
                        </nav>
                    </div>
                </div>
                <t t-raw="0"/>
            </div>
        </t>
    </template>

    <!-- Plantilla del Dashboard -->
    <template id="employee_dashboard_template" name="Dashboard de Empleado">
        <t t-call="xtendoo_employee_portal.employee_portal_layout">
            <div class="row">
                <div class="col-12">
                    <div class="card mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="card-title mb-0">Bienvenido/a <t t-esc="employee.name"/></h5>
                        </div>
                        <div class="card-body">
                            <p>Desde este portal podrás:</p>
                            <ul>
                                <li><a href="/employee/portal/attendance">Fichar entrada y salida</a></li>
                                <li><a href="/employee/portal/leaves">Ver tus ausencias y solicitar nuevas</a></li>
                                <li><a href="/employee/portal/resource/calendar">Consultar tu planificación</a></li>
                                <li><a href="/employee/portal/timesheets">Revisar tus partes de horas</a></li>
                                <li><a href="/employee/portal/attendance/history">Ver tus registros de entrada y salida</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Plantilla para fichar entrada/salida -->
    <template id="employee_attendance_template" name="Fichaje de Empleado">
        <t t-call="xtendoo_employee_portal.employee_portal_layout">
            <t t-set="active" t-value="'attendance'"/>
            <div class="row justify-content-center">
                <div class="col-lg-6">
                    <div class="card mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="card-title mb-0">Fichar Entrada/Salida</h5>
                        </div>
                        <div class="card-body text-center">
                            <div class="mb-4">
                                <h2><t t-esc="employee.name"/></h2>
                                <p><strong>Fecha actual:</strong> <span t-esc="current_date"/></p>
                                <p><strong>Hora actual:</strong> <span t-esc="current_time"/></p>
                            </div>

                            <form action="/employee/portal/attendance/check" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                <div t-if="attendance" class="mb-4">
                                    <div class="alert alert-info">
                                        <p>Has fichado la entrada a las <strong t-esc="attendance.check_in.strftime('%H:%M:%S')"/></p>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-lg" t-att-class="'btn-danger' if attendance else 'btn-success'">
                                    <i t-att-class="'fa fa-sign-out' if attendance else 'fa fa-sign-in'" aria-hidden="true"></i>
                                    <span t-if="attendance">Fichar Salida</span>
                                    <span t-else="">Fichar Entrada</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Plantilla para ausencias -->
    <template id="employee_leaves_template" name="Ausencias de Empleado">
        <t t-call="xtendoo_employee_portal.employee_portal_layout">
            <t t-set="active" t-value="'leaves'"/>
            <div class="row">
                <div class="col-lg-12">
                    <div class="card mb-4">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">Mis Ausencias</h5>
                            <button type="button" class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#newLeaveModal">
                                <i class="fa fa-plus"></i> Solicitar Ausencia
                            </button>
                        </div>
                        <div class="card-body">
                            <t t-if="leaves">
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Tipo</th>
                                                <th>Fecha Inicio</th>
                                                <th>Fecha Fin</th>
                                                <th>Duración</th>
                                                <th>Estado</th>
                                                <th>Descripción</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="leaves" t-as="leave">
                                                <tr>
                                                    <td><t t-esc="leave.holiday_status_id.name"/></td>
                                                    <td><t t-esc="leave.date_from.strftime('%d/%m/%Y')"/></td>
                                                    <td><t t-esc="leave.date_to.strftime('%d/%m/%Y')"/></td>
                                                    <td><t t-esc="leave.number_of_days"/> días</td>
                                                    <td>
                                                        <span t-att-class="'badge ' + ('bg-success' if leave.state == 'validate' else 'bg-warning' if leave.state == 'confirm' else 'bg-danger' if leave.state == 'refuse' else 'bg-info')">
                                                            <t t-if="leave.state == 'validate'">Aprobada</t>
                                                            <t t-elif="leave.state == 'confirm'">Pendiente</t>
                                                            <t t-elif="leave.state == 'refuse'">Rechazada</t>
                                                            <t t-else="">Borrador</t>
                                                        </span>
                                                    </td>
                                                    <td><t t-esc="leave.name"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="alert alert-info">
                                    No tienes ausencias registradas.
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal para solicitar nueva ausencia -->
            <div class="modal fade" id="newLeaveModal" tabindex="-1" aria-labelledby="newLeaveModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="newLeaveModalLabel">Solicitar Ausencia</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form action="/employee/portal/leaves/request" method="post">
                            <div class="modal-body">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                <div class="mb-3">
                                    <label for="leave_type_id" class="form-label">Tipo de Ausencia</label>
                                    <select class="form-select" id="leave_type_id" name="leave_type_id" required="required">
                                        <option value="">Seleccionar tipo...</option>
                                        <t t-foreach="leave_types" t-as="leave_type">
                                            <option t-att-value="leave_type.id"><t t-esc="leave_type.name"/></option>
                                        </t>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label for="date_from" class="form-label">Fecha de Inicio</label>
                                    <input type="datetime-local" class="form-control" id="date_from" name="date_from" required="required"/>
                                </div>

                                <div class="mb-3">
                                    <label for="date_to" class="form-label">Fecha de Fin</label>
                                    <input type="datetime-local" class="form-control" id="date_to" name="date_to" required="required"/>
                                </div>

                                <div class="mb-3">
                                    <label for="name" class="form-label">Descripción</label>
                                    <textarea class="form-control" id="name" name="name" rows="3" required="required"></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-primary">Solicitar</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Plantilla para planificación -->
    <template id="employee_calendar_template" name="Planificación de Empleado">
        <t t-call="xtendoo_employee_portal.employee_portal_layout">
            <t t-set="active" t-value="'calendar'"/>
            <div class="row">
                <div class="col-12">
                    <div class="card mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="card-title mb-0">Mi Planificación</h5>
                        </div>
                        <div class="card-body">
                            <t t-if="calendar_entries">
                                <div class="table-responsive">
                                    <table class="table table-bordered">
                                        <thead>
                                            <tr>
                                                <th>Día</th>
                                                <th>Horario</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="calendar_entries" t-as="day">
                                                <tr>
                                                    <td>
                                                        <strong><t t-esc="day['day_name']"/></strong><br/>
                                                        <span class="text-muted"><t t-esc="day['day']"/></span>
                                                    </td>
                                                    <td>
                                                        <t t-if="day['intervals']">
                                                            <t t-foreach="day['intervals']" t-as="interval">
                                                                <span class="badge bg-info me-2">
                                                                    <t t-esc="interval['start']"/> - <t t-esc="interval['end']"/>
                                                                </span>
                                                            </t>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="badge bg-secondary">No laborable</span>
                                                        </t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="alert alert-info">
                                    No tienes horario definido.
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Plantilla para partes de horas -->
    <template id="employee_timesheets_template" name="Partes de Horas de Empleado">
        <t t-call="xtendoo_employee_portal.employee_portal_layout">
            <t t-set="active" t-value="'timesheets'"/>
            <div class="row">
                <div class="col-12">
                    <div class="card mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="card-title mb-0">Mis Partes de Horas</h5>
                        </div>
                        <div class="card-body">
                            <t t-if="timesheets">
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Fecha</th>
                                                <th>Proyecto</th>
                                                <th>Tarea</th>
                                                <th>Descripción</th>
                                                <th>Duración</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="timesheets" t-as="timesheet">
                                                <tr>
                                                    <td><t t-esc="timesheet.date.strftime('%d/%m/%Y')"/></td>
                                                    <td><t t-esc="timesheet.project_id.name or '-'"/></td>
                                                    <td><t t-esc="timesheet.task_id.name or '-'"/></td>
                                                    <td><t t-esc="timesheet.name"/></td>
                                                    <td><t t-esc="timesheet.unit_amount"/> horas</td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="alert alert-info">
                                    No tienes partes de horas registrados para el mes actual.
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Plantilla para historial de asistencias -->
    <template id="employee_attendance_history_template" name="Historial de Asistencias">
        <t t-call="xtendoo_employee_portal.employee_portal_layout">
            <t t-set="active" t-value="'history'"/>
            <div class="row">
                <div class="col-12">
                    <div class="card mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="card-title mb-0">Mis Registros de Entrada y Salida</h5>
                        </div>
                        <div class="card-body">
                            <t t-if="attendances">
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Fecha</th>
                                                <th>Hora Entrada</th>
                                                <th>Hora Salida</th>
                                                <th>Duración</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="attendances" t-as="attendance">
                                                <tr>
                                                    <td><t t-esc="attendance.check_in.strftime('%d/%m/%Y')"/></td>
                                                    <td><t t-esc="attendance.check_in.strftime('%H:%M:%S')"/></td>
                                                    <td>
                                                        <t t-if="attendance.check_out">
                                                            <t t-esc="attendance.check_out.strftime('%H:%M:%S')"/>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="badge bg-warning">En curso</span>
                                                        </t>
                                                    </td>
                                                    <td>
                                                        <t t-if="attendance.check_out">
                                                            <t t-esc="'%.2f' % attendance.worked_hours"/> horas
                                                        </t>
                                                        <t t-else="">
                                                            -
                                                        </t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="alert alert-info">
                                    No tienes registros de entrada y salida para el mes actual.
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
