<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Categoría de seguridad -->
        <record id="module_category_employee_portal" model="ir.module.category">
            <field name="name">Portal de Empleados</field>
            <field name="description">Permisos para el portal de empleados</field>
            <field name="sequence">100</field>
        </record>

        <!-- Grupo de usuarios -->
        <record id="group_employee_portal_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="category_id" ref="module_category_employee_portal"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Regla de seguridad para las sesiones -->
        <record id="employee_portal_session_rule" model="ir.rule">
            <field name="name">Portal de Empleados: Sesiones</field>
            <field name="model_id" ref="model_employee_portal_session"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
