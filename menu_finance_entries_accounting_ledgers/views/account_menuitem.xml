<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_moves_ledger_general" model="ir.ui.view">
        <field name="name">account.move.line.tree.grouped.misc</field>
        <field name="model">account.move.line</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="tax_line_id" position="before">
                <field name="cumulated_balance"/>
            </field>
            <field name="account_id" position="attributes">
                <attribute name="optional">hide</attribute>
                <attribute name="readonly">1</attribute>
            </field>
            <field name="balance" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
        </field>
    </record>

