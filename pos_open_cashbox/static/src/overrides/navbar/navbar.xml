<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_open_cashbox.NavbarExtend" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <!-- Add Open Cash Drawer option in the burger menu, before Backend -->
        <xpath expr="//DropdownItem[contains(text(), 'Backend')]" position="before">
            <DropdownItem t-if="showOpenCashDrawerButton" onSelected="() => this.openCashDrawer()">
                <i class="fa fa-fw fa-money me-1"/>Open Cash Drawer
            </DropdownItem>
        </xpath>
    </t>

</templates>