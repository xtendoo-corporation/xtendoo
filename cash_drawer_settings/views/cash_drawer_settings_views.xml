<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cash_drawer_settings_view_form" model="ir.ui.view">
        <field name="name">cash.drawer.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form[1]" position="inside">
                <app data-string="Cajón Portamonedas"
                     string="Cajón Portamonedas"
                     name="cash_drawer_settings"
                     logo="/cash_drawer_settings/static/description/icon.png">
                    <block title="Dispositivo" name="cash_drawer_device_block">
                        <setting string="Detectar impresoras USB/Serie"
                                 help="Escanea y muestra las impresoras conectadas por USB o puerto serie. Útil para encontrar el nombre correcto del dispositivo."
                                 id="cash_drawer_detect_setting">
                            <button name="action_detect_printers"
                                    type="object"
                                    string="🔍 Detectar impresoras"
                                    class="btn btn-secondary"
                                    icon="fa-search"/>
                        </setting>

                        <setting string="Seleccionar impresora"
                                 help="Selecciona una impresora de la lista detectada automáticamente. También puedes introducir directamente IP:puerto para impresoras de red."
                                 id="cash_drawer_printer_select_setting">
                            <field name="cash_drawer_printer_select"
                                   placeholder="Selecciona una impresora"/>
                        </setting>

                        <setting string="Impresora configurada"
                                 help="Introduce la dirección de la impresora de tickets.&#10;&#10;· Red / TCP (recomendado): IP:puerto — p. ej. 192.168.1.50:9100&#10;· CUPS (Linux): nombre de la cola de impresión&#10;&#10;Impresora USB en Windows:&#10;  1. Abre Panel de control → Dispositivos e impresoras.&#10;  2. Clic derecho en la impresora → Propiedades de impresora → Puertos.&#10;  3. Añade un puerto TCP/IP estándar con la IP de este equipo y puerto 9100.&#10;  4. Escribe aquí IP_equipo_Windows:9100."
                                 id="cash_drawer_printer_path_setting">
                            <field name="cash_drawer_printer_path"
                                   placeholder="192.168.1.50:9100"/>
                        </setting>
                        <setting string="Comando de apertura (bytes)"
                                 help="Bytes del comando ESC/POS en decimal separados por espacios.&#10;&#10;Ejemplos:&#10;· 27 112 0 25 250 → ESC p (estándar)&#10;· 27 105 → ESC i&#10;· 27 112 1 25 250 → ESC p pin 5&#10;&#10;Si está vacío, usa por defecto: 27 105"
                                 id="cash_drawer_command_bytes_setting">
                            <field name="cash_drawer_command_bytes"
                                   placeholder="27 112 0 25 250"/>
                        </setting>
                    </block>
                    <block title="Acción" name="cash_drawer_action_block">
                        <setting string="Abrir cajón portamonedas"
                                 id="cash_drawer_open_setting">
                            <button name="action_open_cash_drawer"
                                    type="object"
                                    string="Abrir cajón portamonedas"
                                    class="btn btn-primary"
                                    icon="fa-unlock"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
