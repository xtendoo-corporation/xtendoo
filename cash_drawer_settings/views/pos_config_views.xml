<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_inherit_cash_drawer" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.cash.drawer</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <!-- Insert in Odoo 19's Hardware section -->
            <xpath expr="//field[@name='iface_print_via_proxy']/ancestor::div[contains(@class, 'row')][last()]" position="after">
                <div class="row">
                    <div class="col-lg-5 o_light_label ps-4">
                        <label string="Open Cash Drawer via Dummy Print" for="cash_drawer_dummy_print"/>
                    </div>
                    <div class="col-lg-7">
                        <field name="cash_drawer_dummy_print" widget="boolean_toggle"/>
                    </div>
                </div>
                <div class="row" invisible="not cash_drawer_dummy_print">
                    <div class="col-lg-5 o_light_label ps-5">
                        <label string="Dummy Print Text" for="cash_drawer_dummy_text" class="text-muted"/>
                    </div>
                    <div class="col-lg-7">
                        <field name="cash_drawer_dummy_text" class="oe_inline"/>
                    </div>
                </div>
                <div class="row" invisible="not cash_drawer_dummy_print">
                    <div class="col-lg-5 o_light_label ps-5">
                        <label string="Web Print Fallback" for="cash_drawer_web_print_fallback" class="text-muted"/>
                    </div>
                    <div class="col-lg-7">
                        <field name="cash_drawer_web_print_fallback"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
