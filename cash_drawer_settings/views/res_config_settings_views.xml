<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cash.drawer.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <!-- Insert in Odoo 19's Connected Devices block -->
            <xpath expr="//block[@id='pos_connected_devices_section']" position="inside">
                 <setting string="Cash Drawer" help="Configure cash drawer opening strategy via dummy print">
                    <field name="cash_drawer_dummy_print" widget="boolean_toggle"/>
                    <div class="content-group" invisible="not cash_drawer_dummy_print">
                        <div class="row mt16">
                            <label for="cash_drawer_dummy_text" string="Dummy Print Text" class="col-lg-5 o_light_label"/>
                            <div class="col-lg-7">
                                <field name="cash_drawer_dummy_text" class="oe_inline"/>
                            </div>
                        </div>
                        <div class="row">
                            <label for="cash_drawer_web_print_fallback" string="Web Print Fallback" class="col-lg-5 o_light_label"/>
                            <div class="col-lg-7">
                                <field name="cash_drawer_web_print_fallback"/>
                            </div>
                        </div>
                        <div class="text-muted small mt-2">
                            This option triggers a minimal print to open the drawer via printer instead of direct hardware commands.
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
