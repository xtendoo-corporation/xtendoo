<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Patch del Navbar del TPV para añadir:
          · DropdownItem "Abrir cajón portamonedas"  (visible cuando cash_drawer_pos_enabled = true)
          · DropdownItem "Vincular impresora USB"    (visible cuando WebUSB está disponible)
    -->
    <t t-name="cash_drawer_settings.Navbar"
       t-inherit="point_of_sale.Navbar"
       t-inherit-mode="extension">

        <!-- Inyectar dentro del menú hamburguesa, antes de "Backend" -->
        <xpath expr="//div[hasclass('pos-burger-menu-items')]" position="inside">
            <DropdownItem
                t-if="showCashDrawerButton"
                onSelected="() => this.openCashDrawer()">
                <i class="fa fa-fw fa-unlock me-1"/>
                Abrir cajón portamonedas
            </DropdownItem>
            <DropdownItem
                t-if="showWebUsbButton"
                onSelected="() => this.requestWebUsbDevice()">
                <i class="fa fa-fw fa-usb me-1"/>
                Vincular impresora USB
            </DropdownItem>
        </xpath>

    </t>

</templates>

