<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron job para procesar recordatorios WhatsApp -->
    <record id="ir_cron_calendar_whatsapp_reminders" model="ir.cron">
        <field name="name">Enviar Recordatorios WhatsApp de Calendario</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="state">code</field>
        <field name="code">model.process_whatsapp_reminders()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
