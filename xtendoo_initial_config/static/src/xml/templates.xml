<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Plantilla para la acción cliente que inicia el tour -->
    <t t-name="xtendoo_initial_config.ActivateSpanishTourAction">
        <div class="o_activate_spanish_tour_container">
            <div class="o_activate_spanish_tour_content">
                <h3>Activación del idioma español</h3>
                <p>Este asistente configurará el idioma español como idioma principal del sistema.</p>
                <button type="button" class="btn btn-primary o_start_spanish_tour">
                    Iniciar configuración
                </button>
            </div>
        </div>
    </t>
</templates>

