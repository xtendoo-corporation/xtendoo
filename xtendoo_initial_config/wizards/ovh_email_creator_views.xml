<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulario del wizard -->
    <record id="view_ovh_email_creator_form" model="ir.ui.view">
        <field name="name">ovh.email.creator.form</field>
        <field name="model">ovh.email.creator</field>
        <field name="arch" type="xml">
            <form string="Crear cuenta de correo en OVH">
                <sheet>
                    <field name="email_full" invisible="1"/>
                    <group string="Datos de la cuenta de correo">
                        <field name="domain" placeholder="dominio"/>
                        <field name="email_address" placeholder="usuario"/>
                        <field name="password" password="True"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_configure_mail_servers" string="Configurar servidores de correo" type="object" class="btn-success"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción del wizard -->
    <record id="action_ovh_email_creator" model="ir.actions.act_window">
        <field name="name">Crear cuenta de correo en OVH</field>
        <field name="res_model">ovh.email.creator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Elemento de menú para acceder al wizard -->
    <menuitem id="menu_ovh_email_creator"
              name="Crear cuenta de correo OVH"
              action="action_ovh_email_creator"
              parent="base.menu_administration"
              sequence="99"/>
</odoo>
