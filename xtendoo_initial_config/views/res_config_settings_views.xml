<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ovh_email" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ovh.email</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <form position="inside">
                <div class="app_settings_block" data-string="OVH">
                    <h2>OVH Email</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Credenciales API OVH</span>
                                <div class="text-muted">
                                    Introduce los datos necesarios para utilizar la API de OVH
                                </div>
                                <div class="mt16">
                                    <label for="ovh_endpoint" string="Endpoint OVH" class="o_light_label"/>
                                    <field name="ovh_endpoint" class="oe_inline"/>
                                </div>
                                <div class="mt16">
                                    <label for="ovh_consumer_key" string="Consumer Key" class="o_light_label"/>
                                    <field name="ovh_consumer_key" password="True" class="oe_inline"/>
                                </div>
                                <div class="mt16">
                                    <label for="ovh_domain" string="Dominio de correo" class="o_light_label"/>
                                    <field name="ovh_domain" class="oe_inline"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </field>
    </record>
</odoo>
