<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_xtendoo_config_wizard_form" model="ir.ui.view">
        <field name="name">xtendoo.config.wizard.form</field>
        <field name="model">xtendoo.config.wizard</field>
        <field name="arch" type="xml">
            <form string="Asistente de Configuración Inicial">
                <group>
                    <button name="action_apply_config" type="object" string="Aplicar Configuración" class="btn-primary"/>
                </group>
                <group>
                    <field name="summary" readonly="1" nolabel="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_xtendoo_config_wizard" model="ir.actions.act_window">
        <field name="name">Asistente de Configuración Xtendoo</field>
        <field name="res_model">xtendoo.config.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_xtendoo_config_root"
        name="Xtendoo Utilidades"
        parent="base.menu_config"
        sequence="99"/>

    <menuitem id="menu_xtendoo_config_wizard"
        name="Asistente de Configuración Xtendoo"
        parent="base.menu_translation"
        action="action_xtendoo_config_wizard"
        sequence="10"/>
</odoo>
