msgid "Discover Our"
msgstr "Descubre Nuestras"

#. module: xtendoo_website_feature_accordion
#: model:ir.ui.view,arch_db:xtendoo_website_feature_accordion.s_feature_accordion
msgid "Key Features"
msgstr "Funcionalidades Clave"

#. module: xtendoo_website_feature_accordion
#: model:ir.ui.view,arch_db:xtendoo_website_feature_accordion.s_feature_accordion
msgid "Everything you need to transform your business, in one platform."
msgstr "Todo lo que necesitas para transformar tu negocio, en una sola plataforma."

#. module: xtendoo_website_feature_accordion
#: model:ir.ui.view,arch_db:xtendoo_website_feature_accordion.s_feature_accordion
msgid "Advanced Analytics"
msgstr "Analítica Avanzada"

#. module: xtendoo_website_feature_accordion
#: model:ir.ui.view,arch_db:xtendoo_website_feature_accordion.s_feature_accordion
msgid "Gain real-time insights into your operations with our powerful analytics dashboard. Track KPIs, generate custom reports, and make data-driven decisions effortlessly."
msgstr "Obtén información en tiempo real sobre tus operaciones con nuestro potente panel de analítica. Rastrea KPIs, genera informes personalizados y toma decisiones basadas en datos sin esfuerzo."

#. module: xtendoo_website_feature_accordion
#: model:ir.ui.view,arch_db:xtendoo_website_feature_accordion.s_feature_accordion
msgid "Team Collaboration"
msgstr "Colaboración en Equipo"

#. module: xtendoo_website_feature_accordion
#: model:ir.ui.view,arch_db:xtendoo_website_feature_accordion.s_feature_accordion
msgid "Empower your team with seamless collaboration tools. Share projects, assign tasks, and communicate in real time — all within a single workspace designed for productivity."
msgstr "Potencia tu equipo con herramientas de colaboración integradas. Comparte proyectos, asigna tareas y comunícate en tiempo real — todo en un único espacio de trabajo diseñado para la productividad."

#. module: xtendoo_website_feature_accordion
#: model:ir.ui.view,arch_db:xtendoo_website_feature_accordion.s_feature_accordion
msgid "Cloud Infrastructure"
msgstr "Infraestructura en la Nube"

#. module: xtendoo_website_feature_accordion
#: model:ir.ui.view,arch_db:xtendoo_website_feature_accordion.s_feature_accordion
msgid "Built on enterprise-grade cloud architecture for maximum uptime and security. Your data is always protected, encrypted, and available whenever you need it."
msgstr "Construida sobre arquitectura en la nube de nivel empresarial para máxima disponibilidad y seguridad. Tus datos siempre protegidos, cifrados y disponibles cuando los necesites."

#. module: xtendoo_website_feature_accordion
#: model:ir.ui.view,arch_db:xtendoo_website_feature_accordion.s_feature_accordion
msgid "Mobile Experience"
msgstr "Experiencia Móvil"

#. module: xtendoo_website_feature_accordion
#: model:ir.ui.view,arch_db:xtendoo_website_feature_accordion.s_feature_accordion
msgid "Access everything on the go. Our fully responsive platform adapts to any device, so you can manage your business from your phone or tablet with ease."
msgstr "Accede a todo en cualquier momento. Nuestra plataforma totalmente adaptable se ajusta a cualquier dispositivo, para que puedas gestionar tu negocio desde tu teléfono o tablet con facilidad."

#. module: xtendoo_website_feature_accordion
#: model:ir.ui.view,arch_db:xtendoo_website_feature_accordion.s_feature_accordion
