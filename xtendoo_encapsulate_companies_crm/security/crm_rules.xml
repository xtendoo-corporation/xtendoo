<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_company_rule" model="ir.rule">
        <field name="name">Crm Lead multi-company</field>
        <field name="model_id" ref="crm.model_crm_lead" />
        <field name="domain_force">
            ['|',
            (user.see_all_companies, '=', True),
            ('company_id', '=', user.company_id.id)
            ]
        </field>
        <field name="global" eval="True" />
    </record>

    <record id="crm_team_company_rule" model="ir.rule">
        <field name="name">Crm Team multi-company</field>
        <field name="model_id" ref="sales_team.model_crm_team" />
        <field name="domain_force">
            ['|',
            (user.see_all_companies, '=', True),
            ('company_id', '=', user.company_id.id)
            ]
        </field>
        <field name="global" eval="True" />
    </record>
</odoo>