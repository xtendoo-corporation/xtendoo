<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_mobile_portal" model="ir.ui.view">
        <field name="name">hr.employee.form.mobile.portal</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="after">
                <page name="mobile_portal" string="Mobile punch"
                      groups="hr_attendance.group_hr_attendance_user">
                    <div class="mb-3">
                        <button name="action_portal_generate_link" type="object"
                                class="btn btn-primary me-2" string="Generate activation link"/>
                        <button name="action_portal_revoke_all" type="object"
                                class="btn btn-secondary" string="Revoke all accesses"
                                confirm="Every device of this employee will be logged out. Continue?"/>
                    </div>
                    <field name="portal_access_ids" readonly="1">
                        <list decoration-muted="state == 'revoked' or is_expired">
                            <field name="create_date" string="Created"/>
                            <field name="state"/>
                            <field name="is_expired"/>
                            <field name="activated_on"/>
                            <field name="last_used"/>
                            <field name="device_info"/>
                            <button name="action_revoke" type="object" string="Revoke" icon="fa-ban"
                                    invisible="state == 'revoked'"/>
                            <button name="action_renew" type="object" string="Renew" icon="fa-refresh"
                                    confirm="The current access will be cancelled and a new activation link will be generated. Continue?"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
