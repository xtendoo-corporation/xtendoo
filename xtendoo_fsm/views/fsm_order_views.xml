<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vista de árbol para órdenes FSM -->
        <record id="view_xtendoo_fsm_order_tree" model="ir.ui.view">
            <field name="name">fsm.order.tree</field>
            <field name="model">fsm.order</field>
            <field name="arch" type="xml">
                <list string="Órdenes de Trabajo">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="location_id"/>
                    <field name="stage_id"/>
                    <field name="tag_ids" widget="many2many_tags"/>
                    <field name="priority_level" widget="priority"/>
                    <field name="responsible_id"/>
                    <field name="date_scheduled"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <!-- Vista de formulario para órdenes FSM -->
        <record id="view_xtendoo_fsm_order_form" model="ir.ui.view">
            <field name="name">fsm.order.form</field>
            <field name="model">fsm.order</field>
            <field name="arch" type="xml">
                <form string="Orden de Trabajo">
                    <header>
                        <button name="action_start_work" string="Iniciar Trabajo"
                                type="object" class="btn-primary"
                                invisible="date_start or is_closed"/>
                        <button name="action_finish_work" string="Finalizar Trabajo"
                                type="object" class="btn-primary"
                                invisible="not date_start or date_end or is_closed"/>
                        <button name="action_create_repair" string="Crear Parte de Reparación"
                                type="object" class="btn-secondary"/>
                        <button name="action_create_sale_order" string="Crear Orden de Venta"
                                type="object" class="btn-secondary"/>
                        <button name="action_print_order" string="Imprimir"
                                type="object" class="btn-secondary"/>
                        <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_repairs" type="object"
                                    class="oe_stat_button" icon="fa-wrench"
                                    invisible="repair_count == 0">
                                <field name="repair_count" widget="statinfo" string="Reparaciones"/>
                            </button>
                            <button name="action_view_sale_orders" type="object"
                                    class="oe_stat_button" icon="fa-shopping-cart"
                                    invisible="sale_count == 0">
                                <field name="sale_count" widget="statinfo" string="Órdenes de Venta"/>
                            </button>
                        </div>

                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>

                        <group>
                            <group name="customer_info" string="Información del Cliente">
                                <field name="partner_id" required="1"/>
                                <field name="contact_id" domain="[('parent_id', '=', partner_id)]"/>
                                <field name="location_id" domain="[('parent_id', '=', partner_id)]"/>
                            </group>
                            <group name="service_info" string="Información del Trabajo">
                                <field name="responsible_id"/>
                                <field name="person_ids" widget="many2many_tags"/>
                                <field name="priority_level" widget="priority"/>
                                <field name="tag_ids" widget="many2many_tags"/>
                            </group>
                        </group>

                        <group>
                            <group name="basic_info" string="Información Básica">
                                <field name="description" placeholder="Describe el trabajo a realizar..."/>
                            </group>
                            <group name="scheduling" string="Programación">
                                <field name="date_scheduled"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="duration" widget="float_time"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Notas">
                                <group>
                                    <field name="internal_note" string="Notas Internas"/>
                                    <field name="customer_note" string="Notas del Cliente"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter reload_on_post="True"/>
                </form>
            </field>
        </record>

        <!-- Vista kanban para órdenes FSM -->
        <record id="view_xtendoo_fsm_order_kanban" model="ir.ui.view">
            <field name="name">fsm.order.kanban</field>
            <field name="model">fsm.order</field>
            <field name="arch" type="xml">
                <kanban default_group_by="stage_id" class="o_kanban_small_column">
                    <field name="stage_id"/>
                    <field name="color"/>
                    <field name="priority_level"/>
                    <field name="partner_id"/>
                    <field name="responsible_id"/>
                    <field name="date_scheduled"/>
                    <templates>
                        <t t-name="menu" groups="base.group_user">
                            <div class="container">
                                <div class="row">
                                    <div name="card_menu_view" class="col-6">
                                        <t t-if="widget.editable">
                                            <a role="menuitem" type="edit" class="dropdown-item">Editar</a>
                                        </t>
                                        <t t-if="widget.deletable">
                                            <a role="menuitem" type="delete" class="dropdown-item">Eliminar</a>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <t t-name="card">
                            <div class="oe_kanban_card oe_kanban_global_click"
                                 t-att-style="record.color.raw_value and 'border-left: 4px solid %s' % record.color.raw_value or ''">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                        <div class="o_kanban_record_body">
                                            <field name="tag_ids" widget="many2many_tags"
                                                   options="{'no_create': True}"/>
                                            <field name="partner_id"/>
                                            <t t-if="record.responsible_id.raw_value">
                                                <br/>
                                                <i class="fa fa-user" title="Técnico responsable"/>
                                                <field name="responsible_id"/>
                                            </t>
                                            <t t-if="record.date_scheduled.raw_value">
                                                <br/>
                                                <i class="fa fa-calendar" title="Fecha programada"/>
                                                <field name="date_scheduled"/>
                                            </t>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="priority_level" widget="priority"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Vista calendario para órdenes FSM -->
        <record id="view_xtendoo_fsm_order_calendar" model="ir.ui.view">
            <field name="name">fsm.order.calendar</field>
            <field name="model">fsm.order</field>
            <field name="arch" type="xml">
                <calendar string="Calendario de Órdenes"
                          date_start="date_scheduled"
                          color="responsible_id">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="responsible_id"/>
                </calendar>
            </field>
        </record>

        <!-- Vista de búsqueda para órdenes FSM -->
        <record id="view_xtendoo_fsm_order_search" model="ir.ui.view">
            <field name="name">fsm.order.search</field>
            <field name="model">fsm.order</field>
            <field name="arch" type="xml">
                <search string="Buscar Órdenes de Trabajo">
                    <field name="name" string="Número"/>
                    <field name="partner_id" string="Cliente"/>
                    <field name="location_id" string="Dirección"/>
                    <field name="responsible_id" string="Técnico"/>
                    <field name="stage_id" string="Etapa"/>
                    <field name="tag_ids" string="Etiquetas"/>

                    <separator/>
                    <filter string="Mis Órdenes" name="my_orders"
                            domain="[('responsible_id.user_id', '=', uid)]"/>
                    <filter string="En Progreso" name="in_progress"
                            domain="[('date_start', '!=', False), ('date_end', '=', False)]"/>
                    <filter string="Cerradas" name="closed"
                            domain="[('is_closed', '=', True)]"/>
                    <filter string="Abiertas" name="open"
                            domain="[('is_closed', '=', False)]"/>

                    <separator/>
                    <filter string="Programadas Hoy" name="today"
                            domain="[('date_scheduled', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                     ('date_scheduled', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                    <filter string="Programadas Esta Semana" name="this_week"
                            domain="[('date_scheduled', '&gt;=', (context_today() - relativedelta(weeks=0, weekday=0)).strftime('%Y-%m-%d 00:00:00')),
                                     ('date_scheduled', '&lt;=', (context_today() + relativedelta(weeks=0, weekday=6)).strftime('%Y-%m-%d 23:59:59'))]"/>

                    <group expand="0" string="Agrupar Por">
                        <filter string="Cliente" name="group_partner"
                                context="{'group_by': 'partner_id'}"/>
                        <filter string="Técnico" name="group_responsible"
                                context="{'group_by': 'responsible_id'}"/>
                        <filter string="Etapa" name="group_stage"
                                context="{'group_by': 'stage_id'}"/>
                        <filter string="Prioridad" name="group_priority"
                                context="{'group_by': 'priority_level'}"/>
                        <filter string="Fecha Programada" name="group_date_scheduled"
                                context="{'group_by': 'date_scheduled'}"/>
                    </group>
                </search>
            </field>
        </record>

    </data>
</odoo>
