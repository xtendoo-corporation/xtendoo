<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vista de lista para etiquetas -->
        <record id="view_xtendoo_fsm_tag_tree" model="ir.ui.view">
            <field name="name">xtendoo.fsm.tag.tree</field>
            <field name="model">xtendoo.fsm.tag</field>
            <field name="arch" type="xml">
                <list string="Etiquetas de Trabajo">
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Vista de formulario para etiquetas -->
        <record id="view_xtendoo_fsm_tag_form" model="ir.ui.view">
            <field name="name">xtendoo.fsm.tag.form</field>
            <field name="model">xtendoo.fsm.tag</field>
            <field name="arch" type="xml">
                <form string="Etiqueta de Trabajo">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
