<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Acción para órdenes FSM -->
        <record id="action_xtendoo_fsm_order" model="ir.actions.act_window">
            <field name="name">Órdenes de Trabajo</field><field name="res_model">fsm.order</field>
            <field name="view_mode">kanban,list,form,calendar</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear nueva orden de trabajo
                </p>
                <p>
                    Las órdenes de trabajo permiten gestionar el trabajo en las instalaciones del cliente.
                </p>
            </field>
        </record>

        <!-- Acción para Técnicos (Empleados) -->
        <record id="action_xtendoo_fsm_person" model="ir.actions.act_window">
            <field name="name">Técnicos</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">list,form,kanban</field>
            <field name="context">{}</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear nuevo técnico
                </p>
                <p>
                    Los técnicos son empleados especializados en órdenes de trabajo.
                </p>
            </field>
        </record>

        <!-- Acción para Etapas -->
        <record id="action_xtendoo_fsm_stage" model="ir.actions.act_window">
            <field name="name">Etapas de Trabajo</field>
            <field name="res_model">fsm.stage</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear nueva etapa
                </p>
                <p>
                    Las etapas definen el flujo de trabajo de las órdenes de trabajo.
                </p>
            </field>
        </record>

        <!-- Acción para Etiquetas -->
        <record id="action_xtendoo_fsm_tag" model="ir.actions.act_window">
            <field name="name">Etiquetas de Trabajo</field>
            <field name="res_model">fsm.tag</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear nueva etiqueta
                </p>
                <p>
                    Las etiquetas permiten categorizar las órdenes de trabajo.
                </p>
            </field>
        </record>

    </data>
</odoo>
