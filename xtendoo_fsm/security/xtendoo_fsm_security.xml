<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Grupos de seguridad -->
        <record id="group_fsm_user" model="res.groups">
            <field name="name">FSM Usuario</field>
            <field name="category_id" ref="base.module_category_services"/>
            <field name="comment">Usuario básico de servicios de campo</field>
        </record>

        <record id="group_fsm_manager" model="res.groups">
            <field name="name">FSM Manager</field>
            <field name="category_id" ref="base.module_category_services"/>
            <field name="implied_ids" eval="[(4, ref('group_fsm_user'))]"/>
            <field name="comment">Manager de servicios de campo</field>
        </record>

        <!-- Reglas de acceso simplificadas - temporalmente menos restrictivas -->
        <record id="fsm_order_rule_all" model="ir.rule">
            <field name="name">FSM Order: Acceso completo para usuarios FSM</field>
            <field name="model_id" ref="model_fsm_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_fsm_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Regla para etapas -->
        <record id="fsm_stage_rule_all" model="ir.rule">
            <field name="name">FSM Stage: Acceso completo</field>
            <field name="model_id" ref="model_fsm_stage"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_fsm_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Regla para etiquetas -->
        <record id="fsm_tag_rule_all" model="ir.rule">
            <field name="name">FSM Tag: Acceso completo</field>
            <field name="model_id" ref="model_fsm_tag"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_fsm_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
