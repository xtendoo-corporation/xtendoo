<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_minimum_notification_form" model="ir.ui.view">
        <field name="name">stock.minimum.notification.form</field>
        <field name="model">stock.minimum.notification</field>
        <field name="arch" type="xml">
            <form string="Notificación de Stock Mínimo">
                <header>
                    <button name="action_check_stock_now"
                            string="Verificar stock ahora"
                            type="object"
                            class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="min_quantity"/>
                        <field name="location_id"/>
                        <field name="notify_user_ids" widget="many2many_tags"/>
                        <field name="last_notification" readonly="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_stock_minimum_notification_tree" model="ir.ui.view">
        <field name="name">stock.minimum.notification.tree</field>
        <field name="model">stock.minimum.notification</field>
        <field name="arch" type="xml">
            <tree string="Notificaciones de Stock Mínimo">
                <field name="name"/>
                <field name="min_quantity"/>
                <field name="location_id"/>
                <field name="last_notification"/>
            </tree>
        </field>
    </record>

    <record id="action_stock_minimum_notification" model="ir.actions.act_window">
        <field name="name">Notificaciones de Stock Mínimo</field>
        <field name="res_model">stock.minimum.notification</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_stock_minimum_notification"
              name="Notificaciones de Stock"
              parent="stock.menu_stock_config_settings"
              action="action_stock_minimum_notification"
              sequence="100"/>
</odoo>
