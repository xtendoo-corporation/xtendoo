<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_notification_wizard_form" model="ir.ui.view">
        <field name="name">stock.notification.wizard.form</field>
        <field name="model">stock.notification.wizard</field>
        <field name="arch" type="xml">
            <form string="Productos con Stock Bajo">
                <sheet>
                    <group>
                        <field name="product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <footer>
                        <button name="action_view_products" string="Ver detalles" type="object" class="btn-primary"/>
                        <button string="Cerrar" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_stock_notification_wizard" model="ir.actions.act_window">
        <field name="name">Productos con Stock Bajo</field>
        <field name="res_model">stock.notification.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
