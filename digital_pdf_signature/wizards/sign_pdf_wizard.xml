<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sign_pdf_wizard_form" model="ir.ui.view">
        <field name="name">sign.pdf.wizard.form</field>
        <field name="model">sign.pdf.wizard</field>
        <field name="arch" type="xml">
            <form string="Firmar PDF">
                <sheet>
                    <group>
                        <field name="pdf_file" widget="binary" filename="pdf_filename"/>
                        <field name="pdf_filename" invisible="1"/>
                        <field name="certificate_id" options="{'no_create': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_sign_pdf" string="Firmar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sign_pdf_wizard" model="ir.actions.act_window">
        <field name="name">Firmar PDF</field>
        <field name="res_model">sign.pdf.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_sign_pdf_wizard"
              name="Firmar PDF"
              action="action_sign_pdf_wizard"
              parent="certificate.certificate_root_menu"
              sequence="10"/>
</odoo>
