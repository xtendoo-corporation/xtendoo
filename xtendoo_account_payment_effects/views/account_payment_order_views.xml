<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_payment_order_form_xtd_effects" model="ir.ui.view">
        <field name="name">account.payment.order.form.xtd.effects</field>
        <field name="model">account.payment.order</field>
        <field name="inherit_id" ref="account_payment_batch_oca.account_payment_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(account_payment_batch_oca.account_payment_line_create_action)d']" position="attributes">
                <attribute name="invisible">state != 'draft' or xtd_source_type == 'existing_payments'</attribute>
            </xpath>
            <xpath expr="//button[@name='%(account_payment_batch_oca.account_payment_line_create_action)d']" position="after">
                <button
                    name="xtd_action_import_existing_payments"
                    type="object"
                    string="Importar pagos existentes"
                    invisible="state != 'draft' or not xtd_manage_effects_method"
                />
                <button
                    name="xtd_action_confirm_existing_payments"
                    type="object"
                    string="Confirmar pagos"
                    class="oe_highlight"
                    invisible="state != 'draft' or xtd_source_type != 'existing_payments' or not xtd_existing_payment_ids"
                />
            </xpath>
            <xpath expr="//button[@name='draft2open']" position="attributes">
                <attribute name="invisible">state != 'draft' or xtd_source_type == 'existing_payments'</attribute>
            </xpath>
            <xpath expr="//button[@name='open2generated']" position="attributes">
                <attribute name="invisible">state != 'open' or xtd_source_type == 'existing_payments'</attribute>
            </xpath>
            <xpath expr="//button[@name='generated2uploaded']" position="attributes">
                <attribute name="invisible">state != 'generated' or xtd_source_type == 'existing_payments'</attribute>
            </xpath>
            <field name="payment_method_line_id" position="after">
                <field name="xtd_source_type" readonly="1" />
                <field name="xtd_manage_effects_method" invisible="1" />
            </field>
            <field name="journal_id" position="attributes">
                <attribute name="invisible">xtd_manage_effects_method</attribute>
            </field>
            <field name="journal_id" position="after">
                <field
                    name="xtd_bank_journal_id"
                    string="Diario de banco"
                    invisible="not xtd_manage_effects_method"
                    readonly="state != 'draft'"
                />
            </field>
            <xpath
                expr="//page[@name='payment-lines'][field[@name='payment_line_ids']]"
                position="attributes"
            >
                <attribute name="invisible">xtd_source_type == 'existing_payments'</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page
                    name="xtd_existing_payments"
                    string="Pagos existentes"
                    invisible="xtd_source_type != 'existing_payments' or state != 'draft'"
                >
                    <group>
                        <field name="xtd_deposit_date" readonly="state != 'draft'" />
                    </group>
                    <field
                        name="xtd_existing_payment_ids"
                        nolabel="1"
                        readonly="state != 'draft'"
                        domain="[
                            ('payment_type', '=', 'inbound'),
                            ('partner_type', '=', 'customer'),
                            ('payment_lot_id', '=', False),
                            ('payment_order_id', '=', False),
                            ('is_matched', '=', False),
                            ('state', 'not in', ['draft', 'canceled', 'rejected']),
                            ('company_id', '=', company_id),
                            ('journal_id', '=', journal_id),
                            ('payment_method_line_id.xtd_manage_effects', '=', True),
                        ]"
                    >
                        <list>
                            <field name="name" />
                            <field name="payment_reference" string="Referencia" />
                            <field name="partner_id" string="Cliente" />
                            <field name="payment_method_line_id" string="Método" />
                            <field name="date" string="Fecha" />
                            <field name="xtd_effect_due_date" string="Vencimiento" optional="show" />
                            <field name="amount" string="Importe" sum="Total" />
                            <field name="currency_id" column_invisible="1" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="account_payment_order_tree_xtd_effects" model="ir.ui.view">
        <field name="name">account.payment.order.list.xtd.effects</field>
        <field name="model">account.payment.order</field>
        <field name="inherit_id" ref="account_payment_batch_oca.account_payment_order_tree" />
        <field name="arch" type="xml">
            <field name="payment_method_line_id" position="after">
                <field name="xtd_source_type" optional="show" />
            </field>
        </field>
    </record>

    <record id="account_payment_order_search_xtd_effects" model="ir.ui.view">
        <field name="name">account.payment.order.search.xtd.effects</field>
        <field name="model">account.payment.order</field>
        <field name="inherit_id" ref="account_payment_batch_oca.account_payment_order_search" />
        <field name="arch" type="xml">
            <group name="groupby" position="before">
                <filter
                    name="xtd_effect_methods"
                    string="Métodos de efectos"
                    domain="[('payment_method_line_id.xtd_manage_effects', '=', True)]"
                />
                <filter
                    name="xtd_existing_payments"
                    string="Pagos existentes"
                    domain="[('xtd_source_type', '=', 'existing_payments')]"
                />
            </group>
            <group name="groupby" position="inside">
                <filter name="xtd_source_type_groupby" string="Origen" context="{'group_by': 'xtd_source_type'}" />
            </group>
        </field>
    </record>

    <record id="xtd_account_payment_effect_order_action" model="ir.actions.act_window">
        <field name="name">Remesas de efectos</field>
        <field name="res_model">account.payment.order</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="domain">[('payment_type', '=', 'inbound'), ('payment_method_line_id.xtd_manage_effects', '=', True)]</field>
        <field name="context">{'default_payment_type': 'inbound', 'search_default_xtd_effect_methods': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree una remesa o depósito para un método de efectos.
            </p>
            <p>
                Desde la orden podrá seleccionar facturas o apuntes pendientes del método de pago mediante el flujo estándar de OCA,
                o usar "Importar pagos existentes" para agrupar pagos ya registrados con ese mismo diario.
            </p>
        </field>
    </record>
</odoo>


