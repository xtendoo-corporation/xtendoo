<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_payment_remesa_form" model="ir.ui.view">
        <field name="name">account.payment.remesa.form</field>
        <field name="model">account.payment.remesa</field>
        <field name="arch" type="xml">
            <form string="Remesa de efectos">
                <header>
                    <button
                        name="action_fetch_eligible_payments"
                        type="object"
                        string="Obtener pagos pendientes"
                        invisible="state != 'draft' or not payment_method_line_id"
                    />
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirmar remesa"
                        class="oe_highlight"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_draft"
                        type="object"
                        string="Volver a borrador"
                        invisible="state != 'confirmed'"
                        confirm="Esto deshará la conciliación bancaria de esta remesa. ¿Continuar?"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'" />
                            <field
                                name="payment_method_line_id"
                                readonly="state != 'draft' or payment_ids"
                            />
                            <field name="journal_id" readonly="state != 'draft'" />
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'" />
                            <field name="currency_id" invisible="1" />
                            <field name="payment_count" />
                            <field name="amount_total" />
                            <field name="statement_line_id" invisible="not statement_line_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Pagos" name="payments">
                            <field
                                name="payment_ids"
                                widget="many2many"
                                readonly="state != 'draft' or not payment_method_line_id"
                                options="{'no_create': True}"
                            >
                                <list create="false" open_form_view="True">
                                    <field name="date" string="Fecha" readonly="1" />
                                    <field name="name" string="Número" readonly="1" />
                                    <field name="partner_id" string="Cliente" readonly="1" />
                                    <field name="payment_reference" string="Referencia" readonly="1" />
                                    <field name="invoice_ids" string="Facturas" widget="many2many_tags" optional="show" />
                                    <field name="xtd_effect_due_date" string="Vencimiento" optional="show" readonly="1" />
                                    <field name="amount" string="Importe" sum="Total" readonly="1" />
                                    <field name="currency_id" column_invisible="1" />
                                    <field name="state" string="Estado" widget="badge" optional="hide" readonly="1" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="account_payment_remesa_list" model="ir.ui.view">
        <field name="name">account.payment.remesa.list</field>
        <field name="model">account.payment.remesa</field>
        <field name="arch" type="xml">
            <list string="Remesas de efectos">
                <field name="name" />
                <field name="date" />
                <field name="payment_method_line_id" />
                <field name="journal_id" />
                <field name="payment_count" />
                <field name="amount_total" sum="Total" />
                <field name="currency_id" column_invisible="1" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>

    <record id="account_payment_remesa_search" model="ir.ui.view">
        <field name="name">account.payment.remesa.search</field>
        <field name="model">account.payment.remesa</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="payment_method_line_id" />
                <field name="journal_id" />
                <filter name="draft" string="Borrador" domain="[('state', '=', 'draft')]" />
                <filter name="confirmed" string="Confirmada" domain="[('state', '=', 'confirmed')]" />
                <group name="groupby">
                    <filter name="group_method" string="Método de pago" context="{'group_by': 'payment_method_line_id'}" />
                    <filter name="group_journal" string="Diario" context="{'group_by': 'journal_id'}" />
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}" />
                    <filter name="group_date" string="Fecha" context="{'group_by': 'date'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="account_payment_remesa_action" model="ir.actions.act_window">
        <field name="name">Remesas de efectos</field>
        <field name="res_model">account.payment.remesa</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree una remesa para depositar en el banco los efectos de cobro
                registrados (pagarés, cheques, etc).
            </p>
            <p>
                Registre primero el cobro desde la factura con un método de pago
                configurado como "efecto de cobro", y añada después el pago a una
                remesa. Al confirmar la remesa, el importe pasa al diario de banco
                y las facturas quedan pagadas.
            </p>
        </field>
    </record>
</odoo>
