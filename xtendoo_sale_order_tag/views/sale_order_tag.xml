<odoo>
    <record id="sale_order_tag_list_view" model="ir.ui.view">
        <field name="name">sale.order.tag.list</field>
        <field name="model">sale.order.tag</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="sequence" widget="handle" />
                <field name="name" string="Nombre"/>
                <field name="description" string="Descripción"/>
                <field name="team_ids" widget="many2many_tags" string="Equipos de ventas"/>
                <field name="company_id" string="Compañía"/>
            </list>
        </field>
    </record>
    <record id="sale_order_tag_form_view" model="ir.ui.view">
        <field name="name">sale.order.tag.form</field>
        <field name="model">sale.order.tag</field>
        <field name="arch" type="xml">
            <form string="Sale Order Tags">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="active" invisible="1" />
                        <widget
                            name="web_ribbon"
                            title="Archived"
                            bg_color="bg-danger"
                            invisible="active"
                        />
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Name" />
                        <h1>
                            <field name="name" string="Nombre"/>
                        </h1>
                    </div>
                    <group>
                        <field name="team_ids" widget="many2many_tags"  string="Equipos de venta"/>
                        <field name="company_id" string="Compañía"/>
                    </group>
                    <group>
                        <field name="description" string="Descripción"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sale_order_tag_action" model="ir.actions.act_window">
        <field name="name">Etiquetas de pedidos de venta</field>
        <field name="res_model">sale.order.tag</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        name="Etiquetas de pedidos de venta"
        id="sale_order_tag_menu"
        parent="sale.menu_sales_config"
        action="sale_order_tag_action"
        sequence="20"
    />
</odoo>
