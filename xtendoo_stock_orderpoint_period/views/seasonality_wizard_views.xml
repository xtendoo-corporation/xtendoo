<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         Vista FORM del wizard de estacionalidad
         ═══════════════════════════════════════════════════════════════ -->
    <record id="view_seasonality_wizard_form" model="ir.ui.view">
        <field name="name">stock.orderpoint.seasonality.wizard.form</field>
        <field name="model">stock.orderpoint.seasonality.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Orderpoints Estacionales">
                <group>
                    <group string="Parámetros">
                        <field name="company_id" groups="base.group_multi_company"
                            options="{'no_create': True}" />
                        <field name="warehouse_id" options="{'no_create': True}" />
                        <field name="location_id" options="{'no_create': True}" />
                        <field name="year_reference" />
                        <field name="target_year" />
                        <field name="all_year" />
                        <field name="month_ids" widget="many2many_tags"
                            invisible="all_year"
                            options="{'no_create': True}" />
                    </group>
                    <group string="Filtros y Ajustes">
                        <field name="product_ids" widget="many2many_tags"
                            options="{'no_create': True}" />
                        <field name="categ_id" options="{'no_create': True}" />
                        <field name="factor_pct" />
                        <field name="simulation" />
                    </group>
                </group>
                <notebook>
                    <page string="Preview" name="page_preview">
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom" create="false" delete="false">
                                <field name="product_id" />
                                <field name="month_name" string="Mes" />
                                <field name="demand_qty" />
                                <field name="factor_pct" string="Factor (%)" />
                                <field name="suggested_min_qty" />
                                <field name="date_start" />
                                <field name="date_end" />
                                <field name="action_flag" string="Acción"
                                    decoration-success="action_flag == 'create'"
                                    decoration-info="action_flag == 'update'" />
                                <field name="existing_orderpoint_id"
                                    string="Regla existente" />
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_compute_preview" string="Calcular Preview"
                        type="object" class="btn-primary"
                        icon="fa-calculator" />
                    <button name="action_apply" string="Aplicar"
                        type="object" class="btn-success"
                        icon="fa-check"
                        confirm="¿Estás seguro de crear/actualizar los orderpoints?" />
                    <button string="Cerrar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Acción para abrir el wizard
         ═══════════════════════════════════════════════════════════════ -->
    <record id="action_seasonality_wizard" model="ir.actions.act_window">
        <field name="name">Generar Orderpoints Estacionales</field>
        <field name="res_model">stock.orderpoint.seasonality.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_seasonality_wizard_form" />
        <field name="target">new</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Menú de acceso al wizard
         Ruta: Inventario → Operaciones → Generar Orderpoints Estacionales
         ═══════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_seasonality_wizard"
        name="Generar Orderpoints Estacionales"
        parent="stock.menu_stock_procurement"
        action="action_seasonality_wizard"
        sequence="20"
        groups="stock.group_stock_manager" />

</odoo>