<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="xtendoo_stock_barcode.PickingClientAction">
        <div class="o_action h-100 overflow-auto bg-light o_xtendoo_stock_barcode" style="padding-bottom: 200px;">
            <div class="container-fluid py-3">
                <div t-if="state.loading" class="text-center mt-5">
                    <i class="fa fa-circle-o-notch fa-spin fa-3x fa-fw text-primary"/>
                    <span class="sr-only">Cargando...</span>
                </div>
                <t t-else="">
                    <div class="card shadow-sm border-0 mb-3">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h2 class="h3 mb-2">
                                        <t t-esc="state.picking.name"/>
                                        <i t-if="state.updating" class="fa fa-circle-o-notch fa-spin text-muted ms-2 fs-5"/>
                                    </h2>
                                    <div class="mb-3 d-flex gap-2">
                                        <span class="badge bg-primary fs-6 shadow-sm"><t t-esc="state.picking.picking_type_code"/></span>
                                        <span t-if="state.picking.state === 'assigned'"
                                              class="badge bg-success fs-6 shadow-sm">Preparado</span>
                                    </div>
                                    <div t-if="state.picking.location_dest_name" class="text-muted fs-5">
                                        <i class="fa fa-map-marker me-1"/>
                                        Recibiendo en:
                                        <span class="fw-bold text-dark"><t t-esc="state.picking.location_dest_name"/></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white fw-bold">
                            Líneas de Movimiento
                        </div>
                        <div class="list-group list-group-flush">
                            <t t-foreach="state.picking.lines" t-as="line" t-key="line.id">
                                <div class="list-group-item p-3">
                                    <div class="container-fluid p-0">
                                        <!-- Primera línea: Nombre del producto -->
                                        <div class="row g-0 mb-2">
                                            <div class="col-12 fw-bold fs-5"><t t-esc="line.product_name"/></div>
                                        </div>
                                        <!-- Segunda línea: Barcode y Ubicación Destino -->
                                        <div class="row g-0 mb-3 align-items-center text-muted">
                                            <div class="col-6">
                                                <i class="fa fa-barcode me-1"/> <t t-esc="line.product_barcode || 'Sin código'"/>
                                            </div>
                                            <div class="col-6 text-end">
                                                <i class="fa fa-map-marker me-1"/> <t t-esc="line.location_dest_name"/>
                                            </div>
                                        </div>
                                        <!-- Tercera línea: Cantidades y Botones -->
                                        <div class="row g-0 align-items-center">
                                            <div class="col-4">
                                                <div class="fw-bold fs-2" t-att-class="line.qty_done === line.qty_demand ? 'text-primary' : (line.qty_done &gt; line.qty_demand ? 'text-warning' : 'text-primary')">
                                                    <t t-esc="line.qty_done"/> <small class="text-muted">/</small> <t t-esc="line.qty_demand"/>
                                                </div>
                                            </div>
                                            <div class="col-8">
                                                <div class="d-flex justify-content-end gap-2 align-items-center">
                                                    <div class="input-group input-group-sm w-auto border rounded overflow-hidden">
                                                        <span class="input-group-text bg-light text-muted border-0 small px-2">Cantidad +/-</span>
                                                        <input type="number" class="form-control text-center fw-bold border-0 p-0"
                                                               style="width: 50px; height: 38px; min-width: 50px;"
                                                               t-model="line.input_qty"/>
                                                    </div>
                                                    <button class="btn btn-outline-danger fw-bold px-3 py-2"
                                                            t-on-click="() => this.resetLine(line)">
                                                        0
                                                    </button>
                                                    <button class="btn btn-outline-danger fw-bold px-3 py-2"
                                                            t-on-click="() => this.adjustQty(line, -line.input_qty)">
                                                        -<t t-esc="line.input_qty"/>
                                                    </button>
                                                    <button class="btn btn-outline-success fw-bold px-3 py-2"
                                                            t-on-click="() => this.adjustQty(line, line.input_qty)">
                                                        +<t t-esc="line.input_qty"/>
                                                    </button>
                                                    <button t-if="line.qty_done &lt; line.qty_demand"
                                                            class="btn btn-outline-success fw-bold px-3 py-2"
                                                            t-on-click="() => this.completeLine(line)">
                                                        <i class="fa fa-check"/>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
            <!-- Botones estáticos abajo -->
            <div t-if="!state.loading" class="fixed-bottom bg-white border-top w-100 shadow-lg">
                <div t-if="state.lastMessage" class="px-3 py-3 border-bottom border-top border-3"
                     t-att-class="state.lastMessageSuccess ? (state.isWarning ? 'bg-warning-subtle text-warning-emphasis border-warning' : 'bg-success-subtle text-success-emphasis border-success') : 'bg-danger-subtle text-danger-emphasis border-danger'">
                    <div class="d-flex align-items-baseline">
                        <i t-att-class="state.lastMessageSuccess ? (state.isWarning ? 'fa fa-exclamation-triangle' : 'fa fa-check-circle') : 'fa fa-exclamation-triangle'" class="me-2 fs-5"/>
                        <div class="flex-grow-1">
                            <span class="fw-bold fs-5"><t t-esc="state.lastMessage"/></span>
                        </div>
                        <button class="btn btn-sm p-0 ms-2" t-on-click="() => state.lastMessage = false">
                            <i class="fa fa-times fs-5 opacity-50"/>
                        </button>
                    </div>
                </div>
                <div class="p-3 d-flex gap-2 w-100">
                    <button class="btn btn-secondary flex-grow-1 py-3 fw-bold" t-on-click="exitAction">
                        SALIR
                    </button>
                    <button class="btn btn-primary flex-grow-1 py-3 fw-bold" t-on-click="validatePicking"
                            t-att-disabled="state.picking.state === 'done'">
                        <i class="fa fa-check"/>
                        Validar
                    </button>
                </div>
            </div>
        </div>
    </t>
</templates>
