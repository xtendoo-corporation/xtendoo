<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="xtendoo_stock_barcode.PickingClientAction">
        <div class="o_action h-100 overflow-auto bg-light">
            <div class="container-fluid py-3">
                <div t-if="state.loading" class="text-center mt-5">
                    <i class="fa fa-circle-o-notch fa-spin fa-3x fa-fw text-primary"/>
                    <span class="sr-only">Cargando...</span>
                </div>
                <t t-else="">
                    <div class="card shadow-sm border-0 mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h2 class="h4 mb-1"><t t-esc="state.picking.name"/></h2>
                                    <span class="badge bg-primary"><t t-esc="state.picking.picking_type_code"/></span>
                                    <span t-if="state.picking.state === 'assigned'" class="badge bg-success ms-1">Preparado</span>
                                </div>
                                <div>
                                    <button class="btn btn-primary" t-on-click="validatePicking" t-att-disabled="state.picking.state === 'done'">
                                        Validar
                                    </button>
                                    <button class="btn btn-outline-secondary ms-2" t-on-click="exitAction">
                                        Salir
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div t-if="state.lastMessage" class="alert mb-3" t-att-class="state.lastMessageSuccess ? 'alert-success' : 'alert-danger'">
                        <t t-esc="state.lastMessage"/>
                    </div>

                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white fw-bold">
                            Líneas de Movimiento
                        </div>
                        <div class="list-group list-group-flush">
                            <t t-foreach="state.picking.lines" t-as="line" t-key="line.id">
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <div class="fw-bold"><t t-esc="line.product_name"/></div>
                                            <div class="text-muted small">
                                                <i class="fa fa-barcode me-1"/> <t t-esc="line.product_barcode || 'Sin código'"/>
                                            </div>
                                            <div class="text-muted small">
                                                <i class="fa fa-map-marker me-1"/> <t t-esc="line.location_name"/> <i class="fa fa-arrow-right mx-1"/> <t t-esc="line.location_dest_name"/>
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <div class="fw-bold fs-5" t-att-class="line.qty_done === line.qty_demand ? 'text-success' : (line.qty_done > line.qty_demand ? 'text-danger' : 'text-primary')">
                                                <t t-esc="line.qty_done"/> / <t t-esc="line.qty_demand"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
