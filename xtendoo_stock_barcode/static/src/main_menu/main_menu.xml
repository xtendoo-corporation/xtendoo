<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="xtendoo_stock_barcode.MainMenu">
        <div class="o_action h-100 overflow-auto">
            <div class="container py-4 py-lg-5">
                <div class="row justify-content-center">
                    <div class="col-12 col-xl-9">
                        <div class="card shadow-sm border-0">
                            <div class="card-body p-4 p-lg-5">
                                <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
                                    <div>
                                        <h1 class="h3 mb-2">Xtendoo Barcode</h1>
                                        <p class="text-muted mb-0">
                                            Menú principal clásico para abrir o crear operaciones escaneando códigos.
                                        </p>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2">
                                        <button type="button" class="btn btn-primary" t-on-click="openManualBarcodeDialog">
                                            Escaneo manual
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary" t-on-click="openPickingsAction">
                                            Operaciones
                                        </button>
                                    </div>
                                </div>

                                <div class="alert alert-info mb-4" role="alert">
                                    <div class="fw-semibold mb-2">Qué puedes hacer desde aquí</div>
                                    <ul class="mb-0 ps-3">
                                        <t t-foreach="helperBullets" t-as="bullet" t-key="bullet">
                                            <li><t t-esc="bullet"/></li>
                                        </t>
                                    </ul>
                                </div>

                                <div class="row g-3 mb-4">

                                    <div class="col-md-6">
                                        <button type="button" class="btn btn-outline-primary w-100 py-3" t-on-click="openIncomingAction">
                                            Entradas
                                        </button>
                                    </div>
                                    <div class="col-md-6">
                                        <button type="button" class="btn btn-outline-primary w-100 py-3" t-on-click="openInternalAction">
                                            Transferencias internas
                                        </button>
                                    </div>
                                </div>

                                <div class="border rounded p-3 bg-light">
                                    <div class="fw-semibold mb-2">Última lectura</div>
                                    <div class="small text-muted" t-if="!state.lastBarcode and !state.lastMessage">
                                        Esperando un escaneo desde el lector o el botón de escaneo manual.
                                    </div>
                                    <t t-if="state.lastBarcode or state.lastMessage">
                                        <div class="mb-1">
                                            <span class="text-muted">Código:</span>
                                            <span class="fw-semibold ms-1"><t t-esc="state.lastBarcode or '-'"/></span>
                                        </div>
                                        <div>
                                            <span class="text-muted">Resultado:</span>
                                            <span class="ms-1"><t t-esc="state.lastMessage or '-'"/></span>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>

