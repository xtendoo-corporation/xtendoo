<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <function model="stock.picking.type" name="write">
            <value model="stock.picking.type" search="[('code', '=', 'outgoing')]"/>
            <value eval="{
                'xt_barcode_restrict_scan_source_location': 'mandatory',
                'xt_barcode_restrict_scan_dest_location': 'no'
            }"/>
        </function>
    </data>
</odoo>

