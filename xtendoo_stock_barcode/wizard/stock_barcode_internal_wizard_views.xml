<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_barcode_internal_wizard_form" model="ir.ui.view">
        <field name="name">stock.barcode.internal.wizard.form</field>
        <field name="model">stock.barcode.internal.wizard</field>
        <field name="arch" type="xml">
            <form string="Seleccionar Almacén">
                <group>
                    <field name="warehouse_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_continue" string="Continuar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_barcode_internal_wizard" model="ir.actions.act_window">
        <field name="name">Seleccionar Almacén</field>
        <field name="res_model">stock.barcode.internal.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

