<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_xtendoo_stock_barcode_main_menu" model="ir.actions.client">
        <field name="name">Transferencias internas</field>
        <field name="tag">xtendoo_stock_barcode_main_menu</field>
        <field name="target">current</field>
    </record>

    <record id="action_xtendoo_stock_barcode_picking_list" model="ir.actions.client">
        <field name="name">Listado de Operaciones</field>
        <field name="tag">xtendoo_stock_barcode_picking_list</field>
        <field name="target">current</field>
    </record>

    <record id="action_xtendoo_stock_barcode_pickings" model="ir.actions.act_window">
        <field name="name">Transferencias internas</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[("picking_type_code", "in", ["incoming", "outgoing", "internal"])]</field>
        <field name="context">{'search_default_available': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea o abre una operación de almacén para escanearla con Transferencias internas.
            </p>
            <p>
                Este acceso abre los albaranes compatibles con el flujo clásico de escaneo sin interfaz Owl propia.
            </p>
        </field>
    </record>

    <record id="action_xtendoo_stock_barcode_incoming" model="ir.actions.act_window">
        <field name="name">Entradas</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[("picking_type_code", "=", "incoming"), ("picking_type_id.warehouse_id.tp_is_central_request_hub", "=", True)]</field>
        <field name="context">{'search_default_available': 1}</field>
    </record>

    <record id="action_xtendoo_stock_barcode_outgoing" model="ir.actions.act_window">
        <field name="name">Salidas</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[("picking_type_code", "=", "outgoing")]</field>
        <field name="context">{'search_default_available': 1}</field>
    </record>

    <record id="action_xtendoo_stock_barcode_internal" model="ir.actions.act_window">
        <field name="name">Internas</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[("picking_type_code", "=", "internal")]</field>
        <field name="context">{'search_default_available': 1}</field>
    </record>

    <menuitem
        id="menu_xtendoo_stock_barcode_root"
        name="Transferencias internas"
        sequence="65"
        action="action_xtendoo_stock_barcode_main_menu"
        web_icon="xtendoo_stock_barcode,static/description/app_icon.png"
    />
</odoo>
