<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_xtendoo_stock_barcode" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.xtendoo.stock.barcode</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="_barcode_scanned" widget="barcode_handler" class="d-none"/>
                <field name="xt_barcode_supported" invisible="1"/>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_xt_barcode_open_pda"
                        type="object"
                        string="Comprobación PDA"
                        class="btn btn-primary"
                        invisible="not xt_barcode_supported"/>
            </xpath>

        </field>
    </record>

</odoo>
