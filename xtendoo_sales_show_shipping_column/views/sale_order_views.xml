<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order Tree View - Base view that will apply to all sale orders and quotations -->
    <record id="sale_order_tree_inherit_shipping" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.shipping</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
            </xpath>
        </field>
    </record>
</odoo>

