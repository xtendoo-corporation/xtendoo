<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Customer Invoice Tree View -->
    <record id="view_invoice_tree_inherit_shipping" model="ir.ui.view">
        <field name="name">account.move.invoice.tree.inherit.shipping</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="shipping_address_display" string="Shipping Address" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Out Invoice Tree View -->
    <record id="view_out_invoice_tree_inherit_shipping" model="ir.ui.view">
        <field name="name">account.move.out.invoice.tree.inherit.shipping</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="shipping_address_display" string="Shipping Address" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>

