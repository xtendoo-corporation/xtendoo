<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_xtd_ai_audit_list" model="ir.ui.view">
        <field name="name">xtd.ai.audit.list</field>
        <field name="model">xtd.ai.audit</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date" />
                <field name="user_id" />
                <field name="event" />
                <field name="tool_name" />
                <field name="outcome" />
                <field name="error_code" />
                <field name="duration_ms" />
            </list>
        </field>
    </record>

    <record id="view_xtd_ai_audit_form" model="ir.ui.view">
        <field name="name">xtd.ai.audit.form</field>
        <field name="model">xtd.ai.audit</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" />
                            <field name="user_id" />
                            <field name="company_id" />
                            <field name="run_id" />
                        </group>
                        <group>
                            <field name="event" />
                            <field name="tool_name" />
                            <field name="outcome" />
                            <field name="error_code" />
                            <field name="duration_ms" />
                        </group>
                    </group>
                    <group>
                        <field name="arguments" />
                        <field name="record_refs" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_xtd_ai_audit_search" model="ir.ui.view">
        <field name="name">xtd.ai.audit.search</field>
        <field name="model">xtd.ai.audit</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id" />
                <field name="tool_name" />
                <filter
                    name="denied"
                    string="Denegadas"
                    domain="[('outcome', '=', 'denied')]"
                />
                <filter
                    name="errors"
                    string="Con error"
                    domain="[('outcome', '=', 'error')]"
                />
                <group>
                    <filter
                        name="group_user"
                        string="Usuario"
                        context="{'group_by': 'user_id'}"
                    />
                    <filter
                        name="group_event"
                        string="Evento"
                        context="{'group_by': 'event'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_xtd_ai_audit" model="ir.actions.act_window">
        <field name="name">Auditoría del agente IA</field>
        <field name="res_model">xtd.ai.audit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
