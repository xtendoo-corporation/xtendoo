<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_xtd_ai" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.xtd_ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
          data-string="Agente IA"
          string="Agente IA"
          name="xtd_ai"
          groups="xtd_ai.group_xtd_ai_manager"
        >
                    <block
            title="Permisos del agente en esta compañía"
            name="xtd_ai_policy"
          >
                        <setting
              string="Perfil"
              help="Qué hace el agente directamente (con «Deshacer»), qué pide tarjeta y qué deja preparado. Publicar o contabilizar siempre lo termina el usuario."
            >
                            <field name="xtd_ai_profile" />
                            <div class="mt8">
                                <button
                  name="action_xtd_ai_policy_table"
                  type="object"
                  string="Tabla de políticas"
                  icon="fa-arrow-right"
                  class="btn-link"
                />
                            </div>
                        </setting>
                        <setting
              string="Umbrales"
              help="Por encima de estos valores el agente siempre pide tarjeta."
            >
                            <div class="content-group">
                                <div class="row mt8">
                                    <label
                    for="xtd_ai_discount_threshold"
                    class="col-lg-6"
                  />
                                    <field name="xtd_ai_discount_threshold" />
                                </div>
                                <div class="row mt8">
                                    <label
                    for="xtd_ai_purchase_confirm_limit"
                    class="col-lg-6"
                  />
                                    <field name="xtd_ai_purchase_confirm_limit" />
                                </div>
                            </div>
                        </setting>
                        <setting
              string="Pausar el agente"
              help="Mientras esté en pausa, nadie puede usar el agente en esta compañía."
            >
                            <field name="xtd_ai_paused" />
                        </setting>
                        <setting
              string="Límites de ritmo"
              help="Si el agente los alcanza, se detiene y avisa al usuario. 0: sin límite."
            >
                            <div class="content-group">
                                <div class="row mt8">
                                    <label
                    for="xtd_ai_max_writes_hour"
                    class="col-lg-6"
                  />
                                    <field name="xtd_ai_max_writes_hour" />
                                </div>
                                <div class="row mt8">
                                    <label
                    for="xtd_ai_max_writes_message"
                    class="col-lg-6"
                  />
                                    <field name="xtd_ai_max_writes_message" />
                                </div>
                            </div>
                        </setting>
                        <setting
              string="Veri*Factu, SII o TicketBAI"
              help="Con el envío de facturas a Hacienda activo, publicar o enviar facturas lo hace siempre el usuario, sea cual sea el perfil."
            >
                            <field name="xtd_ai_fiscal_brake" />
                        </setting>
                    </block>
                    <block title="Agente IA">
                        <setting
              string="Confirmación obligatoria"
              help="Obliga a confirmar todas las acciones del agente IA."
            >
                            <field name="xtd_ai_force_confirmation" />
                        </setting>
                        <setting
              string="Retención de la auditoría"
              help="Días que se conservan los registros de auditoría."
            >
                            <field name="xtd_ai_audit_retention_days" />
                        </setting>
                        <setting
              string="Clave de firma de tokens"
              help="Rotarla invalida todas las ejecuciones en curso."
            >
                            <button
                name="action_xtd_ai_rotate_secret"
                type="object"
                string="Rotar clave"
                class="btn-secondary"
                confirm="¿Rotar la clave de firma? Se invalidan las ejecuciones en curso."
              />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
