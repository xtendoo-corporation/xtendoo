<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de configuración individual del TPV (pos.config) -->
    <record id="pos_config_view_form_cash_drawer" model="ir.ui.view">
        <field name="name">pos.config.form.cash.drawer</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_settings_container')]" position="inside">
                <setting string="Cajón portamonedas (bridge local)"
                         help="La apertura del cajón se realiza directamente desde el navegador del TPV al bridge local. El bridge debe correr en el PC del cajero o en la LAN.">
                    <div class="content-group">

                        <!-- Habilitar bridge -->
                        <div class="row mt-2">
                            <div class="col-lg-4 o_light_label">
                                <label string="Usar bridge local" for="cash_drawer_use_bridge"/>
                            </div>
                            <div class="col-lg-8">
                                <field name="cash_drawer_use_bridge"/>
                                <span class="o_form_help ms-1"
                                      title="Activa la integración con el bridge local del cajón portamonedas."/>
                            </div>
                        </div>

                        <!-- URL del bridge -->
                        <div class="row mt-2" invisible="not cash_drawer_use_bridge">
                            <div class="col-lg-4 o_light_label">
                                <label string="URL del bridge local" for="cash_drawer_bridge_url"/>
                            </div>
                            <div class="col-lg-8">
                                <field name="cash_drawer_bridge_url"
                                       placeholder="http://127.0.0.1:3211"/>
                            </div>
                        </div>

                        <!-- Nombre impresora -->
                        <div class="row mt-2" invisible="not cash_drawer_use_bridge">
                            <div class="col-lg-4 o_light_label">
                                <label string="Nombre de la impresora" for="cash_drawer_printer_name"/>
                            </div>
                            <div class="col-lg-8">
                                <field name="cash_drawer_printer_name"
                                       placeholder="Ej: POS-80C, EPSON TM-T20III"/>
                            </div>
                        </div>

                        <!-- API Key -->
                        <div class="row mt-2" invisible="not cash_drawer_use_bridge">
                            <div class="col-lg-4 o_light_label">
                                <label string="API Key del bridge" for="cash_drawer_api_key"/>
                            </div>
                            <div class="col-lg-8">
                                <field name="cash_drawer_api_key"
                                       widget="password"
                                       placeholder="Clave de autenticación (opcional)"/>
                            </div>
                        </div>

                        <!-- Apertura automática -->
                        <div class="row mt-2" invisible="not cash_drawer_use_bridge">
                            <div class="col-lg-4 o_light_label">
                                <label string="Apertura automática en efectivo" for="cash_drawer_auto_open"/>
                            </div>
                            <div class="col-lg-8">
                                <field name="cash_drawer_auto_open"/>
                                <span class="o_form_help ms-1"
                                      title="Si está activo, el cajón se abrirá automáticamente al validar un pedido con pago en efectivo."/>
                            </div>
                        </div>

                        <!-- Botón de prueba -->
                        <div class="row mt-3" invisible="not cash_drawer_use_bridge">
                            <div class="col-lg-12">
                                <button name="action_test_cash_drawer"
                                        type="object"
                                        string="Probar apertura del cajón"
                                        class="btn btn-secondary"
                                        icon="fa-unlock"/>
                            </div>
                        </div>

                        <!-- Separador y campo legacy -->
                        <div class="row mt-3">
                            <div class="col-lg-12">
                                <div class="alert alert-light border mt-1 mb-0 small text-muted">
                                    <i class="fa fa-info-circle me-1"/>
                                    <strong>Campo legado:</strong> Si migraste desde una versión anterior
                                    que usaba el proxy backend de Odoo, el campo
                                    <em>URL de apertura (legado)</em> se conserva por compatibilidad.
                                    Puedes migrar su valor a <em>URL del bridge local</em> y luego
                                    activar <em>Usar bridge local</em>.
                                </div>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-lg-4 o_light_label">
                                <label string="URL de apertura (legado)" for="cash_drawer_open_url"/>
                            </div>
                            <div class="col-lg-8">
                                <field name="cash_drawer_open_url"
                                       placeholder="Legado: http://..."/>
                            </div>
                        </div>

                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
