<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de configuración individual del TPV (pos.config) -->
    <record id="pos_config_view_form_cash_drawer" model="ir.ui.view">
        <field name="name">pos.config.form.cash.drawer</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_settings_container')]" position="inside">
                <setting string="Cajón portamonedas"
                         help="Configuración del cajón portamonedas para este terminal de punto de venta">
                    <div class="content-group">
                        <div class="row mt-2">
                            <div class="col-lg-4 o_light_label">
                                <label string="Nombre de la impresora" for="cash_drawer_printer_name"/>
                            </div>
                            <div class="col-lg-8">
                                <field name="cash_drawer_printer_name"
                                       placeholder="Ej: EPSON TM-T20III"/>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-lg-4 o_light_label">
                                <label string="URL de apertura del cajón" for="cash_drawer_open_url"/>
                            </div>
                            <div class="col-lg-8">
                                <field name="cash_drawer_open_url"
                                       placeholder="Ej: http://localhost:9100/open_drawer"/>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-lg-4 o_light_label">
                                <label string="API Key" for="cash_drawer_api_key"/>
                            </div>
                            <div class="col-lg-8">
                                <field name="cash_drawer_api_key"
                                       widget="password"
                                       placeholder="Clave de autenticación (opcional)"/>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-lg-12">
                                <button name="action_test_cash_drawer"
                                        type="object"
                                        string="Probar apertura del cajón"
                                        class="btn btn-secondary"
                                        icon="fa-unlock"/>
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
