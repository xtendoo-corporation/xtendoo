<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de configuración general del POS (Ajustes > Punto de Venta) -->
    <record id="res_config_settings_view_form_cash_drawer" model="ir.ui.view">
        <field name="name">res.config.settings.form.cash.drawer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_connected_devices_section']" position="inside">
                <setting id="pos_cash_drawer"
                         string="Cajón portamonedas (bridge local)"
                         help="La apertura del cajón se realiza directamente desde el navegador del TPV al bridge local. El bridge debe correr en el PC del cajero o en la LAN.">
                    <div class="content-group">

                        <!-- Habilitar bridge -->
                        <div class="row mt-2">
                            <label string="Usar bridge local"
                                   for="pos_cash_drawer_use_bridge"
                                   class="col-lg-4 o_light_label"/>
                            <field name="pos_cash_drawer_use_bridge"/>
                        </div>

                        <!-- URL del bridge -->
                        <div class="row mt-2"
                             invisible="not pos_cash_drawer_use_bridge">
                            <label string="URL del bridge local"
                                   for="pos_cash_drawer_bridge_url"
                                   class="col-lg-4 o_light_label"/>
                            <field name="pos_cash_drawer_bridge_url"
                                   placeholder="http://127.0.0.1:3211"/>
                        </div>

                        <!-- Nombre impresora -->
                        <div class="row mt-2"
                             invisible="not pos_cash_drawer_use_bridge">
                            <label string="Nombre de la impresora"
                                   for="pos_cash_drawer_printer_name"
                                   class="col-lg-4 o_light_label"/>
                            <field name="pos_cash_drawer_printer_name"
                                   placeholder="Ej: POS-80C, EPSON TM-T20III"/>
                        </div>

                        <!-- API Key -->
                        <div class="row mt-2"
                             invisible="not pos_cash_drawer_use_bridge">
                            <label string="API Key del bridge"
                                   for="pos_cash_drawer_api_key"
                                   class="col-lg-4 o_light_label"/>
                            <field name="pos_cash_drawer_api_key"
                                   widget="password"
                                   placeholder="Clave de autenticación (opcional)"/>
                        </div>

                        <!-- Apertura automática -->
                        <div class="row mt-2"
                             invisible="not pos_cash_drawer_use_bridge">
                            <label string="Apertura automática en efectivo"
                                   for="pos_cash_drawer_auto_open"
                                   class="col-lg-4 o_light_label"/>
                            <field name="pos_cash_drawer_auto_open"/>
                        </div>

                        <!-- Botón de prueba -->
                        <div class="row mt-3"
                             invisible="not pos_cash_drawer_use_bridge">
                            <div class="col-lg-12">
                                <button name="action_test_cash_drawer"
                                        type="object"
                                        string="Probar apertura del cajón"
                                        class="btn btn-secondary"
                                        icon="fa-unlock"/>
                            </div>
                        </div>

                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
