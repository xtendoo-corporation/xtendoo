<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Template del botón de apertura del cajón en el Navbar del TPV.

        El botón se muestra cuando isVisible es true (bridge habilitado y configurado
        o campo legacy cash_drawer_open_url relleno).

        La apertura va directamente al bridge local desde el navegador del TPV.
    -->
    <t t-name="xtendoo_cash_drawer.CashDrawerNavbarButton">
        <button t-if="isVisible"
                class="btn btn-light btn-lg lh-lg cash-drawer-navbar-button"
                t-att-disabled="state.sending"
                t-on-click="onClick"
                title="Abrir cajón portamonedas">
            <i t-attf-class="fa fa-fw {{ state.sending ? 'fa-spinner fa-spin' : 'fa-unlock' }}"/>
            <span class="ms-1">Abrir</span>
        </button>
    </t>

    <!-- Patch del Navbar: inyecta el botón antes del menú hamburguesa -->
    <t t-name="xtendoo_cash_drawer.Navbar"
       t-inherit="point_of_sale.Navbar"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('status-buttons')]//Dropdown" position="before">
            <CashDrawerNavbarButton/>
        </xpath>
    </t>

</templates>
