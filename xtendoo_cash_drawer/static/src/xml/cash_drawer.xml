<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Extiende los botones de control del TPV para añadir "Abrir Cajón".

        El botón solo se muestra cuando cashDrawerConfigured es true, es decir:
          - cash_drawer_use_bridge = true Y cash_drawer_bridge_url tiene valor, O
          - cash_drawer_open_url tiene valor (compatibilidad legacy).

        La apertura va directamente al bridge local desde el navegador del TPV.
    -->
    <t t-name="xtendoo_cash_drawer.ControlButtons"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">

        <!-- Botón en la vista principal / móvil (junto a InternalNoteButton)
        <xpath expr="//InternalNoteButton" position="after">
            <button t-if="cashDrawerConfigured"
                    t-att-class="buttonClass"
                    t-on-click="() => this.openCashDrawer()">
                <i class="fa fa-fw fa-unlock"/>
                <span class="d-none d-lg-inline ms-1">Abrir Cajón</span>
            </button>
        </xpath>
        -->

        <!-- Botón en el modal de escritorio (junto a NoteButton)
        <xpath expr="//NoteButton" position="after">
            <button t-if="cashDrawerConfigured"
                    t-att-class="buttonClass"
                    aria-label="Abrir Cajón"
                    t-on-click="() => this.openCashDrawer()">
                <i class="fa fa-unlock me-1"
                   aria-hidden="true"/>
            </button>
        </xpath>
        -->

    </t>

</templates>
