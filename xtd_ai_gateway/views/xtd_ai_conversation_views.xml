<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_xtd_ai_conversation_list" model="ir.ui.view">
        <field name="name">xtd.ai.conversation.list</field>
        <field name="model">xtd.ai.conversation</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name" />
                <field name="user_id" />
                <field name="company_id" />
                <field name="state" />
                <field name="write_date" />
            </list>
        </field>
    </record>

    <record id="view_xtd_ai_conversation_form" model="ir.ui.view">
        <field name="name">xtd.ai.conversation.form</field>
        <field name="model">xtd.ai.conversation</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="user_id" />
                        <field name="company_id" />
                        <field name="state" />
                    </group>
                    <notebook>
                        <page string="Mensajes">
                            <field name="message_ids">
                                <list>
                                    <field name="create_date" />
                                    <field name="role" />
                                    <field name="body" />
                                </list>
                            </field>
                        </page>
                        <page string="Ejecuciones">
                            <field name="run_ids">
                                <list>
                                    <field name="create_date" />
                                    <field name="state" />
                                    <field name="model" />
                                    <field name="input_tokens" />
                                    <field name="output_tokens" />
                                    <field name="tool_calls" />
                                    <field name="cost_estimate" />
                                    <field name="error" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_xtd_ai_conversation" model="ir.actions.act_window">
        <field name="name">Conversaciones del agente IA</field>
        <field name="res_model">xtd.ai.conversation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
