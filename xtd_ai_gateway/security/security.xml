<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_xtd_ai" model="ir.module.category">
        <field name="name">Agente IA</field>
        <field name="sequence">90</field>
    </record>

    <record id="res_groups_privilege_xtd_ai" model="res.groups.privilege">
        <field name="name">Agente IA</field>
        <field name="category_id" ref="module_category_xtd_ai" />
    </record>

    <record id="group_xtd_ai_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="privilege_id" ref="res_groups_privilege_xtd_ai" />
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>

    <record id="group_xtd_ai_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="privilege_id" ref="res_groups_privilege_xtd_ai" />
        <field name="implied_ids" eval="[Command.link(ref('group_xtd_ai_user'))]" />
    </record>

    <!-- Conversations: own ones; the AI manager reads all of them -->
    <record id="rule_xtd_ai_conversation_own" model="ir.rule">
        <field name="name">AI conversation: own</field>
        <field name="model_id" ref="model_xtd_ai_conversation" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_xtd_ai_user'))]" />
    </record>
    <record id="rule_xtd_ai_conversation_manager" model="ir.rule">
        <field name="name">AI conversation: manager reads all</field>
        <field name="model_id" ref="model_xtd_ai_conversation" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_xtd_ai_manager'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="rule_xtd_ai_message_own" model="ir.rule">
        <field name="name">AI message: own conversation</field>
        <field name="model_id" ref="model_xtd_ai_message" />
        <field name="domain_force">[('conversation_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_xtd_ai_user'))]" />
    </record>
    <record id="rule_xtd_ai_message_manager" model="ir.rule">
        <field name="name">AI message: manager reads all</field>
        <field name="model_id" ref="model_xtd_ai_message" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_xtd_ai_manager'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="rule_xtd_ai_run_own" model="ir.rule">
        <field name="name">AI run: own</field>
        <field name="model_id" ref="model_xtd_ai_run" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_xtd_ai_user'))]" />
    </record>
    <record id="rule_xtd_ai_run_manager" model="ir.rule">
        <field name="name">AI run: manager reads all</field>
        <field name="model_id" ref="model_xtd_ai_run" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_xtd_ai_manager'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <!-- Pending actions: only the owner, nobody else (not even the manager) -->
    <record id="rule_xtd_ai_pending_action_own" model="ir.rule">
        <field name="name">AI pending action: own</field>
        <field name="model_id" ref="model_xtd_ai_pending_action" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_xtd_ai_user'))]" />
    </record>
</odoo>
