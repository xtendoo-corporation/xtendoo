<odoo>
    <template id="booking_step_1" name="Booking Step 1">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-6 col-md-8">
                        <div class="card shadow-lg border-0">
                            <div class="card-body p-4">
                                <h2 class="mb-4 text-center text-primary">Reserva tu cita</h2>
                                <form id="booking_form_step_1">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Tipo de cita *</label>
                                        <select name="booking_type" class="form-select"
                                            required="required">
                                            <option value="" disabled="disabled" selected="selected">Selecciona
                                                el tipo de cita</option>
                                            <t t-foreach="booking_types" t-as="type">
                                                <option t-att-value="type.id">
                                                    <t t-esc="type.name" />
                                                    <t t-if="type.duration"> - <t
                                                            t-esc="type.duration" />h</t>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Nombre *</label>
                                        <input type="text" name="name" class="form-control"
                                            required="required" placeholder="Tu nombre completo" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Teléfono *</label>
                                        <input type="text" name="phone" class="form-control"
                                            required="required" placeholder="Ej: +34 600 000 000" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Email</label>
                                        <input type="email" name="email" class="form-control"
                                            placeholder="tucorreo@ejemplo.com" />
                                    </div>
                                    <div class="text-end">
                                        <input type="hidden" name="csrf_token"
                                            t-att-value="request.csrf_token()" />
                                        <button type="button" class="btn btn-primary btn-lg px-4"
                                            id="booking_next">
                                            Siguiente &#8594;
                                        </button>
                                    </div>
                                </form>
                                <div id="booking_step_2" class="d-none mt-5">
                                    <h3 class="mb-4 text-center text-success">Selecciona una fecha y
                                        hora</h3>
                                    <div id="booking_calendar"></div>
                                    <input type="hidden" name="date" id="selected_date" />
                                    <div class="mb-3 d-none" id="hour_selector">
                                        <label class="form-label fw-bold">Hora *</label>
                                        <select name="hour" id="booking_hour" class="form-select"
                                            disabled="disabled"></select>
                                    </div>
                                    <div class="text-end mt-4">
                                        <button type="button" class="btn btn-success btn-lg px-4"
                                            id="booking_reserve">
                                            Reservar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>