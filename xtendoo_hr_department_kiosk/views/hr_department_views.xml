<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_department_form_inherit_kiosk" model="ir.ui.view">
            <field name="name">hr.department.form.inherit.kiosk</field>
            <field name="model">hr.department</field>
            <field name="inherit_id" ref="hr.view_department_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='parent_id']" position="after">
                    <field name="is_department_kiosk" />
                    <field name="department_kiosk_url" widget="url"
                        invisible="not is_department_kiosk" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
