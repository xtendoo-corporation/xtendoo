<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_update_coste_wizard_form" model="ir.ui.view">
        <field name="name">update.coste.wizard.form</field>
        <field name="model">update.coste.wizard</field>
        <field name="arch" type="xml">
            <form string="Resumen actualización de coste">
                <group>
                    <field name="updated_count" readonly="1"/>
                    <field name="employee_names" readonly="1" widget="text"/>
                </group>
                <footer>
                    <button string="Cerrar" type="object" name="action_close" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

