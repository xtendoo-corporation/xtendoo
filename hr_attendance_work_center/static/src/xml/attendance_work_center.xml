<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="hr_attendance_work_center.WorkCenterAction" owl="1">
        <div class="o_attendance_background d-flex flex-column h-100">
            <div class="o_hr_kiosk_mode_main d-flex flex-grow-1 justify-content-center align-items-center p-3">
                <div class="o_hr_attendance_kiosk_card card rounded-3" style="max-width: 560px; width: 100%;">
                    <div class="card-body rounded-3">
                        <div class="o_hr_attendance_kiosk_card_wrapper d-flex flex-column align-items-center justify-content-center text-center p-3">
                            <t t-if="state.loading">
                                <i class="fa fa-spinner fa-spin fa-2x"/>
                            </t>
                            <t t-elif="!state.employee">
                                <div class="alert alert-warning" role="alert">
                                    <t t-esc="noEmployeeMessage"/>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="o_hr_attendance_user_badge text-center mb-2">
                                    <img class="o_hr_attendance_employee_badge img rounded-circle" t-attf-src="{{employeeAvatarUrl}}" t-att-height="120"/>
                                </div>
                                <h2 class="mb-2" t-esc="state.employee.name"/>
                                <h5 class="mb-3">Seleccione un centro de trabajo</h5>
                                <t t-if="state.checkedIn">
                                    <p class="mb-1" t-if="state.workCenterName">
                                        <strong>Centro de trabajo:</strong>
                                        <span t-esc="state.workCenterName"/>
                                    </p>
                                    <p class="mb-3 text-muted">
                                        Horas de hoy:
                                        <span t-esc="state.hoursToday"/>
                                    </p>
                                    <button class="btn btn-warning btn-lg rounded-pill px-5" t-on-click="signInOut">
                                        Registrar salida
                                    </button>
                                </t>
                                <t t-else="">
                                    <button class="btn btn-primary" style="width: 220px; height: 100px;" t-on-click="openWorkCenters">
                                        <i class="fa fa-building-o fa-3x"/>
                                    </button>
                                </t>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="hr_attendance_work_center.WorkCenterConfirm" owl="1">
        <div class="o_attendance_background d-flex flex-column h-100">
            <div class="o_hr_kiosk_mode_main d-flex flex-grow-1 justify-content-center align-items-center p-3">
                <div class="o_hr_attendance_kiosk_card card rounded-3" style="max-width: 560px; width: 100%;">
                    <div class="card-body rounded-3">
                        <div class="o_hr_attendance_kiosk_card_wrapper d-flex flex-column align-items-center justify-content-center text-center p-3">
                            <button class="btn btn-secondary rounded-pill mb-3" t-on-click="goBack">Volver</button>
                            <t t-if="state.loading">
                                <i class="fa fa-spinner fa-spin fa-2x"/>
                            </t>
                            <t t-elif="!state.employee or !state.workCenterId">
                                <div class="alert alert-danger" role="alert">
                                    <b><t t-esc="errorMessage"/></b>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="o_hr_attendance_user_badge text-center mb-2">
                                    <img class="o_hr_attendance_employee_badge img rounded-circle" t-attf-src="{{employeeAvatarUrl}}" t-att-height="120"/>
                                </div>
                                <h2 class="mb-1" t-esc="state.employee.name"/>
                                <h5 class="mb-2">Centro de trabajo</h5>
                                <h3 class="mb-3" t-esc="state.workCenterName"/>
                                <p class="text-muted mb-3" t-if="state.checkedIn">
                                    Horas de hoy:
                                    <span t-esc="state.hoursToday"/>
                                </p>
                                <button class="btn btn-primary btn-lg rounded-pill px-5" t-on-click="signInOut">
                                    <t t-if="state.checkedIn">Registrar salida</t>
                                    <t t-else="">Registrar entrada</t>
                                </button>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
