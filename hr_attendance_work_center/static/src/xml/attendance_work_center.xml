<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="hr_attendance_work_center.WorkCenterAction" owl="1">
        <div class="o_wc_attendance_fullpage d-flex flex-column">
            <div class="o_wc_attendance_content d-flex flex-column align-items-center justify-content-center text-center gap-3 flex-grow-1 w-100 overflow-auto">

                <!-- LOADING -->
                <t t-if="state.loading">
                    <i class="fa fa-spinner fa-spin fa-2x"/>
                </t>

                <!-- EMPLOYEES -->
                <t t-elif="state.requiresEmployeeSelection and state.step === 'employee'">
                    <h3 class="mb-1">Seleccione empleado</h3>
                    <div class="input-group mx-auto" style="max-width: 520px;">
                        <span class="input-group-text"><i class="fa fa-search"/></span>
                        <input class="form-control" type="text" t-model="state.employeeSearch" placeholder="Buscar empleado..."/>
                    </div>

                    <div class="row g-3 w-100 o_wc_scroll_area">
                        <t t-foreach="filteredEmployees || []" t-as="employee" t-key="employee.id">
                            <div class="col-12 col-md-6 col-lg-4">
                                <button class="btn btn-light text-start w-100 p-3 h-100"
                                        t-on-click="() => this.selectEmployee(employee)">
                                    <div class="d-flex align-items-center gap-2">
                                        <img t-att-src="employee.avatar_url" class="rounded-circle" style="width:40px;height:40px;object-fit:cover;"/>
                                        <div>
                                            <div class="fw-bold" t-esc="employee.name"/>
                                            <small class="text-muted">
                                                <t t-if="employee.attendance_state === 'checked_in'">En turno</t>
                                                <t t-else="">Fuera de turno</t>
                                            </small>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </t>
                        <div class="col-12" t-if="!(filteredEmployees &amp;&amp; filteredEmployees.length)">
                            <div class="alert alert-light mb-0">No se han encontrado empleados con ese texto.</div>
                        </div>
                    </div>
                </t>

                <!-- PIN -->
                <t t-elif="state.requiresEmployeeSelection and state.step === 'pin'">
                    <button class="btn btn-secondary rounded-pill mb-2"
                            t-on-click="() => this.backToEmployees()">← Volver</button>

                    <img class="rounded-circle" t-attf-src="{{employeeAvatarUrl}}" style="width:120px;height:120px;object-fit:cover;"/>
                    <h3 class="mb-1" t-esc="state.employee.name"/>
                    <p class="text-muted mb-1">Introduzca PIN para continuar</p>

                    <div class="input-group mx-auto" style="max-width: 360px;">
                        <input class="form-control form-control-lg text-center"
                               type="password"
                               t-model="state.enteredPin"
                               placeholder="PIN"/>
                        <button class="btn btn-primary"
                                t-on-click="() => this.confirmPin()">Continuar</button>
                    </div>
                </t>

                <!-- CHECKOUT -->
                <t t-elif="state.step === 'checkout' and state.employee">
                    <img class="rounded-circle" t-attf-src="{{employeeAvatarUrl}}" style="width:120px;height:120px;object-fit:cover;"/>
                    <h3 class="mb-1" t-esc="state.employee.name"/>

                    <p class="mb-1" t-if="workCenterName">
                        <strong>Centro actual:</strong> <span t-esc="workCenterName"/>
                    </p>

                    <p class="text-muted mb-3">
                        Horas de hoy: <strong t-esc="hoursToday"/>
                    </p>

                    <button class="btn btn-warning btn-lg rounded-pill px-5"
                            t-on-click="() => this.registerCheckOut()">
                        Registrar salida
                    </button>
                </t>

                <!-- WORK CENTER -->
                <t t-elif="state.step === 'work_center' and state.employee">
                    <button class="btn btn-secondary rounded-pill mb-2"
                            t-if="state.requiresEmployeeSelection"
                            t-on-click="() => this.backToEmployees()">← Volver</button>

                    <img class="rounded-circle" t-attf-src="{{employeeAvatarUrl}}" style="width:120px;height:120px;object-fit:cover;"/>
                    <h3 class="mb-1" t-esc="state.employee.name"/>

                    <p class="text-muted mb-0">
                        Seleccione centro de trabajo para registrar entrada
                    </p>

                    <!-- Input de búsqueda -->
                    <div class="input-group mx-auto mb-3" style="max-width: 520px;">
                        <span class="input-group-text"><i class="fa fa-search"/></span>
                        <input class="form-control" type="text" t-model="state.workCenterSearch" placeholder="Buscar centro de trabajo..."/>
                    </div>

                    <div class="row g-3 w-100 o_wc_scroll_area">
                        <t t-foreach="this.filteredWorkCenters || []" t-as="center" t-key="center.id">
                            <div class="col-12 col-md-6 col-lg-4">
                                <button class="btn btn-light text-start w-100 p-3 h-100"
                                        t-on-click="() => this.askConfirmWorkCenter(center)">
                                    <div class="fw-bold" t-esc="center.display_name"/>
                                    <small class="text-muted" t-if="center.city or center.country_id">
                                        <t t-if="center.city"><t t-esc="center.city"/></t>
                                        <t t-if="center.city and center.country_id">, </t>
                                        <t t-if="center.country_id"><t t-esc="center.country_id[1]"/></t>
                                    </small>
                                </button>
                            </div>
                        </t>
                        <div class="col-12" t-if="!(this.filteredWorkCenters &amp;&amp; this.filteredWorkCenters.length)">
                            <div class="alert alert-light mb-0">No se han encontrado centros con ese texto.</div>
                        </div>
                    </div>
                </t>

                <!-- CONFIRM -->
                <t t-elif="state.step === 'confirm_work_center' and state.selectedWorkCenter">
                    <img class="rounded-circle" t-attf-src="{{employeeAvatarUrl}}" style="width:120px;height:120px;object-fit:cover;"/>

                    <h3 class="mb-1" t-esc="state.employee.name"/>

                    <p class="mb-2">
                        ¿Confirmar entrada en:
                        <strong t-esc="state.selectedWorkCenter.display_name"/>?
                    </p>

                    <div class="d-flex gap-2 justify-content-center">
                        <button class="btn btn-secondary"
                                t-on-click="() => { this.state.step = 'work_center'; this.state.selectedWorkCenter = null; }">
                            Cancelar
                        </button>

                        <button class="btn btn-primary"
                                t-on-click="() => this.confirmWorkCenter()">
                            Confirmar
                        </button>
                    </div>
                </t>

                <!-- GREET -->
                <t t-elif="state.step === 'greet' and state.attendanceResult">
                    <img class="rounded-circle"
                         t-attf-src="{{state.attendanceResult.employee_avatar || employeeAvatarUrl}}"
                         style="width:120px;height:120px;object-fit:cover;"/>

                    <h5 class="text-muted mb-1">
                        <t t-if="state.attendanceResult.attendance?.check_out">Hasta luego</t>
                        <t t-else="">Bienvenido/a</t>
                    </h5>

                    <h2 class="mb-2" t-esc="state.attendanceResult.employee_name"/>

                    <div class="alert alert-info" style="max-width:480px;width:100%;">
                        <t t-if="state.attendanceResult.attendance?.check_out">Salida registrada</t>
                        <t t-else="">Entrada registrada</t>
                    </div>

                    <div class="alert alert-light border"
                         style="max-width:480px;width:100%;"
                         t-if="state.attendanceResult.work_center_name">
                        Centro de trabajo:
                        <strong t-esc="state.attendanceResult.work_center_name"/>
                    </div>

                    <button class="btn btn-primary btn-lg rounded-pill px-5"
                            t-on-click="() => this.resetFlow()">
                        Aceptar
                    </button>
                </t>

                <!-- FALLBACK / NO EMPLOYEE -->
<t t-else="" t-if="!state.loading">
    <div class="alert alert-warning">
        <t t-esc="noEmployeeMessage"/>
    </div>
</t>

            </div>
        </div>
    </t>
</templates>
