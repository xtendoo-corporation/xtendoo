<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.default.category</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='product_and_category_block']" position="inside">
                <setting string="Categoría Inicial"
                    help="Categoría seleccionada automáticamente al iniciar la sesión.">
                    <field name="pos_default_pos_category_id" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>