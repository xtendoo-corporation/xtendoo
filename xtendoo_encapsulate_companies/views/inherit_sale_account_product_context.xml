<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Heredar vista de ventas: sale.order_form -->
    <record id="view_order_form_inherit_encapsulate_companies" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.encapsulate.companies</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="attributes">
                <attribute name="context">{'company_id': parent.company_id or company_id}</attribute>
            </xpath>
        </field>
    </record>

    <!-- Heredar vista de facturas: account.move_form -->
    <record id="view_move_form_inherit_encapsulate_companies" model="ir.ui.view">
        <field name="name">account.move.form.inherit.encapsulate.companies</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='product_id']" position="attributes">
                <attribute name="context">{'company_id': parent.company_id or company_id}</attribute>
            </xpath>
        </field>
    </record>
</odoo>

