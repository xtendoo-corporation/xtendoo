<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="rule_partner_same_company" model="ir.rule">
    <field name="name">Partners of same company (excluding users of other companies)</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="domain_force">
        ['|',
            ('company_id', '=', False),
            '&amp;',
                ('company_id', 'in', user.company_ids.ids),
                '|',
                    ('user_ids', '=', False),
                    ('user_ids.company_id', 'in', user.company_ids.ids)
        ]
    </field>
    <field name="global" eval="True"/>
</record>

    </data>
</odoo>
