<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_category_company_rule" model="ir.rule">
        <field name="name">Categoría del contacto por compañía</field>
        <field name="model_id" ref="base.model_res_partner_category"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="res_partner_industry_company_rule" model="ir.rule">
        <field name="name">Sector del contacto por compañía</field>
        <field name="model_id" ref="base.model_res_partner_industry"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
