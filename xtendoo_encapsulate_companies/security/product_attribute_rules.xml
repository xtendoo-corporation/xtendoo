<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_attribute_company_rule" model="ir.rule">
        <field name="name">Atributos de producto por compañía</field>
        <field name="model_id" ref="product.model_product_attribute"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="product_attribute_value_company_rule" model="ir.rule">
        <field name="name">Valores de atributo por compañía</field>
        <field name="model_id" ref="product.model_product_attribute_value"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="product_template_attribute_exclusion_company_rule" model="ir.rule">
        <field name="name">Exclusiones de atributo por compañía</field>
        <field name="model_id" ref="product.model_product_template_attribute_exclusion"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="product_template_attribute_line_company_rule" model="ir.rule">
        <field name="name">Líneas de atributo por compañía</field>
        <field name="model_id" ref="product.model_product_template_attribute_line"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="product_template_attribute_value_company_rule" model="ir.rule">
        <field name="name">Valores de línea de atributo por compañía</field>
        <field name="model_id" ref="product.model_product_template_attribute_value"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>

