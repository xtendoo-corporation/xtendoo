<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_ai_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.ai.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_ai_enrichment_wizard"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-robot"
                    string="Enrich with AI"
                />
            </xpath>
        </field>
    </record>
</odoo>
