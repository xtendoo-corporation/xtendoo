<odoo>
    <record id="view_picking_form_fix_volume" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="delivery.view_picking_withcarrier_out_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='carrier_data']" position='inside'>
                <label for="volume" string="Volumen para el envio" />
                        <div>
                            <field name="volume" class="oe_inline" />
                            <field
                        name="volume_uom_name"
                        nolabel="1"
                        class="oe_inline"
                        style="margin-left:5px"
                    />
                        </div>
            </xpath>
        </field>
    </record>
</odoo>
