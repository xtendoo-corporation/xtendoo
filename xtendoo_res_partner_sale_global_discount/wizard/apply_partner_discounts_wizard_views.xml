<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista del wizard para aplicar descuentos del cliente -->
    <record id="view_apply_partner_discounts_wizard_form" model="ir.ui.view">
        <field name="name">apply.partner.discounts.wizard.form</field>
        <field name="model">apply.partner.discounts.wizard</field>
        <field name="arch" type="xml">
            <form string="Aplicar Descuentos del Cliente">
                <div class="alert alert-info" role="alert" style="margin-bottom: 10px;">
                    <i class="fa fa-info-circle" title="Información"/>
                    <strong>Confirmar Aplicación de Descuentos</strong><br/>
                    Está a punto de aplicar los descuentos globales configurados para este cliente.
                </div>

                <group>
                    <group>
                        <field name="sale_order_id" invisible="1"/>
                        <field name="account_move_id" invisible="1"/>
                        <field name="document_type" invisible="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="base_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </group>
                    <group>
                        <field name="total_discount_amount" widget="monetary" options="{'currency_field': 'currency_id'}" class="oe_subtotal_footer_separator"/>
                    </group>
                </group>

                <field name="discount_summary" widget="html" nolabel="1"/>

                <footer>
                    <button name="action_apply_discounts" string="Confirmar y Aplicar Descuentos"
                            type="object" class="btn-primary"/>
                    <button name="action_cancel" string="Cancelar" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción del wizard -->
    <record id="action_apply_partner_discounts_wizard" model="ir.actions.act_window">
        <field name="name">Aplicar Descuentos del Cliente</field>
        <field name="res_model">apply.partner.discounts.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
