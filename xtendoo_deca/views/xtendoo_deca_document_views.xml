<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_xtendoo_deca_document_form" model="ir.ui.view">
        <field name="name">xtendoo.deca.document.form</field>
        <field name="model">xtendoo.deca.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate" type="object" string="Generar PDF"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_regenerate" type="object" string="Modificar datos (nuevo PDF)"
                            invisible="state != 'generated'"/>
                    <button name="action_disable_download" type="object" string="Desactivar descarga"
                            invisible="not download_enabled"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Transporte">
                            <field name="picking_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="cargador_partner_id"/>
                            <field name="cargador_nif"/>
                            <field name="transportista_partner_id"/>
                            <field name="transportista_nif"/>
                        </group>
                        <group string="Envío">
                            <field name="origen"/>
                            <field name="destino"/>
                            <field name="fecha_servicio"/>
                            <field name="matricula_vehiculo"/>
                            <field name="autorizacion_especial"/>
                        </group>
                    </group>
                    <group string="Mercancía">
                        <field name="mercancia_naturaleza"/>
                        <field name="mercancia_peso"/>
                        <field name="observaciones"/>
                    </group>
                    <group string="Documento electrónico (DeCA)">
                        <field name="qr_url" widget="url"/>
                        <field name="download_enabled"/>
                        <field name="pdf_file" filename="pdf_filename"/>
                        <field name="pdf_filename" invisible="1"/>
                        <field name="previous_document_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_xtendoo_deca_document_list" model="ir.ui.view">
        <field name="name">xtendoo.deca.document.list</field>
        <field name="model">xtendoo.deca.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="picking_id"/>
                <field name="transportista_partner_id"/>
                <field name="fecha_servicio"/>
                <field name="state"/>
                <field name="download_enabled"/>
            </list>
        </field>
    </record>

    <record id="action_xtendoo_deca_document" model="ir.actions.act_window">
        <field name="name">Documentos DeCA</field>
        <field name="res_model">xtendoo.deca.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_xtendoo_deca_document"
              name="DeCA"
              parent="stock.menu_stock_root"
              action="action_xtendoo_deca_document"
              sequence="90"/>
</odoo>
