<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_xtendoo_deca_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Documento electrónico de Control Administrativo (DeCA)</h2>
                        <p>
                            Documento de control administrativo exigible para la realización de
                            transporte público de mercancías por carretera (Orden FOM/2861/2012,
                            de 13 de diciembre; Resolución de 5 de junio de 2026 de la Dirección
                            General de Transporte por Carretera y Ferrocarril, BOE-A-2026-12784).
                        </p>
                        <table class="table table-sm o_report_deca_table">
                            <tr>
                                <td><strong>Referencia</strong></td>
                                <td><span t-field="doc.name"/></td>
                                <td><strong>Fecha de realización</strong></td>
                                <td><span t-field="doc.fecha_servicio"/></td>
                            </tr>
                            <tr>
                                <td><strong>Cargador contractual</strong></td>
                                <td><span t-field="doc.cargador_partner_id.display_name"/></td>
                                <td><strong>NIF</strong></td>
                                <td><span t-field="doc.cargador_nif"/></td>
                            </tr>
                            <tr>
                                <td><strong>Transportista efectivo</strong></td>
                                <td><span t-field="doc.transportista_partner_id.display_name"/></td>
                                <td><strong>NIF</strong></td>
                                <td><span t-field="doc.transportista_nif"/></td>
                            </tr>
                            <tr>
                                <td><strong>Origen</strong></td>
                                <td><span t-field="doc.origen"/></td>
                                <td><strong>Destino</strong></td>
                                <td><span t-field="doc.destino"/></td>
                            </tr>
                            <tr>
                                <td><strong>Matrícula del vehículo</strong></td>
                                <td><span t-field="doc.matricula_vehiculo"/></td>
                                <td><strong>Autorización especial</strong></td>
                                <td><span t-field="doc.autorizacion_especial"/></td>
                            </tr>
                        </table>
                        <h4>Naturaleza y peso de la mercancía transportada</h4>
                        <p style="white-space: pre-line;"><span t-field="doc.mercancia_naturaleza"/></p>
                        <p><strong>Peso total: </strong><span t-field="doc.mercancia_peso"/> kg</p>
                        <t t-if="doc.observaciones">
                            <h4>Observaciones</h4>
                            <p style="white-space: pre-line;"><span t-field="doc.observaciones"/></p>
                        </t>
                        <div class="text-center mt-4">
                            <img t-att-src="doc.get_barcode_src()" style="width:140px;height:140px;"/>
                            <p><small t-esc="doc.qr_url"/></p>
                        </div>
                        <p class="text-muted mt-4">
                            <small>
                                Documento generado electrónicamente el
                                <span t-field="doc.create_date"/>.
                                <t t-if="doc.write_date != doc.create_date">
                                    Última modificación: <span t-field="doc.write_date"/>.
                                </t>
                                Fichero nativo digital conforme al apartado Segundo de la
                                Resolución de 5 de junio de 2026 (BOE-A-2026-12784).
                            </small>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
