<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="xtd_hr_leave_recompute_wizard_view_form" model="ir.ui.view">
        <field name="name">xtd.hr.leave.recompute.wizard.form</field>
        <field name="model">xtd.hr.leave.recompute.wizard</field>
        <field name="arch" type="xml">
            <form string="Recalcular ausencias">
                <group>
                    <field name="xtd_calendar_mode"/>
                    <field
                        name="xtd_calendar_id"
                        invisible="xtd_calendar_mode != 'manual'"
                        required="xtd_calendar_mode == 'manual'"
                        options="{'no_create': True}"
                    />
                    <field name="xtd_leave_ids" widget="many2many_tags" readonly="1"/>
                </group>
                <footer>
                    <button
                        name="xtd_action_recompute"
                        type="object"
                        string="Recalcular"
                        class="btn btn-primary"
                    />
                    <button string="Cancelar" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="xtd_hr_leave_recompute_wizard_action" model="ir.actions.act_window">
        <field name="name">Recalcular ausencias</field>
        <field name="res_model">xtd.hr.leave.recompute.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="xtd_hr_leave_recompute_wizard_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>
