<odoo>
  <record id="view_picking_form_xtd_matrix_weight" model="ir.ui.view">
    <field name="name">stock.picking.form.xtd.matrix.weight</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/notebook/page[@name='operations']" position="after">
        <group string="Báscula">
          <field name="weight_from_scale" readonly="1"/>
          <button name="action_xtd_read_weight" type="object" class="oe_highlight"
                  string="Leer peso de báscula" icon="fa-balance-scale"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
