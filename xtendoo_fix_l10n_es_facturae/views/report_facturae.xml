<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Remove empty fields defined in l10n_es_facturae templates -->

    <!-- Template: administrative_center - Remove empty elements -->
    <template id="administrative_center_inherit" inherit_id="l10n_es_facturae.administrative_center">
        <xpath expr="//SecondSurname" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//PhysicalGLN" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//LogicalOperationalPoint" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
    </template>

    <!-- Template: address_contact - Remove empty elements -->
    <template id="address_contact_inherit" inherit_id="l10n_es_facturae.address_contact">
        <xpath expr="//CnoCnae" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//INETownCode" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//TeleFax" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//AdditionalContactDetails" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
    </template>

    <!-- Template: entity - Remove empty elements -->
    <template id="entity_inherit" inherit_id="l10n_es_facturae.entity">
        <xpath expr="//PartyIdentification" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//RegistrationData/Book" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//RegistrationData/RegisterOfCompaniesLocation" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//RegistrationData/Sheet" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//RegistrationData/Folio" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//RegistrationData/Section" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//RegistrationData/Volume" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//RegistrationData/AdditionalRegistrationData" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
    </template>

    <!-- Template: template_facturae - Remove empty elements from main invoice template -->
    <template id="template_facturae_inherit" inherit_id="l10n_es_facturae.template_facturae">

        <!-- InvoiceHeader - InvoiceSeriesCode empty -->
        <xpath expr="//InvoiceHeader/InvoiceSeriesCode" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//Corrective/InvoiceSeriesCode" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>

        <!-- InvoiceIssueData empty elements -->
        <xpath expr="//InvoiceIssueData/OperationDate" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//InvoiceIssueData/PlaceOfIssue" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>

        <!-- Replace TaxesOutputs to remove empty elements in Tax -->
        <xpath expr="//TaxesOutputs" position="replace">
            <TaxesOutputs>
                <t t-foreach="output_taxes" t-as="tax">
                    <Tax>
                        <t t-set="tax_line" t-value="output_taxes[tax]" />
                        <TaxTypeCode t-out="tax.facturae_code" />
                        <TaxRate
                            t-out="('%.2f' if version == '3_2' else '%.8f') % (tax.amount)"
                        />
                        <TaxableBase>
                            <TotalAmount
                                t-out="('%.2f' if version == '3_2' else '%.8f') % tax_line['base']"
                            />
                            <EquivalentInEuros
                                t-out="'%.2f' % (tax_line['base'] * euro_rate / currency_rate)"
                            />
                        </TaxableBase>
                        <TaxAmount>
                            <TotalAmount
                                t-out="('%.2f' if version == '3_2' else '%.8f') % ( tax_line['amount'] )"
                            />
                            <EquivalentInEuros
                                t-out="'%.2f' % (( tax_line['amount']) * euro_rate / currency_rate)"
                            />
                        </TaxAmount>
                    </Tax>
                </t>
            </TaxesOutputs>
        </xpath>

        <!-- InvoiceTotals empty elements -->
        <xpath expr="//InvoiceTotals/GeneralDiscounts" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//InvoiceTotals/GeneralSurcharges" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//InvoiceTotals/TotalGeneralDiscounts" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//InvoiceTotals/TotalGeneralSurcharges" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//InvoiceTotals/Subsidies" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//InvoiceTotals/PaymentsOnAccount" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//InvoiceTotals/ReimbursableExpenses" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//InvoiceTotals/TotalFinancialExpenses" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//InvoiceTotals/TotalPaymentsOnAccount" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//InvoiceTotals/TotalReimbursableExpenses" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>

        <!-- Remove PaymentInKind block completely (including the t-if wrapper) -->
        <xpath expr="//InvoiceTotals/t[@t-if=&quot;version not in ('3_2', '3_2_1')&quot;]" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>

        <!-- Invoice line empty elements -->
        <xpath expr="//InvoiceLine/SequenceNumber" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//InvoiceLine/DeliveryNotesReferences" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//InvoiceLine/UnitOfMeasure" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//InvoiceLine/Charges" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//InvoiceLine/AdditionalLineItemInformation" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//InvoiceLine/SpecialTaxableEvent" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//InvoiceLine/Extensions" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>

        <!-- PaymentDetails empty elements -->
        <xpath expr="//Installment/CollectionAdditionalInformation" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//Installment/RegulatoryReportingData" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//Installment/DebitReconciliationReference" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//AccountToBeDebited/BranchCode" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//AccountToBeDebited/PaymentReconciliationReference" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//AccountToBeCredited/BranchCode" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>

        <!-- Other empty elements -->
        <xpath expr="//Invoice/LegalLiterals" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//AdditionalData/RelatedInvoice" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//AdditionalData/Extensions" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>

        <!-- Remove Extensions after Invoices -->
        <xpath expr="//Invoices/following-sibling::Extensions" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>

    </template>
</odoo>
