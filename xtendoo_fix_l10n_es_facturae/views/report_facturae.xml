<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Remove empty fields defined in l10n_es_facturae templates -->
    <template id="administrative_center_inherit" inherit_id="l10n_es_facturae.administrative_center">
        <!-- SecondSurname, PhysicalGLN, LogicalOperationalPoint are defined here -->
        <xpath expr="//SecondSurname" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//PhysicalGLN" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//LogicalOperationalPoint" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
    </template>

    <template id="address_contact_inherit" inherit_id="l10n_es_facturae.address_contact">
        <!-- CnoCnae, INETownCode defined here -->
        <xpath expr="//CnoCnae" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//INETownCode" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
    </template>

    <!-- Remove empty fields from l10n_es_facturae.template_facturae main template -->
    <template id="template_facturae_inherit" inherit_id="l10n_es_facturae.template_facturae">
        <!-- OperationDate and PlaceOfIssue are in the main template_facturae -->
        <xpath expr="//OperationDate" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//PlaceOfIssue" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <!-- Remove other empty elements from template_facturae -->
        <xpath expr="//SequenceNumber" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//DeliveryNotesReferences" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//UnitOfMeasure" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//Charges" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//SpecialTaxableEvent" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//Extensions" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <!-- InvoiceTotals empty subelements -->
        <xpath expr="//GeneralDiscounts" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//GeneralSurcharges" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//TotalGeneralDiscounts" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//TotalGeneralSurcharges" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//Subsidies" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//PaymentsOnAccount" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//ReimbursableExpenses" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//TotalFinancialExpenses" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//TotalPaymentsOnAccount" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//TotalReimbursableExpenses" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//PaymentInKind/PaymentInKindAmount" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <!-- Tax elements -->
        <xpath expr="//SpecialTaxableBase" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//SpecialTaxAmount" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//EquivalenceSurcharge" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//EquivalenceSurchargeAmount" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <!-- PaymentDetails empty elements -->
        <xpath expr="//CollectionAdditionalInformation" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//RegulatoryReportingData" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <xpath expr="//DebitReconciliationReference" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
        <!-- LegalLiterals -->
        <xpath expr="//LegalLiterals" position="replace"><!-- removed by xtendoo_fix_l10n_es_facturae --></xpath>
    </template>
</odoo>
