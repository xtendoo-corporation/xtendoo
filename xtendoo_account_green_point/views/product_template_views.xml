<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view_green_point" model="ir.ui.view">
        <field name="name">product.template.form.green.point</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="Punto Verde">
                    <group>
                        <field name="green_point_enabled" widget="boolean_toggle"/>
                        <field name="green_point_type" invisible="not green_point_enabled" required="green_point_enabled"/>
                    </group>
                    <group>
                        <field name="green_point_amount" invisible="not green_point_enabled"/>
                        <field name="green_point_notes" invisible="not green_point_enabled"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
