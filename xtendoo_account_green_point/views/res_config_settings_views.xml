<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_xtendoo_green_point" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.xtendoo.green.point</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Punto Verde (Green Point)" name="xtendoo_green_point">
                    <setting string="Afecta Coste" help="El Punto Verde afecta al coste del producto (Stock Valuation en V2).">
                        <field name="green_point_affects_cost"/>
                    </setting>
                    <setting string="Desglose Contable" help="Habilitar el desglose contable del Punto Verde.">
                        <field name="green_point_enabled_accounting_split"/>
                        <div class="content-group" invisible="not green_point_enabled_accounting_split">
                            <div class="row mt16">
                                <label for="green_point_purchase_account_id" class="col-lg-4 o_light_label"/>
                                <field name="green_point_purchase_account_id"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
