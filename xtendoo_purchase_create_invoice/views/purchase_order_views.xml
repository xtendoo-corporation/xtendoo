<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Heredar la vista de formulario de purchase.order para reemplazar el botón -->
    <record id="view_purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Reemplazar el botón de crear factura estándar por uno directo -->
            <xpath expr="//header/button[@name='action_create_invoice']" position="replace">
                <!-- Botón directo: Crear factura sin wizard ni subir documento -->
                <button name="action_create_invoice_direct"
                        string="Crear Factura"
                        type="object"
                        class="oe_highlight"
                        invisible="state not in ['purchase', 'done'] or invoice_status != 'to invoice'"
                        groups="purchase.group_purchase_user"
                        help="Crea la factura automáticamente con las cantidades recibidas pendientes de facturar. No requiere subir documentos ni wizards."/>
            </xpath>
        </field>
    </record>
</odoo>

