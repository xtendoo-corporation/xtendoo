<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="label_57x35">
        <table class="table" style="margin: 0; padding: 0;">
            <tr height="144px" style="border:0;margin:0;padding:0;">
                <td class="col-xs-4 text-center" style="border:0;margin:0;padding:0;">
                    <div style="overflow:hidden; height:65px !important; padding: 5px 5px 0; line-height: 1.2;">
                        <span t-field="label.product_id.name" style="line-height: 1.2;"/>
                        <span t-if="label.product_id.product_template_attribute_value_ids"
                              t-esc="u', '.join(map(lambda x: x.attribute_line_id.attribute_id.name + u': ' + x.name, label.product_id.product_template_attribute_value_ids))"
                              class="badge"/>
                    </div>
                    <div style="width: 100%; padding: 0; margin: 0; font-size: 21px; font-weight: bold;">
                        <span t-if="label.product_id.currency_id.position == 'before'"
                              t-field="label.product_id.currency_id.symbol"/>
                        <span t-field="label.product_id.lst_price"/>
                        <span t-if="label.product_id.currency_id.position == 'after'"
                              t-field="label.product_id.currency_id.symbol"/>
                    </div>
                    <div t-if="label.product_id.default_code"
                         style="width: 100%; padding: 0; margin: 0; font-size: 12px;">
                        <span t-field="label.product_id.default_code"/>
                    </div>
                    <t t-if="label.product_id.barcode">
                        <div t-out="label.product_id.barcode"
                             t-options="{'widget': 'barcode', 'symbology': 'auto', 'img_style': 'overflow: hidden; width: 100%; height: 1.4rem;', 'humanreadable': label.wizard_id.humanreadable}"
                             class="px-1"/>
                    </t>
                </td>
            </tr>
        </table>
    </template>

    <template id="report_product_label_57x35_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-set="count" t-value="0"/>
                <div class="page">
                    <div class="oe_structure"/>
                    <t t-foreach="docs" t-as="label">
                        <t t-set="qty" t-value="1"/>
                        <t t-if="label.qty">
                            <t t-set="qty" t-value="label.qty"/>
                        </t>
                        <t t-foreach="list(range(qty))" t-as="index_qty">
                            <div t-if="count % 21 == 0" style="page-break-after:always;"/>
                            <div t-if="count % 3 == 0" style="clear:both;"/>
                            <div
                                t-att-style="'width: 233px; float: left; height: 145px; margin: 0 4px 4px; border: {};'.format('%dpx solid #777;' % label.wizard_id.border_width if label.wizard_id.border_width else '0')">
                                <t t-call="xtendoo_product_label.label_57x35"/>
                            </div>
                            <t t-set="count" t-value="count+1"/>
                        </t>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <template id="label_38x21">
    <table border="0" style="margin: 0; padding: 0; border-spacing: 0; border-collapse: collapse; border-color: #ffffff;">
        <tr style="margin:0;padding:0; width: 190mm;">
            <td style="min-width: 32mm; min-height: 21mm; page-break-inside: avoid; border: none;">
                <div>
                    <div style="font-size: 10pt; text-align: right;">
                        <span t-field="label.product_id.default_code" style="border: none !important;"/>
                    </div>
                    <span style="font-size: 8pt; text-align: left; border: none;">
                        <strong>P.V.P.</strong>
                    </span>
                    <div style="font-size: 18pt; font-weight: bold; text-align: right;">
                        <span t-field="label.product_id.lst_price" style="border: none;"/>
                        <span t-if="label.product_id.currency_id.position == 'after'" t-field="label.product_id.currency_id.symbol" style="border: none;"/>
                        <span t-else="" style="border: none;">€</span>
                    </div>
                </div>
            </td>
        </tr>
    </table>
</template>

<template id="report_product_label_38x21_template">
    <t t-call="web.html_container">
        <t t-call="web.basic_layout">
            <t t-set="count" t-value="0"/>
            <div class="page">
                <div/>
                <t t-foreach="docs" t-as="label">
                    <t t-set="qty" t-value="1"/>
                    <t t-if="label.qty">
                        <t t-set="qty" t-value="label.qty"/>
                    </t>
                    <t t-foreach="list(range(qty))" t-as="index_qty">
                        <div t-if="count % 65 == 0" style="page-break-after:always;"/>
                        <div t-if="count % 5 == 0" style="clear:both;"/>
                        <div t-att-style="'min-width: 32.5mm; float: left; min-height: 21.42mm; margin-right: 2mm; margin-left: 2mm;'">
                            <t t-call="xtendoo_product_label.label_38x21"/>
                        </div>
                        <t t-set="count" t-value="count+1"/>
                    </t>
                </t>
            </div>
        </t>
    </t>
</template>

    <template id="report_product_label_from_template">
        <t t-call="web.basic_layout"/>
    </template>

</odoo>
