<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_expense_ai_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.expense.ai.wizard.view.form</field>
        <field name="model">hr.expense.ai.wizard</field>
        <field name="arch" type="xml">
            <form string="Importación de Documento con IA">
                <sheet>
                    <div invisible="state != 'draft'">
                        <group>
                            <field name="attachment_file" filename="attachment_name" required="1"/>
                            <field name="attachment_name" invisible="1"/>
                            <field name="expense_id" invisible="1"/>
                        </group>
                        <p class="text-muted">
                            Sube un PDF o imagen del ticket de gasto. Nuestra IA extraerá la fecha, descripción, importe e información del proveedor.
                        </p>
                    </div>

                    <div invisible="state != 'preview'">
                        <group>
                            <field name="detected_reason"/>
                        </group>
                        <notebook>
                            <page string="Datos Extraídos (JSON)">
                                <field name="ai_json_result" widget="ace" options="{'mode': 'json'}"/>
                            </page>
                        </notebook>
                    </div>

                    <footer>
                        <button name="action_analyze" string="Analizar Documento" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_apply" string="Aplicar Cambios" type="object" class="oe_highlight" invisible="state != 'preview'"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
