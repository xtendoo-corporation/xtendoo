<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_global_discount" model="ir.ui.view">
        <field name="name">sale.order.form.global.discount</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_sigaus']" position="after">
                <field name="customer_global_discount"/>
            </xpath>
        </field>
    </record>
</odoo>
