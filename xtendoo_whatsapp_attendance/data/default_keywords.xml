<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Configuración por defecto para palabras de ENTRADA -->
        <record id="default_keywords_check_in" model="attendance.keyword.config">
            <field name="name">Palabras Clave - Entrada</field>
            <field name="active" eval="True"/>
            <field name="attendance_type">check_in</field>
            <field name="keywords">entrada
entrar
llegar
llego
check in
fichar entrada
inicio
comenzar
empezar</field>
            <field name="use_template" eval="True"/>
            <field name="whatsapp_template_id" ref="whatsapp_template_attendance_check_in"/>
            <field name="custom_message">✅ Hola {employee_name},

Tu *{action}* ha sido registrada correctamente.

🕐 Hora: {time}
📅 Fecha: {date}

¡Que tengas un buen día!</field>
        </record>

        <!-- Configuración por defecto para palabras de SALIDA -->
        <record id="default_keywords_check_out" model="attendance.keyword.config">
            <field name="name">Palabras Clave - Salida</field>
            <field name="active" eval="True"/>
            <field name="attendance_type">check_out</field>
            <field name="keywords">salida
salir
marchar
me voy
check out
fichar salida
fin
terminar
acabar
finalizar</field>
            <field name="use_template" eval="True"/>
            <field name="whatsapp_template_id" ref="whatsapp_template_attendance_check_out"/>
            <field name="custom_message">✅ Hola {employee_name},

Tu *{action}* ha sido registrada correctamente.

🕐 Hora: {time}
📅 Fecha: {date}

¡Que tengas un buen día!</field>
        </record>

    </data>
</odoo>
