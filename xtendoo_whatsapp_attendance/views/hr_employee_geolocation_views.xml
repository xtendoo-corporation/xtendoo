<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista formulario para empleado - agregar campos de geolocalización -->
    <record id="view_employee_form_geolocation" model="ir.ui.view">
        <field name="name">hr.employee.form.geolocation</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Agregar en la pestaña Settings, grupo Attendance/Point of Sale -->
            <xpath expr="//page[@name='hr_settings']//group[@name='identification_group']" position="inside">
                <field name="whatsapp_geotrack_enabled" string="WhatsApp Geolocation"/>
            </xpath>

            <!-- También mostrar última ubicación conocida -->
            <xpath expr="//page[@name='hr_settings']//group[@name='identification_group']" position="after">
                <group string="WhatsApp Location Tracking" name="whatsapp_location_group" invisible="not whatsapp_geotrack_enabled">
                    <label for="last_whatsapp_latitude" string="Last Location"/>
                    <div class="o_row">
                        <field name="last_whatsapp_latitude" readonly="1" class="o_hr_narrow_field"/>
                        <span>,</span>
                        <field name="last_whatsapp_longitude" readonly="1" class="o_hr_narrow_field"/>
                    </div>
                    <field name="last_whatsapp_location_time" string="Timestamp" readonly="1"/>
                    <field name="last_whatsapp_address" string="Address" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Vista lista para empleados - mostrar estado de geolocalización -->
    <record id="view_employee_tree_geolocation" model="ir.ui.view">
        <field name="name">hr.employee.tree.geolocation</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="whatsapp_geotrack_enabled" string="WhatsApp Geo" widget="boolean_toggle" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Vista formulario para asistencia - mostrar geolocalización -->
    <record id="view_attendance_form_geolocation" model="ir.ui.view">
        <field name="name">hr.attendance.form.geolocation</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='check_out']" position="after">
                <!-- Campos invisibles para controlar visibilidad -->
                <field name="whatsapp_latitude" invisible="1"/>
                <field name="whatsapp_longitude" invisible="1"/>

                <!-- Grupo de Ubicación WhatsApp -->
                <group string="WhatsApp Location" invisible="not whatsapp_latitude">
                    <group>
                        <label for="whatsapp_latitude" string="Coordinates"/>
                        <div class="o_row">
                            <span class="fa fa-map-marker text-primary me-2"/>
                            <field name="whatsapp_latitude" readonly="1" class="o_hr_narrow_field"/>
                            <span>,</span>
                            <field name="whatsapp_longitude" readonly="1" class="o_hr_narrow_field"/>
                        </div>
                        <field name="whatsapp_location_address" string="Address" readonly="1"/>
                        <field name="whatsapp_location_accuracy" string="Accuracy (m)" readonly="1"/>
                    </group>
                    <group>
                        <div class="d-flex flex-column align-items-center gap-2">
                            <button type="object"
                                    name="action_open_google_maps"
                                    string="View on Google Maps"
                                    class="btn btn-primary"
                                    icon="fa-map-marker"/>
                            <div class="text-muted text-center">
                                <small>Click to view the exact location<br/>where this attendance was registered</small>
                            </div>
                        </div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
