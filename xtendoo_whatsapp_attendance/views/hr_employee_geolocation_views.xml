<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista formulario para empleado - agregar campos de geolocalización -->
    <record id="view_employee_form_geolocation" model="ir.ui.view">
        <field name="name">hr.employee.form.geolocation</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_phone']" position="after">
                <field name="whatsapp_geotrack_enabled"/>
            </xpath>
        </field>
    </record>

    <!-- Vista lista para empleados - mostrar estado de geolocalización -->
    <record id="view_employee_tree_geolocation" model="ir.ui.view">
        <field name="name">hr.employee.tree.geolocation</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_phone']" position="after">
                <field name="whatsapp_geotrack_enabled" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

    <!-- Vista formulario para asistencia - mostrar geolocalización -->
    <record id="view_attendance_form_geolocation" model="ir.ui.view">
        <field name="name">hr.attendance.form.geolocation</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='check_out']" position="after">
                <!-- Mapa de Ubicación en Asistencia -->
                <group string="Mapa de Ubicación" invisible="not whatsapp_latitude">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>📍 Ubicación registrada con esta asistencia:</strong></p>
                            <div class="form-group">
                                <div class="o_form_label">Coordenadas:</div>
                                <div class="text-info">
                                    <span class="fa fa-map-marker"/>
                                    <field name="whatsapp_latitude" readonly="1" style="display:inline; width:auto;" class="oe_inline"/> ,
                                    <field name="whatsapp_longitude" readonly="1" style="display:inline; width:auto;" class="oe_inline"/>
                                </div>
                            </div>
                            <div class="form-group" invisible="not whatsapp_location_address">
                                <div class="o_form_label">Dirección:</div>
                                <div class="text-success">
                                    <field name="whatsapp_location_address" readonly="1" class="oe_inline"/>
                                </div>
                            </div>
                            <div class="form-group" invisible="not whatsapp_location_accuracy">
                                <div class="o_form_label">Precisión:</div>
                                <div class="text-muted">
                                    <field name="whatsapp_location_accuracy" readonly="1" class="oe_inline"/> metros
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-center">
                                <div class="btn-group-vertical" style="width: 100%;">
                                    <button type="object" name="action_open_google_maps"
                                            class="btn btn-primary btn-lg"
                                            style="margin-bottom: 10px;">
                                        <i class="fa fa-map-marker"/> Ver en Google Maps
                                    </button>
                                </div>
                                <div class="mt-3">
                                    <small class="text-muted">
                                        Haz clic en "Ver en Google Maps" para<br/>
                                        visualizar la ubicación exacta donde<br/>
                                        se registró esta asistencia
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
