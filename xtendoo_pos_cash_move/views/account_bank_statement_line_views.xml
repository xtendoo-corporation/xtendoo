<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_statement_line_tree_pos" model="ir.ui.view">
        <field name="name">account.bank.statement.line.tree.pos</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <list string="Movimientos de Caja" editable="bottom">
                <field name="pos_session_id"/>
                <field name="date"/>
                <field name="amount" string="Importe"/>
                <field name="move_type_display" string="Tipo"
                       widget="badge"
                       decoration-success="move_type_display == 'in'"
                       decoration-danger="move_type_display == 'out'"
                />
                <field name="payment_ref" string="Referencia Contable"/>
            </list>
        </field>
    </record>
</odoo>
