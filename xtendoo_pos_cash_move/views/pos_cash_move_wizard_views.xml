<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_cash_move_wizard_form" model="ir.ui.view">
        <field name="name">pos.cash.move.wizard.form</field>
        <field name="model">pos.cash.move.wizard</field>
        <field name="arch" type="xml">
            <form string="Movimiento de Caja PoS">
                <group>
                    <field name="session_id"/>
                    <field name="move_type"/>
                    <field name="amount"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirmar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_pos_cash_move_wizard" model="ir.actions.act_window">
        <field name="name">Nuevo movimiento de caja</field>
        <field name="res_model">pos.cash.move.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
    <!-- Accion para usuarios normales (solo lectura) -->
    <record id="action_pos_cash_moves_history" model="ir.actions.act_window">
        <field name="name">Movimientos de Caja</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_bank_statement_line_tree_pos"/>
        <field name="domain">[('pos_session_id', '!=', False)]</field>
        <field name="context">{'search_default_group_by_session': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No hay movimientos de caja asociados a sesiones de PoS.
            </p>
        </field>
    </record>
    <!-- Accion para administradores (editable) -->
    <record id="action_pos_cash_moves_history_admin" model="ir.actions.act_window">
        <field name="name">Movimientos de Caja</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_bank_statement_line_tree_pos_admin"/>
        <field name="domain">[('pos_session_id', '!=', False)]</field>
        <field name="context">{'search_default_group_by_session': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No hay movimientos de caja asociados a sesiones de PoS.
            </p>
        </field>
    </record>
    <!-- Accion servidor: admin recibe vista editable, resto recibe solo lectura -->
    <record id="action_pos_cash_moves_smart" model="ir.actions.server">
        <field name="name">Movimientos de Caja</field>
        <field name="model_id" ref="account.model_account_bank_statement_line"/>
        <field name="state">code</field>
        <field name="code">
if env.user.has_group('base.group_system'):
    action = env.ref('xtendoo_pos_cash_move.action_pos_cash_moves_history_admin').sudo().read()[0]
else:
    action = env.ref('xtendoo_pos_cash_move.action_pos_cash_moves_history').sudo().read()[0]
        </field>
    </record>
    <!-- Un solo menu: abre vista editable para admins, solo lectura para el resto -->
    <menuitem id="menu_pos_cash_moves_history"
              name="Movimientos de Caja"
              parent="point_of_sale.menu_point_of_sale"
              action="action_pos_cash_moves_smart"
              sequence="21"/>
</odoo>
