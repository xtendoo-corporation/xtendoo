<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="xtendoo_feria.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('actionpad')]" position="inside">
            <button class="feria-recharge-btn btn btn-lg py-3 d-flex align-items-center justify-content-center w-100 mt-2"
                    t-on-click="() => pos.openFeriaRechargeWizard()">
                <i class="fa fa-credit-card me-2" />
                <span class="fw-bold fs-4">Recarga</span>
            </button>
        </xpath>
    </t>
</templates>

