<odoo>
    <!-- Formulario -->
    <record id="project_task_kind_form" model="ir.ui.view">
        <field name="name">project.task.kind.form</field>
        <field name="model">project.task.kind</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            name="action_view_task"
                            type="object"
                            icon="fa-tasks"
                            invisible="task_count == 0"
                        >
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="task_count"/>
                                </span>
                                <span class="o_stat_text">Task</span>
                            </div>
                        </button>
                    </div>
                    <label for="name"/>
                    <field name="name"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Lista (antes era tree) -->
    <record id="project_task_type_list" model="ir.ui.view">
        <field name="name">project.task.kind.list</field>
        <field name="model">project.task.kind</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Acción -->
    <record id="project_task_kind_action" model="ir.actions.act_window">
        <field name="name">project task kind</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.task.kind</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'project_task_kind'}</field>
    </record>

    <!-- Menú -->
    <menuitem
        id="project_task_kind"
        name="Project task kind"
        parent="project.menu_project_config"
        action="project_task_kind_action"
    />
</odoo>
