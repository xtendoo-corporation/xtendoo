<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <template id="document_tax_totals">
            <!--
                Plantilla genérica para mostrar totales de impuestos en reportes PDF.
                Usada por facturas, SO y PO.

                ARGUMENTOS:
                - tax_totals: dict generado por _get_tax_totals de account.move.
            -->
            <t t-foreach="tax_totals.get('subtotals', [])" t-as="subtotal">
                <tr class="border-black o_subtotal">
                    <td style="padding:0;">
                        <strong t-out="subtotal.get('name', '')"/>
                    </td>
                    <td style="padding:0;" class="text-end">
                        <t t-if="'formatted_amount' in subtotal">
                            <span
                                t-att-class="oe_subtotal_footer_separator"
                                t-out="subtotal.get('formatted_amount_total', '')"
                            />
                        </t>
                        <t t-else="">
                            <span t-att-class="oe_subtotal_footer_separator">-</span>
                        </t>
                    </td>
                </tr>
                <t t-set="subtotal_to_show" t-value="subtotal.get('name', '')"/>
                <t t-call="document_format_clean.tax_groups_totals"/>
            </t>
            <!-- Importe total con todos los impuestos -->
            <tr class="border-black o_total">
                <td style="padding:0;">
                    <strong>Total</strong>
                </td>
                <td style="padding:0;" class="text-end">
                    <span t-out="tax_totals.get('formatted_amount_total', '')"/>
                </td>
            </tr>
        </template>

        <template id="tax_groups_totals">
            <!--
                Plantilla genérica para mostrar una lista de grupos de impuestos con los importes relacionados.

                ARGUMENTOS:
                - tax_totals: dict generado por _get_tax_totals de account.move.
                - subtotal_to_show: El subtotal para renderizar los grupos
            -->
            <t t-foreach="tax_totals.get('groups_by_subtotal', {}).get(subtotal_to_show, [])" t-as="amount_by_group">
                <tr>
                    <t t-if="len(tax_totals.get('groups_by_subtotal', {}).get(subtotal_to_show, [])) > 1 or (tax_totals.get('amount_untaxed', 0) != amount_by_group.get('tax_group_base_amount', 0))">
                        <td style="padding:0;">
                            <span t-out="amount_by_group.get('tax_group_name', '')"/>
                            <span class="text-nowrap">en
                                <t t-out="amount_by_group.get('formatted_tax_group_base_amount', '')"/>
                            </span>
                        </td>
                        <td style="padding:0;" class="text-end o_price_total">
                            <span class="text-nowrap" t-out="amount_by_group.get('formatted_tax_group_amount', '')"/>
                        </td>
                    </t>
                    <t t-else="">
                        <td style="padding:0;">
                            <span class="text-nowrap" t-out="amount_by_group.get('tax_group_name', '')"/>
                        </td>
                        <td style="padding:0;" class="text-end o_price_total">
                            <span class="text-nowrap" t-out="amount_by_group.get('formatted_tax_group_amount', '')"/>
                        </td>
                    </t>
                </tr>
            </t>
        </template>
    </data>
</odoo>
