<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Parámetros por defecto para OpenAI -->
        <record id="config_openai_model" model="ir.config_parameter">
            <field name="key">xtendoo_invoice_ai.openai_model</field>
            <field name="value">gpt-4o</field>
        </record>

        <record id="config_max_pages" model="ir.config_parameter">
            <field name="key">xtendoo_invoice_ai.max_pages</field>
            <field name="value">10</field>
        </record>

        <record id="config_temperature" model="ir.config_parameter">
            <field name="key">xtendoo_invoice_ai.temperature</field>
            <field name="value">0.0</field>
        </record>

        <record id="config_tolerance" model="ir.config_parameter">
            <field name="key">xtendoo_invoice_ai.tolerance</field>
            <field name="value">0.02</field>
        </record>
    </data>
</odoo>

