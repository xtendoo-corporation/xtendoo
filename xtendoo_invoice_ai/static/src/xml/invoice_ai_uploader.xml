<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="xtendoo_invoice_ai.InvoiceAIUploader">
        <FileUploader
            acceptedFileExtensions="acceptedFileExtensions"
            fileUploadClass="'invoice_ai_uploader'"
            multiUpload="true"
            onUploaded.bind="onFileUploaded"
            onUploadComplete.bind="onUploadComplete">
            <t t-set-slot="toggler">
                <t t-slot="toggler"/>
            </t>
            <t t-slot="default"/>
        </FileUploader>
    </t>

    <t t-name="xtendoo_invoice_ai.InvoiceAIUploadButton">
        <InvoiceAIUploader resModel="'account.move'">
            <t t-set-slot="toggler">
                <button type="button" class="btn btn-primary" data-hotkey="shift+o" title="Subir factura para procesar con IA">
                    <i class="fa fa-magic"/> OCR
                </button>
            </t>
        </InvoiceAIUploader>
    </t>

    <!-- Parchear el control panel de la lista para agregar botón OCR -->
    <t t-name="web.ListController" t-inherit="web.ListController" t-inherit-mode="extension">
        <xpath expr="//Layout" position="attributes">
            <attribute name="t-slot-scope" add="showOCRButton: this.showOCRButton" separator=", "/>
        </xpath>
        <xpath expr="//Layout/t[@t-set-slot='layout-buttons']" position="inside">
            <button t-if="showOCRButton"
                    type="button"
                    class="btn btn-primary o_list_button_add"
                    t-on-click="onClickOCRButton"
                    title="Subir factura para procesar con IA">
                <i class="fa fa-magic"/> OCR
            </button>
        </xpath>
    </t>

</templates>
