<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista formulario del wizard -->
    <record id="view_xtendoo_invoice_ai_wizard_form" model="ir.ui.view">
        <field name="name">xtendoo.invoice.ai.wizard.form</field>
        <field name="model">xtendoo.invoice.ai.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Invoice with AI">
                <group>
                    <group>
                        <field name="upload" filename="filename" required="1"/>
                        <field name="filename" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="journal_id"/>
                    </group>
                    <group>
                        <field name="currency_id"/>
                        <field name="create_partner_if_missing"/>
                        <field name="attach_original"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    <strong>How it works:</strong>
                    <ul>
                        <li>Upload a PDF or image (JPG/PNG) of a vendor invoice</li>
                        <li>OpenAI will extract supplier, invoice details, lines and totals</li>
                        <li>A draft vendor bill will be created automatically</li>
                        <li>If supplier is not found, it will be created (if enabled)</li>
                        <li>Review and validate the bill before posting</li>
                    </ul>
                </div>
                <footer>
                    <button
                        string="Analyze and Create Invoice"
                        name="action_analyze_and_create"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

