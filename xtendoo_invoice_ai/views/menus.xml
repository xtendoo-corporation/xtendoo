<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción del wizard - DEBE IR PRIMERO -->
    <record id="action_xtendoo_invoice_ai_wizard" model="ir.actions.act_window">
        <field name="name">Import Invoice with AI</field>
        <field name="res_model">xtendoo.invoice.ai.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
    </record>

    <!-- Acción para histórico - DEBE IR ANTES DEL MENU -->
    <record id="action_xtendoo_invoice_ai_job" model="ir.actions.act_window">
        <field name="name">AI Import History</field>
        <field name="res_model">xtendoo.invoice.ai.job</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_xtendoo_invoice_ai_job_tree"/>
        <field name="search_view_id" ref="view_xtendoo_invoice_ai_job_search"/>
    </record>

    <!-- Vinculación explícita de vistas a la acción -->
    <record id="action_xtendoo_invoice_ai_job_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_xtendoo_invoice_ai_job_tree"/>
        <field name="act_window_id" ref="action_xtendoo_invoice_ai_job"/>
    </record>

    <record id="action_xtendoo_invoice_ai_job_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_xtendoo_invoice_ai_job_form"/>
        <field name="act_window_id" ref="action_xtendoo_invoice_ai_job"/>
    </record>

    <!-- Menú principal: Facturación → Proveedores → Importar factura con IA -->
    <menuitem
        id="menu_xtendoo_invoice_ai_import"
        name="Import Invoice with AI"
        parent="account.menu_finance_payables"
        action="action_xtendoo_invoice_ai_wizard"
        sequence="50"
        groups="account.group_account_invoice"
    />

    <!-- Menú para ver histórico de trabajos -->
    <menuitem
        id="menu_xtendoo_invoice_ai_jobs"
        name="AI Import History"
        parent="account.menu_finance_payables"
        action="action_xtendoo_invoice_ai_job"
        sequence="51"
        groups="account.group_account_invoice"
    />
</odoo>
