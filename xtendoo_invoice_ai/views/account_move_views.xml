<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista formulario heredada con botón en header -->
    <record id="view_move_form_inherit_ai" model="ir.ui.view">
        <field name="name">account.move.form.inherit.ai</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Agregar botones en la barra de estado para facturas de proveedor en borrador -->
            <xpath expr="//header" position="inside">
                <button name="action_import_with_ai"
                        type="object"
                        string="🤖 Import with AI"
                        class="oe_highlight"
                        invisible="move_type != 'in_invoice' or state != 'draft'"
                        help="Import invoice data from attached PDF/image using AI. Attach a file first using 📎"/>
                <button name="action_send_ai_feedback"
                        type="object"
                        string="📝 Send AI Feedback"
                        class="btn-secondary"
                        invisible="move_type != 'in_invoice' or not ai_extracted_data or ai_feedback_sent"
                        help="Send corrections to improve AI accuracy in future imports"
                        confirm="This will send the corrected data to help improve the AI. The original AI extraction will be compared with your corrections. Continue?"/>
            </xpath>

            <!-- Agregar campos invisibles para las condiciones -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="ai_extracted_data" invisible="1"/>
                <field name="ai_feedback_sent" invisible="1"/>
                <field name="ai_import_date" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
