<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hereda la vista account.view_move_form y añade un botón para enviar facturas en borrador -->
    <record id="view_move_form_inherit_send_draft" model="ir.ui.view">
        <field name="name">account.move.form.inherit.send.draft</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- NO reemplazamos ni tocamos los botones originales action_invoice_sent -->
            <!-- Insertamos un nuevo botón visible en 'draft' que llamará al método personalizado -->
            <xpath expr="//header" position="inside">
                <button name="action_send_draft_to_followers" type="object" string="Enviar Borrador" class="oe_highlight"
                        invisible="state != 'draft' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')">
                </button>
            </xpath>
        </field>
    </record>
</odoo>
