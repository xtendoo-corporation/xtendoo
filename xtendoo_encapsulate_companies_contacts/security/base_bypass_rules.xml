<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Overriding base company rules to support bypass check -->
    <record id="base.res_company_rule_employee" model="ir.rule">
        <field name="domain_force">[(1, '=', 1)] if user.see_all_companies else [('id', 'in',
            company_ids)]</field>
    </record>

    <record id="base.res_company_rule_portal" model="ir.rule">
        <field name="domain_force">[(1, '=', 1)] if user.see_all_companies else [('id', 'in',
            company_ids)]</field>
    </record>

    <record id="base.res_company_rule_public" model="ir.rule">
        <field name="domain_force">[(1, '=', 1)] if user.see_all_companies else [('id', 'in',
            company_ids)]</field>
    </record>

    <!-- Overriding base user rule (Global) -->
    <record id="base.res_users_rule" model="ir.rule">
        <field name="domain_force">[(1, '=', 1)] if user.see_all_companies else ['|', ('share', '=',
            False), ('company_ids', 'in', company_ids)]</field>
    </record>

    <!-- Overriding base partner rule (Global) -->
    <record id="base.res_partner_rule" model="ir.rule">
        <field name="domain_force">[(1, '=', 1)] if user.see_all_companies else ['|', '|',
            ('id', '=', user.partner_id.id), ('xt_is_global_visibility', '=', True),
            ('xt_visibility_company_ids', 'in', company_ids)]</field>
    </record>
</odoo>
