<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_company_rule" model="ir.rule">
        <field name="name">Contactos de la compañía del usuario actual</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="domain_force">[(1, '=', 1)] if user.see_all_companies else ['|', '|',
            ('id', '=', user.partner_id.id), ('xt_is_global_visibility', '=', True),
            ('xt_visibility_company_ids', 'in', company_ids)]</field>
        <field name="global" eval="True" />
    </record>

    <record id="res_partner_category_company_rule" model="ir.rule">
        <field name="name">Categoría del contacto por compañía</field>
        <field name="model_id" ref="base.model_res_partner_category" />
        <field name="domain_force">[(1, '=', 1)] if user.see_all_companies else [('company_id', '=',
            user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="res_partner_industry_company_rule" model="ir.rule">
        <field name="name">Sector del contacto por compañía</field>
        <field name="model_id" ref="base.model_res_partner_industry" />
        <field name="domain_force">[(1, '=', 1)] if user.see_all_companies else [('company_id', '=',
            user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
</odoo>
