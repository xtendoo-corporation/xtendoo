<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_strict_rule" model="ir.rule">
        <field name="name">Strict Company Encapsulation</field>
        <field name="model_id" ref="base.model_res_company" />
        <field name="domain_force">[(1, '=', 1)] if user.see_all_companies else [('id', '=',
            user.company_id.id)]</field>
        <field name="global" eval="True" />
    </record>

    <record id="res_users_strict_rule" model="ir.rule">
        <field name="name">Strict Users Encapsulation</field>
        <field name="model_id" ref="base.model_res_users" />
        <field name="domain_force">[(1, '=', 1)] if user.see_all_companies else ['|', ('company_id',
            '=', user.company_id.id), ('id', '=', user.id)]</field>
        <field name="global" eval="True" />
    </record>
</odoo>